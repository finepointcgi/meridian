{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "../src/Meridian.Scripting",
          "files": [ "Meridian.Scripting.csproj" ]
        }
      ],
      "dest": "api",
      "namespaceLayout": "flattened",
      "memberLayout": "samePage",
      "enumSortOrder": "declaringOrder",
      "filter": "filterConfig.yml",
      "properties": { "TargetFramework": "net10.0" }
    }
  ],
  "build": {
    "content": [
      { "files": [ "**/*.{md,yml}" ], "exclude": [ "_site/**", "obj/**", "filterConfig.yml", "README.md" ] }
    ],
    "resource": [
      { "files": [ "images/**" ] }
    ],
    "output": "_site",
    "template": [ "default", "modern" ],
    "globalMetadata": {
      "_appName": "Meridian",
      "_appTitle": "Meridian User Guide",
      "_appFooter": "Meridian — model-based systems engineering. Documentation built with DocFX.",
      "_enableSearch": true,
      "_disableContribution": true,
      "pdf": false
    }
  }
}

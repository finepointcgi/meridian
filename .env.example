# Meridian production settings for docker-compose.prod.yml.
#   cp .env.example .env && chmod 600 .env     # then edit; .env is git-ignored
# Every value here becomes a Meridian__* environment variable in the container (see docs/DEPLOYMENT.md,
# "Configuration reference", for the full list including settings without a variable here).

# ---------------------------------------------------------------- stack
# Compose project name: prefixes container, network and volume names.
COMPOSE_PROJECT_NAME=meridian
# Image to run. Pin an exact release tag (or digest) in production; "latest" is only the newest release.
MERIDIAN_IMAGE=ghcr.io/finepointcgi/meridian
MERIDIAN_VERSION=0.6.0

# ---------------------------------------------------------------- public address and TLS (Caddy)
# Host name users type in the browser. DNS must point at this machine for Let's Encrypt to work.
MERIDIAN_DOMAIN=meridian.example.com
# E-mail for the ACME account (expiry notices). Required unless CADDY_TLS is set.
ACME_EMAIL=admin@example.com
# Optional override of Caddy's "tls" directive: leave unset to use ACME_EMAIL, or "internal" to use Caddy's
# self-signed local CA (testing, air-gapped intranets; clients must trust Caddy's root certificate).
# CADDY_TLS=internal
# Interface and ports Caddy publishes on the host.
HTTP_BIND=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443

# ---------------------------------------------------------------- database (PostgreSQL 17 container)
POSTGRES_DB=meridian
POSTGRES_USER=meridian
# REQUIRED. Generate one: openssl rand -base64 32 | tr -d '/+='   (avoid ; and quotes: it is embedded in a connection string)
POSTGRES_PASSWORD=change-me
# Npgsql connection pool size per Meridian instance.
MERIDIAN_DB_POOL_SIZE=50

# ---------------------------------------------------------------- accounts and sign-in (Meridian:Security)
# Comma-separated usernames that are always server administrators (otherwise the first registered account is).
MERIDIAN_ADMINS=
# Let anyone who can reach the server create an account. Keep false on the internet; create the first admin, then invite.
MERIDIAN_ALLOW_REGISTRATION=false
# Wrong passwords in a row before an account is locked (0 = never), and for how long.
MERIDIAN_MAX_FAILED_LOGINS=5
MERIDIAN_LOCKOUT_MINUTES=15
# Sign-in attempts allowed per client IP per minute.
MERIDIAN_LOGIN_ATTEMPTS_PER_MINUTE=10

# ---------------------------------------------------------------- single sign-on (Meridian:Sso, one OpenID Connect provider)
# Redirect URI to register at the provider: https://<MERIDIAN_DOMAIN>/signin-oidc-<MERIDIAN_SSO_NAME>
# Leave MERIDIAN_SSO_NAME empty to disable. More providers: see docs/DEPLOYMENT.md.
MERIDIAN_SSO_NAME=
MERIDIAN_SSO_DISPLAY_NAME=
# e.g. https://login.microsoftonline.com/<tenant-id>/v2.0 or https://<org>.okta.com
# GitLab: MERIDIAN_SSO_NAME=gitlab and an empty authority mean gitlab.com; self-managed: https://gitlab.example.com
MERIDIAN_SSO_AUTHORITY=
MERIDIAN_SSO_CLIENT_ID=
MERIDIAN_SSO_CLIENT_SECRET=
# true = SSO only (no passwords, no registration, no HTTP Basic API auth). Create SSO admins first.
MERIDIAN_SSO_DISABLE_LOCAL_PASSWORDS=false

# ---------------------------------------------------------------- in-app scheduled backups (Meridian:Backup)
# Zip backups of every project (and users, without password hashes) written to the meridian-backups volume.
MERIDIAN_BACKUP_INTERVAL_HOURS=24
MERIDIAN_BACKUP_RETAIN=14

# ---------------------------------------------------------------- pg_dump sidecar ("backup" profile)
PG_BACKUP_INTERVAL_SECONDS=86400
PG_BACKUP_RETAIN_DAYS=14

# ---------------------------------------------------------------- scripting and plugins (docs/SCRIPTING.md, docs/PLUGINS.md)
# The script console runs arbitrary .NET code in the server process: off unless you trust every project owner.
MERIDIAN_SCRIPTING_ENABLED=false
# Load plugins from the meridian-plugins volume (empty by default).
MERIDIAN_PLUGINS_ENABLED=true

# ---------------------------------------------------------------- logging and telemetry
# json (one object per line, for log shippers) or simple (human-readable).
MERIDIAN_LOG_FORMAT=json
# One line per HTTP request: method, path, status, duration. Never query strings, headers, cookies or bodies.
MERIDIAN_LOG_REQUESTS=true
MERIDIAN_LOG_LEVEL=Information
# OTLP endpoint for traces and metrics. Empty = off. With the "otel" profile: http://otel-collector:4317
MERIDIAN_OTLP_ENDPOINT=
# Also export logs over OTLP.
MERIDIAN_OTLP_EXPORT_LOGS=false

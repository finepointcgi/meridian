{
  "format": "meridian",
  "version": 1,
  "root": {
    "id": "_8481baf4db6e48fb862c4b9c2831c166",
    "kind": "Model",
    "fields": {
      "architecture.disabledRules": "missing-in-model",
      "documentation": "Meridian\u0027s own architecture, modeled in Meridian. The \u00ABlayer\u00BB packages and the \u00ABimplemented\u00BB extension points are checked against the source code (src/) by Meridian\u0027s architecture checks on every test run (tests/Meridian.Tests/SelfArchitectureTests.cs). See docs/ARCHITECTURE.md.",
      "name": "Meridian"
    },
    "children": [
      {
        "id": "_43b4b4f02e1244aa94304997e948920c",
        "kind": "Package",
        "fields": {
          "documentation": "Architecture principles: the rules the structure below exists to keep.",
          "name": "Principles"
        },
        "children": [
          {
            "id": "_596f0cbc8d594156878cdc2b76682e6c",
            "kind": "Requirement",
            "fields": {
              "name": "Independent core",
              "reqId": "ARCH-001",
              "text": "Meridian.Core shall not depend on any other Meridian assembly, storage engine or UI framework."
            }
          },
          {
            "id": "_f3c92acca89e4d52977965bfd34006b5",
            "kind": "Requirement",
            "fields": {
              "name": "Acyclic assemblies",
              "reqId": "ARCH-002",
              "text": "Each assembly shall use only the assemblies its \u00ABallowed\u00BB dependencies name; the assembly graph shall stay acyclic."
            }
          },
          {
            "id": "_0fe79c79bd9a4e189686b7f80fe113ab",
            "kind": "Requirement",
            "fields": {
              "name": "One application, two hosts",
              "reqId": "ARCH-003",
              "text": "The team server and the desktop app shall run the same Meridian.Web application; the desktop app shall host it in-process."
            }
          },
          {
            "id": "_c8bf1f357e9a4b1dab6058306d755cb5",
            "kind": "Requirement",
            "fields": {
              "name": "Storage behind one contract",
              "reqId": "ARCH-004",
              "text": "All persistence shall go through IMeridianStore, with PostgreSQL for team servers and SQLite for local mode."
            }
          },
          {
            "id": "_00e16f6011c84caabdb8b700970d9765",
            "kind": "Requirement",
            "fields": {
              "name": "Undoable, replicable edits",
              "reqId": "ARCH-005",
              "text": "Every model change shall go through ModelRepository as an undoable operation that can be replicated to other sessions."
            }
          },
          {
            "id": "_a6f317d5fcdc47ce87954679f1795579",
            "kind": "Requirement",
            "fields": {
              "name": "Native code out of process",
              "reqId": "ARCH-006",
              "text": "FMU native code shall run in a separate Meridian.FmuHost process so a crash cannot take down the server."
            }
          },
          {
            "id": "_9f4268c6b930435aac991dcae869fd93",
            "kind": "Requirement",
            "fields": {
              "name": "Pluggable back ends",
              "reqId": "ARCH-007",
              "text": "Code readers, Git hosts, chat providers, requirements tools and plugins shall plug in through the interfaces in this model."
            }
          },
          {
            "id": "_10872b069819404c88ae03d7776993c7",
            "kind": "Requirement",
            "fields": {
              "name": "AI proposes, people decide",
              "reqId": "ARCH-008",
              "text": "Assistant changes shall be shown as a change set that the user applies or discards."
            }
          },
          {
            "id": "_f435c5f8f6734444b03481afb03d26a1",
            "kind": "TestCase",
            "fields": {
              "documentation": "tests/Meridian.Tests/SelfArchitectureTests.cs reads src/ with CSharpCodeReader and runs ArchitectureConformance against this model; any error fails the build.",
              "name": "Self-architecture check"
            }
          },

      {
        "id": "_a4df4dc2442046ccaf73b4abb8bc1765",
        "kind": "Package",
        "fields": {
          "documentation": "Key runtime flows.",
          "name": "Behavior"
        },
        "children": [
          {
            "id": "_3a47aacf10c140db8af2273cedfb0412",
            "kind": "Activity",
            "fields": {
              "documentation": "What one push to a connected repository does (docs/CODE-SYNC.md, docs/ARCHITECTURE-CHECKS.md). Not drawn: a failed run posts a failure meridian/model status and skips the architecture check.",
              "name": "Code sync and architecture check"
            },
            "children": [
              {
                "id": "_7440b8e389ae4ba9814d7ac00fb82295",
                "kind": "InitialNode"
              },
              {
                "id": "_36a30b0596c345f9a0f2b9b91b389f2b",
                "kind": "Action",
                "fields": {
                  "documentation": "POST /api/code-sync/{connection}/webhook, verified per host.",
                  "name": "Receive push webhook"
                }
              },
              {
                "id": "_52d4d1d82c3f402cbcc353459c3d31d6",
                "kind": "Action",
                "fields": {
                  "documentation": "IGitHost.FetchSnapshotAsync reads the archive at the pushed commit, with submodules at their pinned commits.",
                  "name": "Fetch snapshot"
                }
              },
              {
                "id": "_4714addf1b9e4ebca2cd1effb2318e3e",
                "kind": "Action",
                "fields": {
                  "documentation": "ICodeReader (the auto reader) builds a CodeModel; Mermaid, PlantUML and draw.io files are re-imported.",
                  "name": "Read code and diagram files"
                }
              },
              {
                "id": "_0ead97a132584456ae1fbc2332129f61",
                "kind": "Action",
                "fields": {
                  "documentation": "CodeModelMapper and CodeModelApplier record the changes as replication operations (ModelOp).",
                  "name": "Map onto a copy of the branch"
                }
              },
              {
                "id": "_1fc86d222e8e4a63a4746bbec3dc5a52",
                "kind": "DecisionNode"
              },
              {
                "id": "_c42aedb52e4d482e9427a6bb418692fe",
                "kind": "Action",
                "fields": {
                  "documentation": "The first import of a repository goes straight into main.",
                  "name": "Import into main"
                }
              },
              {
                "id": "_bf891145e88f45d6a70c3fb470dbee73",
                "kind": "Action",
                "fields": {
                  "documentation": "code-sync/\u003Crepository\u003E; open sessions on the branch receive the operations live.",
                  "name": "Commit to review branch"
                }
              },
              {
                "id": "_e2842cf77afc4b718ec91527d88ab955",
                "kind": "Action",
                "fields": {
                  "documentation": "No branch is created.",
                  "name": "Record No changes"
                }
              },
              {
                "id": "_d864793efc6f45b1b2c86b8e0738b6b5",
                "kind": "DecisionNode"
              },
              {
                "id": "_71232e5150db42cca4c5b0218388f758",
                "kind": "Action",
                "fields": {
                  "documentation": "CodeSyncEvents.RunCompleted(request, outcome) for every run that did not fail.",
                  "name": "Raise RunCompleted"
                }
              },
              {
                "id": "_7d9f079773f14bb38c1430f56cc581ad",
                "kind": "ForkNode"
              },
              {
                "id": "_3978e330e7154479989639abda7a8d20",
                "kind": "Action",
                "fields": {
                  "documentation": "Commit status with the run summary and review link.",
                  "name": "Post meridian/model status"
                }
              },
              {
                "id": "_dc65ac1c9398456bae60a4511a15acb7",
                "kind": "Action",
                "fields": {
                  "documentation": "ArchitectureCheckService runs ArchitectureConformance against main\u0027s model.",
                  "name": "Check architecture"
                }
              },
              {
                "id": "_72b567dbd3bd4be281fd77609a717d9d",
                "kind": "Action",
                "fields": {
                  "documentation": "Fails pull requests on violations when the connection says so.",
                  "name": "Post meridian/architecture status"
                }
              },
              {
                "id": "_2d28d53276914e6bb9bbb47ffdb15371",
                "kind": "ForkNode"
              },
              {
                "id": "_75ee8ab47f044d47ac52e5684b43f9f0",
                "kind": "ActivityFinalNode"
              },
              {
                "id": "_2a74d85bb94c453da1f8200c6fd1d40e",

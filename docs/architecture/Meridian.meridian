      {
        "id": "_ad2bb2baa2654c58a9bae7d7cdfd2e38",
        "kind": "Package",
        "fields": {
          "documentation": "Meridian and the people and systems it works with.",
          "name": "Context"
        },
        "children": [
          {
            "id": "_654726a0689c442aa29f1b13515299d8",
            "kind": "Block",
            "fields": {
              "documentation": "Model-based systems engineering workbench: a team server (web) and a desktop app (Windows, macOS, Linux). Its subsystems, by assembly, are on the Subsystems by assembly diagram.",
              "name": "Meridian",
              "stereotypes": "system"
            }
          },
          {
            "id": "_c75a41a2999a4a809b70080d046efe75",
            "kind": "Actor",
            "fields": {

      {
        "id": "_55d0c78899da4c4bb6b3aec0a597b190",
        "kind": "Package",
        "fields": {
          "documentation": "One \u00ABlayer\u00BB package per assembly under src/. Each layer\u0027s namespaces tag maps code to it, and its \u00ABallowed\u00BB dependencies are the only other assemblies its code may use. Mirrors the \u003CProjectReference\u003E graph.",
          "name": "Assemblies"
        },
        "children": [
          {
            "id": "_09fbf361e67a41819def294cbaffcdbf",
            "kind": "Package",
            "fields": {
              "documentation": "Model repository, metamodel and notation, layout, analysis, simulation, validation, code-sync mapping. Depends on nothing else in Meridian.",
              "name": "Meridian.Core",
              "stereotypes": "layer",
              "tag:allowed": "none",
              "tag:namespaces": "Meridian.Core"
            },
            "children": [
              {
                "id": "_b887304fa6394bc891ff59dd8d1b10b2",
                "kind": "Block",
                "fields": {
                  "documentation": "ModelRepository: containment tree, id and incidence indexes, undo history. Every public mutator is undoable and raises Changed. Namespaces: Meridian.Core.Model, Meridian.Core.Commands.",
                  "name": "Model kernel",
                  "stereotypes": "subsystem"
                }
              },
              {
                "id": "_668a811d9da5480981b9e5fc6bbfcebd",
                "kind": "Block",
                "fields": {
                  "documentation": "Metamodel (what may own and connect what), notation and default sizes, auto-layout, edge routing, the auto-diagrammer, UAF viewpoints. Namespaces: Meridian.Core.Language.",
                  "name": "Language and notation",
                  "stereotypes": "subsystem"
                }
              },

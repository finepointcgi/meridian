<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Meridian.Core\Meridian.Core.csproj" />
    <ProjectReference Include="..\Meridian.Serialization\Meridian.Serialization.csproj" />
    <ProjectReference Include="..\Meridian.Data\Meridian.Data.csproj" />
    <ProjectReference Include="..\Meridian.Scripting\Meridian.Scripting.csproj" />
    <!-- Out-of-process FMU runner for co-simulation (docs/FMI.md): its output lands next to the server. -->
    <ProjectReference Include="..\Meridian.FmuHost\Meridian.FmuHost.csproj" />
    <ProjectReference Include="..\Meridian.Assistant\Meridian.Assistant.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MudBlazor" Version="8.15.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.14" />
    <!-- Observability (OTLP export, opt-in via Meridian:Telemetry:OtlpEndpoint). Pinned; audited with "dotnet list package (vulnerable, transitive)". -->
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.2" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.20.2" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.20.1" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

</Project>

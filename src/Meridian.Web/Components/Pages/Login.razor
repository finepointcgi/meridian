@page "/login"
@layout Meridian.Web.Components.Layout.EmptyLayout
@attribute [ExcludeFromInteractiveRouting]
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]

<PageTitle>Sign in — Meridian</PageTitle>

<div class="auth">
    <div class="auth-card">
        <div class="auth-brand">
            <span class="logo">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="#fff"><path d="M12 2a3 3 0 0 1 1 5.83V10h4.17A3 3 0 1 1 17 12h-4v2.17A3 3 0 1 1 11 14.17V12H7a3 3 0 1 1 .17-2H11V7.83A3 3 0 0 1 12 2z"/></svg>
            </span>
            <span>Meridian</span>
        </div>
        <h1>@(Register ? "Create your account" : "Welcome back")</h1>
        <p class="auth-sub">@(Register ? "Model systems together — SysML, requirements and traceability in one place." : "Sign in to your modeling workspace.")</p>

        @if (!string.IsNullOrEmpty(Error))
        {
            <div class="auth-error">@Error</div>
        }

        <form method="post" action="@(Register ? "/account/register" : "/account/login")">
            <label>Username<input name="username" autocomplete="username" required autofocus /></label>
            @if (Register)
            {
                <label>Display name<input name="display" autocomplete="name" placeholder="Shown to collaborators" /></label>
            }
            <label>Password<input name="password" type="password" autocomplete="@(Register ? "new-password" : "current-password")" required minlength="@(Register ? 8 : 1)" /></label>
            <button type="submit">@(Register ? "Create account" : "Sign in")</button>
        </form>

        <div class="auth-switch">
            @if (Register)
            {
                <span>Already have an account? <a href="/login">Sign in</a></span>
            }
            else
            {
                <span>New to Meridian? <a href="/login?mode=register">Create an account</a></span>
            }
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery] public string? Mode { get; set; }
    [SupplyParameterFromQuery] public string? Error { get; set; }
    private bool Register => Mode == "register";
}

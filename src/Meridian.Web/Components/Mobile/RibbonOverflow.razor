@inherits MobileComponent

@* Tablet ribbon: the groups mobile.css hides at 900–1280px (model views, simulate, generate, extend) live in this menu. *@
<div class="rgroup r-overflow">
    <div class="rlabel">More</div>
    <div class="ritems">
        <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Dense="true">
            <ActivatorContent>
                <button class="rbtn" aria-label="More commands" title="More commands"><MudIcon Icon="@Icons.Material.Outlined.MoreHoriz" /><span class="t">More</span></button>
            </ActivatorContent>
            <ChildContent>
                <MudMenuItem Disabled="true" Class="r-overflow-title">Model views</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Outlined.TableChart" OnClick="() => Shell?.ShowTables(TablesPanel.Mode.Table)">Tables</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Outlined.ManageSearch" OnClick="() => Shell?.ShowTables(TablesPanel.Mode.Query)">Query</MudMenuItem>
                <MudDivider />
                <MudMenuItem Disabled="true" Class="r-overflow-title">Simulate</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Outlined.PlayCircle" OnClick="() => Shell?.ShowDock(5)">Simulate</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Outlined.Functions" OnClick="() => Shell?.ShowDock(6)">Parametrics</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Outlined.Balance" OnClick="() => Shell?.ShowDock(11)">Variants &amp; trades</MudMenuItem>
                <MudDivider />
                <MudMenuItem Disabled="true" Class="r-overflow-title">Generate</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Outlined.Article" OnClick="() => Shell?.RunOpenReport() ?? Task.CompletedTask">Report</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Outlined.Code" OnClick="() => Shell?.RunExportSysML() ?? Task.CompletedTask">SysML v2 text</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Outlined.EditNote" OnClick="() => Shell?.RunEditAsSysml()">Edit as SysML v2 text</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Outlined.SwapHoriz" OnClick="() => Shell?.RunExportXmi() ?? Task.CompletedTask">XMI</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Outlined.DataObject" OnClick="() => Shell?.RunGenerateCode() ?? Task.CompletedTask">C# code</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Outlined.Description" OnClick="() => Shell?.RunExportDocx() ?? Task.CompletedTask">Word / PDF document…</MudMenuItem>
                <MudDivider />
                <MudMenuItem Disabled="true" Class="r-overflow-title">Extend</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Outlined.Terminal" OnClick="() => Shell?.ShowDock(10)">Script console</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Outlined.Search" OnClick="() => Shell?.ShowPalette()">All commands… (⌘K)</MudMenuItem>
            </ChildContent>
        </MudMenu>
    </div>
</div>

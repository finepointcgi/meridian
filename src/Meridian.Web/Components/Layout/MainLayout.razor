@inherits LayoutComponentBase
@implements IDisposable
@inject Meridian.Web.Settings.ThemeService Theme
@inject PersistentComponentState AppState
@inject IJSRuntime JS

<MudThemeProvider Theme="Theme.MudTheme" IsDarkMode="Theme.IsDark" />
<MudPopoverProvider />
<MudDialogProvider MaxWidth="MaxWidth.Small" FullWidth="true" CloseOnEscapeKey="true" />
<MudSnackbarProvider />

@Body

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private const string StateKey = "meridian.theme";
    private PersistingComponentStateSubscription _persisting;
    private DotNetObjectReference<MainLayout>? _self;

    protected override async Task OnInitializedAsync()
    {
        Theme.Changed += OnThemeChanged;
        // Interactive render after the prerender: take what the prerender loaded, so the first paint already has the theme.
        if (AppState.TryTakeFromJson<Meridian.Web.Settings.ThemeService.Snapshot>(StateKey, out var snapshot) && snapshot != null) Theme.Restore(snapshot);
        else await Theme.EnsureLoadedAsync();
        _persisting = AppState.RegisterOnPersisting(() =>
        {
            AppState.PersistAsJson(StateKey, Theme.TakeSnapshot());
            return Task.CompletedTask;
        });
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _self = DotNetObjectReference.Create(this);
        Meridian.Web.Settings.BrowserInfo? info = null;
        try { info = await JS.InvokeAsync<Meridian.Web.Settings.BrowserInfo?>("meridianSettings.init", _self); }
        catch (Exception e) when (e is JSException or InvalidOperationException or TaskCanceledException or JSDisconnectedException) { }
        if (info != null)
        {
            Theme.SetSystemDark(info.SystemDark);
            if (info.Device is { Length: > 0 } d && Meridian.Web.Settings.DevicePreferences.FromCookie(d) is var device && device != Theme.Device) Theme.SetDevice(device);
            await Theme.MigrateLegacyAsync(info.Legacy);
        }
        await Theme.PushAsync(JS);
    }

    [JSInvokable]
    public void OnSystemSchemeChanged(bool dark) => _ = InvokeAsync(() => Theme.SetSystemDark(dark));

    private void OnThemeChanged() => _ = InvokeAsync(async () =>
    {
        StateHasChanged();
        await Theme.PushAsync(JS);
    });

    public void Dispose()
    {
        Theme.Changed -= OnThemeChanged;
        _persisting.Dispose();
        _self?.Dispose();
    }
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="@(_dark ? "#0a0f19" : "#e9edf4")" />
    <meta http-equiv="Accept-CH" content="Sec-CH-Prefers-Color-Scheme" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Meridian" />
    <link rel="manifest" href="manifest.webmanifest" />
    <link rel="icon" type="image/png" sizes="192x192" href="icons/icon-192.png" />
    <link rel="apple-touch-icon" href="icons/apple-touch-icon.png" />
    <base href="/" />
    <title>Meridian</title>
    <ResourcePreloader />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["reviews.css"]" />
    <link rel="stylesheet" href="@Assets["admin.css"]" />
    <link rel="stylesheet" href="@Assets["extras.css"]" />
    <link rel="stylesheet" href="@Assets["mobile.css"]" />
    <link rel="stylesheet" href="@Assets["settings.css"]" />
    <link rel="stylesheet" href="@Assets["css/multiselect.css"]" />
    <link rel="stylesheet" href="@Assets["css/permissions.css"]" />
    <link rel="stylesheet" href="@Assets["css/libraries.css"]" />
    <link rel="stylesheet" href="@Assets["css/verification.css"]" />
    <ImportMap />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

@* The theme is rendered from the stored preferences (signed in) or this device's cookies, so there is no flash (Settings/ThemeService.cs). *@
<body class="@_bodyClass" style="@_bodyStyle">
    <Routes @rendermode="PageRenderMode" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
    <script src="@Assets["js/meridian.js"]"></script>
    <script src="@Assets["js/meridian-extras.js"]"></script>
    <script src="@Assets["js/settings.js"]"></script>
</body>

</html>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    [Inject] private Meridian.Data.IMeridianStore Db { get; set; } = default!;
    private bool _dark = true;
    private string _bodyClass = "m-theme-dark", _bodyStyle = "";

    protected override async Task OnInitializedAsync()
    {
        try { (_dark, _bodyClass, _bodyStyle) = await Settings.ThemeBootstrap.BodyAsync(HttpContext, Db); }
        catch (Exception e) when (e is InvalidOperationException or System.Data.Common.DbException) { /* keep the default theme */ }
    }

    // The sign-in page is static server-rendered (plain form post); everything else is interactive.
    private IComponentRenderMode? PageRenderMode => HttpContext.AcceptsInteractiveRouting() ? InteractiveServer : null;
}

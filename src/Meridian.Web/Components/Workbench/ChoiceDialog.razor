@* Asks the user to pick one of a few options (e.g. the association a new link is an instance of). Returns the chosen id. *@
<MudDialog>
    <TitleContent><MudText Typo="Typo.h6">@(MudDialog?.Title)</MudText></TitleContent>
    <DialogContent>
        @if (!string.IsNullOrEmpty(Message)) { <MudText Typo="Typo.body2" Class="mb-3">@Message</MudText> }
        <MudRadioGroup T="string" @bind-Value="_value">
            @foreach (var (id, label) in Choices)
            {
                <MudRadio T="string" Value="@id" Color="Color.Primary" data-testid="choice">@label</MudRadio>
            }
        </MudRadioGroup>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => MudDialog.Cancel()">Leave untyped</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="_value == null" OnClick="() => MudDialog.Close(DialogResult.Ok(_value))">OK</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public string Message { get; set; } = "";
    [Parameter] public IReadOnlyList<(string Id, string Label)> Choices { get; set; } = [];

    private string? _value;

    protected override void OnParametersSet() => _value ??= Choices.FirstOrDefault().Id;
}

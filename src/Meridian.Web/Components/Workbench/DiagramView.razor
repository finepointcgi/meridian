    private IEnumerable<(string Title, IReadOnlyList<PaletteItem> Items)> Sections()
    {
        var t = C.Diagram.DiagramType;
        var q = _shapeQuery?.Trim();
        IReadOnlyList<PaletteItem> F(IEnumerable<PaletteItem> items) =>
            string.IsNullOrEmpty(q) ? items.ToList() : items.Where(i => i.Title.Contains(q, StringComparison.OrdinalIgnoreCase)).ToList();
        var sections = t == DiagramType.Whiteboard
            ? new List<(string, IReadOnlyList<PaletteItem>)> { ("Shapes", F(Metamodel.PaletteItems(t).Append(ImageItem))), ("Connectors", F(Metamodel.PaletteLinks(t))) }
            : [
                (Metamodel.DisplayName(t).Replace(" Diagram", ""), F(Metamodel.PaletteItems(t))),
                ("Relationships", F(Metamodel.PaletteLinks(t))),
                ("General", F(Metamodel.GeneralItems.Append(ImageItem))),
                ("Lines", F(Metamodel.GeneralLinks)),
              ];
        return sections.Where(x => x.Item2.Count > 0);
    }

    private void ShowShapes(bool open)
    {
        _shapesOpen = open;
        C.LeftInset = open && !C.ReadOnly ? 236 : 64;
    }

    private void TileClick(PaletteItem item, MouseEventArgs e)
    {
        if (IsImageItem(item)) { C.SetTool(null); _ = PickImage(); return; }
        if (Metamodel.IsRelationship(item.Kind) || e.ShiftKey) SetTool(item);
        else
        {
            C.SetTool(null);
            C.InsertItem(item);
        }
        _ = JS.InvokeVoidAsync("meridian.focus", _canvas);
    }

    private IEnumerable<PaletteItem> QuickAddItems()
    {
        var t = C.Diagram.DiagramType;
        var all = Metamodel.PaletteItems(t).Concat(t == DiagramType.Whiteboard ? [] : Metamodel.GeneralItems);
        var q = _quickQuery?.Trim();
        return (string.IsNullOrEmpty(q) ? all : all.Where(i => i.Title.Contains(q, StringComparison.OrdinalIgnoreCase))).Take(12);
    }

    private void QuickKey(KeyboardEventArgs e)
    {
        var hits = QuickAddItems().ToList();
        switch (e.Key)
        {
            case "Escape": C.QuickAddRequest = null; _ = JS.InvokeVoidAsync("meridian.focus", _canvas); break;
            case "ArrowDown": _quickIndex = Math.Min(hits.Count - 1, _quickIndex + 1); break;
            case "ArrowUp": _quickIndex = Math.Max(0, _quickIndex - 1); break;
            case "Enter" when hits.Count > 0: QuickPick(hits[Math.Clamp(_quickIndex, 0, hits.Count - 1)]); break;
            default: _quickIndex = 0; break;
        }
    }

    private void QuickPick(PaletteItem item)
    {
        if (C.QuickAddRequest is not { } at) return;
        C.QuickAddRequest = null;
        C.CreateAtScreen(item, at.X, at.Y);
        _ = JS.InvokeVoidAsync("meridian.focus", _canvas);
    }


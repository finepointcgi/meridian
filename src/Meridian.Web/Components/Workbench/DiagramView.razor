@using System.Globalization
@using System.Text
@using Meridian.Serialization
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject Workspace Ws
@inject ImageCache Images
@inject IDialogService Dialogs

<div class="canvas @(C.ProtectedByPermissions ? "perm-locked" : "") @(C.Tool != null ? "tool-active" : "") @(C.Current == DiagramController.Gesture.Pan ? "panning" : C.SpaceHeld ? "grab" : "") @(_shapesOpen && !C.ReadOnly ? "shapes-open" : "")"
     tabindex="0" @ref="_canvas"
     @onpointerdown="Down" @onpointermove="Move" @onpointerup="Up" @onpointerleave="Leave"
     @onwheel="Wheel" @onkeydown="Key" @onkeyup="KeyUp"
     @ondragenter:preventDefault="true" @ondragover:preventDefault="true" @ondrop="Drop">
    <svg class="main" xmlns="http://www.w3.org/2000/svg">
        @((MarkupString)Theme.Defs)
        <g transform="translate(@F(C.PanX),@F(C.PanY)) scale(@F(C.Zoom))" font-size="12">
            @((MarkupString)Body())
            @Adorners()
        </g>
    </svg>

    @if (C.ProtectedByPermissions)
    {
        @* Package permissions: this diagram's package is read-only for me (the server refuses edits to it too). *@
        var protector = Ws.Access.ProtectingPackage(C.Diagram);
        <div class="perm-readonly" data-testid="diagram-read-only" @onpointerdown:stopPropagation="true">
            <MudIcon Icon="@Icons.Material.Filled.Lock" Style="font-size:14px" />
            @if (Ws.LibraryOf(C.Diagram) is { } lib)
            {
                @($"Read-only — from used project “{lib.SourceProjectName}” ({lib.PinLabel})")
            }
            else
            {
                @($"Read-only{(protector != null ? $" — “{protector.DisplayName}” is protected" : "")}")
            }
        </div>
    }

    @if (Ws.CodeChanges is { } chg)
    {
        @* Code-sync legend chip: what the highlight colours mean, and the toggle. *@
        <div class="chg-legend" @onpointerdown:stopPropagation="true" @onwheel:stopPropagation="true">
            @if (Ws.HighlightCodeChanges)
            {
                <span class="chg-sw added"><i></i>Added @chg.Count(ChangeHighlight.Added)</span>
                <span class="chg-sw changed"><i></i>Changed @chg.Count(ChangeHighlight.Changed)</span>
                <span class="chg-sw removed"><i></i>Removed @chg.Count(ChangeHighlight.Removed)</span>
                <button class="chg-toggle" @onclick="() => Ws.SetHighlightCodeChanges(false)">Hide</button>
            }
            else
            {
                <button class="chg-toggle" @onclick="() => Ws.SetHighlightCodeChanges(true)">Highlight @chg.Label</button>
            }
        </div>
    }

    <DiagramLegends Diagram="C.Diagram" />

    @* Shapes panel (draw.io style): search, sections, click to insert, drag to place. Collapses to an icon strip. *@
    <div class="toolbox @(_shapesOpen ? "open" : "")" style="@(C.ReadOnly ? "display:none" : "")"
         @onpointerdown:stopPropagation="true" @onwheel:stopPropagation="true" @onkeydown:stopPropagation="true">
        @if (_shapesOpen)
        {
            <div class="shapes-head">
                <input class="shapes-search" placeholder="Search shapes" value="@_shapeQuery" @oninput="e => _shapeQuery = e.Value?.ToString()" />
                <MudTooltip Text="Collapse" Placement="Placement.Right">
                    <button class="tool sm" @onclick="() => ShowShapes(false)"><MudIcon Icon="@Icons.Material.Outlined.KeyboardDoubleArrowLeft" /></button>
                </MudTooltip>
            </div>
            <div class="shapes-body">
                @foreach (var (title, items) in Sections())
                {
                    <div class="shapes-sec">@title</div>
                    <div class="shapes-grid">
                        @foreach (var it in items)
                        {
                            var item = it;
                            var on = C.IsTool(item);
                            var link = Metamodel.IsRelationship(item.Kind);
                            <div class="tile @(on ? "on" : "")" draggable="@(link ? "false" : "true")" data-drag="palette"
                                 title="@(link ? $"{item.Title}: click, then drag from one shape to another" : $"{item.Title}: click to add, or drag onto the canvas (Shift+click keeps the tool)")"
                                 @ondragstart="() => _paletteDrag = item" @ondragend="() => _paletteDrag = null"
                                 @onclick="e => TileClick(item, e)">
                                @Thumb(item, on)
                                <span>@item.Title</span>
                            </div>
                        }
                    </div>
                }
            </div>
        }
        else
        {
            <MudTooltip Text="Show shapes" Placement="Placement.Right">
                <button class="tool" @onclick="() => ShowShapes(true)"><MudIcon Icon="@Icons.Material.Outlined.Category" /></button>
            </MudTooltip>
            <MudTooltip Text="Select (Esc)" Placement="Placement.Right">
                <button class="tool @(C.Tool == null ? "on" : "")" @onclick="() => SetTool(null)"><MudIcon Icon="@Icons.Material.Outlined.NearMe" /></button>
            </MudTooltip>
            <div class="tsep"></div>
            @foreach (var it in Metamodel.PaletteItems(C.Diagram.DiagramType).Concat(Metamodel.PaletteLinks(C.Diagram.DiagramType)))
            {
                var item = it;
                var on = C.IsTool(item);
                <MudTooltip Text="@item.Title" Placement="Placement.Right">
                    <button class="tool @(on ? "on" : "")" draggable="@(Metamodel.IsRelationship(item.Kind) ? "false" : "true")" data-drag="palette"
                            @ondragstart="() => _paletteDrag = item" @onclick="e => TileClick(item, e)">
                        @Thumb(item, on)
                    </button>
                </MudTooltip>
            }
        }
    </div>

    @if (!C.ReadOnly && C.Tool == null && C.Current == DiagramController.Gesture.None && C.SelectionCount > 0
         && C.Editing == null && C.EditingEdge == null)
    {
        var nodes = C.SelectedNodes.Count > 0;
        var edges = C.SelectedEdges.Count > 0;
        var shapes = C.SelectedNodes.Where(n => n.Element.Kind == ElementKind.Shape).ToList();
        var line = C.SelectedEdges.Any(x => x.Relationship.Kind == ElementKind.Line);
        // Near the top of the view the bar would cover what is selected: show it at the bottom instead.
        var barBelow = C.SelectedNodes.Count > 0 && C.SelectedNodes.Min(n => C.ToScreen(new(C.BoundsOf(n).X, C.BoundsOf(n).Y)).Y) < 64;
        <div class="selbar @(barBelow ? "below" : "")" @onpointerdown:stopPropagation="true" @onkeydown:stopPropagation="true" @onwheel:stopPropagation="true">
            @if (C.SelectionCount >= 2)
            {
                <span class="cnt" data-testid="selection-count">@C.SelectionCount selected</span>
            }
            @if (C.SelectedNodes.Count >= 2)
            {
                @SelBtn("left", Icons.Material.Outlined.AlignHorizontalLeft, "Align left")
                @SelBtn("center", Icons.Material.Outlined.AlignHorizontalCenter, "Align centers")
                @SelBtn("right", Icons.Material.Outlined.AlignHorizontalRight, "Align right")
                @SelBtn("top", Icons.Material.Outlined.AlignVerticalTop, "Align top")
                @SelBtn("middle", Icons.Material.Outlined.AlignVerticalCenter, "Align middles")
                @SelBtn("bottom", Icons.Material.Outlined.AlignVerticalBottom, "Align bottom")
                @SelBtn("hdist", Icons.Material.Outlined.HorizontalDistribute, "Distribute horizontally (3+)")
                @SelBtn("vdist", Icons.Material.Outlined.VerticalDistribute, "Distribute vertically (3+)")
                @SelBtn("width", Icons.Material.Outlined.SwapHoriz, "Same width")
                @SelBtn("height", Icons.Material.Outlined.SwapVert, "Same height")
                <span class="sep"></span>
            }
            @if (nodes) { @ColorBtn("fill", "Fill", Icons.Material.Outlined.FormatColorFill) }
            @ColorBtn("stroke", nodes ? "Line color" : edges && C.SelectedEdges.Count > 1 ? "Connector colors" : "Connector color", Icons.Material.Outlined.BorderColor)
            @if (nodes) { @ColorBtn("text", "Text color", Icons.Material.Outlined.FormatColorText) }
            @if (nodes && C.SelectionHasContainer)
            {
                <MudTooltip Text="Fit to contents"><button aria-label="Fit to contents" class="tool" @onclick="C.FitSelectionToContents"><MudIcon Icon="@Icons.Material.Outlined.FitScreen" /></button></MudTooltip>
                <span class="sep"></span>
            }
            @if (C.SelectedEdge is { } routedEdge && !nodes && EdgeRouter.Routable(routedEdge))
            {
                var current = C.SelectedRouting;
                <span class="fmt-wrap">
                    <MudTooltip Text="@($"Connector style: {(current is { } cr ? EdgeRouter.Display(cr) : "manual bends")}")">
                        <button class="tool @(_fmtMenu == "routing" ? "on" : "")" @onclick='() => ToggleFmt("routing")'>@((MarkupString)RoutingIcon(current ?? EdgeRouting.Legacy))</button>
                    </MudTooltip>
                    @if (_fmtMenu == "routing")
                    {
                        <div class="fmt-pop shapes-grid">
                            @foreach (var r in new[] { EdgeRouting.Orthogonal, EdgeRouting.Straight, EdgeRouting.Curved, EdgeRouting.Legacy })
                            {
                                var style = r;
                                <div class="tile @(current == style ? "on" : "")" title="@EdgeRouter.Display(style)" @onclick="() => { C.SetSelectedRouting(style); _fmtMenu = null; }">
                                    <span class="thumb">@((MarkupString)RoutingIcon(style))</span><span>@EdgeRouter.Display(style).Replace(" (routed)", "")</span>
                                </div>
                            }
                        </div>
                    }
                </span>
            }
            @if (nodes || edges)
            {
                <span class="fmt-wrap">
                    <MudTooltip Text="Line pattern"><button class="tool @(_fmtMenu == "dash" ? "on" : "")" @onclick='() => ToggleFmt("dash")'><MudIcon Icon="@Icons.Material.Outlined.LineStyle" /></button></MudTooltip>
                    @if (_fmtMenu == "dash")
                    {
                        var dashNow = C.SelectionStyle("dash");
                        <div class="fmt-pop widths">
                            @foreach (var (value, array) in new (string?, string?)[] { (null, null), ("solid", null), ("dashed", "6,4"), ("dotted", "2,3") })
                            {
                                var v = value;
                                <div class="@(dashNow == v ? "wopt on" : "wopt")" title="@(v ?? "Default")" @onclick='() => SetFmt("dash", v)'>
                                    @if (v == null) { <span style="font-size:11px">Default</span> }
                                    else { <svg width="60" height="14"><line x1="4" y1="7" x2="56" y2="7" stroke="currentColor" stroke-width="2" stroke-dasharray="@array" /></svg> }
                                </div>
                            }
                        </div>
                    }
                </span>
                <span class="fmt-wrap">
                    <MudTooltip Text="Line width"><button class="tool @(_fmtMenu == "width" ? "on" : "")" @onclick='() => ToggleFmt("width")'><MudIcon Icon="@Icons.Material.Outlined.LineWeight" /></button></MudTooltip>
                    @if (_fmtMenu == "width")
                    {
                        <div class="fmt-pop widths">
                            @foreach (var w in new[] { "1.3", "2", "3", "4.5" })
                            {
                                var width = w;
                                <div class="@WidthClass(width)" @onclick="() => SetWidth(width)">
                                    <svg width="60" height="14"><line x1="4" y1="7" x2="56" y2="7" stroke="currentColor" stroke-width="@width" /></svg>
                                </div>
                            }
                        </div>
                    }
                </span>
            }
            @if (shapes.Count > 0 || line)
            {
                var kind = line && !nodes ? ElementKind.Line : ElementKind.Shape;
                <span class="fmt-wrap">
                    <MudTooltip Text="@(kind == ElementKind.Shape ? "Change shape" : "Line style")"><button class="tool @(_fmtMenu == "shape" ? "on" : "")" @onclick='() => ToggleFmt("shape")'><MudIcon Icon="@(kind == ElementKind.Shape ? Icons.Material.Outlined.Category : Icons.Material.Outlined.NorthEast)" /></button></MudTooltip>
                    @if (_fmtMenu == "shape")
                    {
                        <div class="fmt-pop shapes-grid">
                            @foreach (var sub in Subtypes.For(kind))
                            {
                                var st = sub;
                                var item = new PaletteItem(kind, st);
                                <div class="tile" title="@item.Title" @onclick="() => { C.SetSelectionSubtype(kind, st); _fmtMenu = null; }">@Thumb(item, false)<span>@item.Title</span></div>
                            }
                        </div>
                    }
                </span>
            }
            <span class="sep"></span>
            <MudTooltip Text="Copy format"><button aria-label="Copy format" class="tool" @onclick="C.CopyFormat"><MudIcon Icon="@Icons.Material.Outlined.FormatPaint" /></button></MudTooltip>
            <MudTooltip Text="Paste format"><button aria-label="Paste format" class="tool" disabled="@(!C.CanPasteFormat)" @onclick="C.PasteFormat"><MudIcon Icon="@Icons.Material.Outlined.ContentPasteGo" /></button></MudTooltip>
            <MudTooltip Text="Reset to default look"><button aria-label="Reset to default look" class="tool" @onclick="C.ClearFormat"><MudIcon Icon="@Icons.Material.Outlined.FormatClear" /></button></MudTooltip>
            <span class="sep"></span>
            @if (nodes)
            {
                var link = C.SelectionLink();
                <MudTooltip Text="@(link == null ? "Add link (web address or element)" : $"Link: {DiagramLinks.Describe(Ws, link)} — click to edit")">
                    <button class="tool @(link != null ? "has-link" : "")" @onclick="EditLink"><MudIcon Icon="@Icons.Material.Outlined.Link" /></button>
                </MudTooltip>
            }
            <span class="fmt-wrap">
                <MudTooltip Text="Layers"><button class="tool @(_fmtMenu == "layers" ? "on" : "")" @onclick='() => ToggleFmt("layers")'><MudIcon Icon="@Icons.Material.Outlined.Layers" /></button></MudTooltip>
                @if (_fmtMenu == "layers")
                {
                    <div class="fmt-pop layers-in-bar"><LayersPanel C="C" Changed="StateHasChanged" /></div>
                }
            </span>
            @if (nodes)
            {
                <MudTooltip Text="Duplicate (⌘D)"><button aria-label="Duplicate (⌘D)" class="tool" @onclick="C.DuplicateSelection"><MudIcon Icon="@Icons.Material.Outlined.ContentCopy" /></button></MudTooltip>
            }
            <MudTooltip Text="Remove from diagram (Backspace)"><button aria-label="Remove from diagram (Backspace)" class="tool" @onclick="C.RemoveSelectionFromDiagram"><MudIcon Icon="@Icons.Material.Outlined.Delete" /></button></MudTooltip>
        </div>
    }

    @* The connector type quick-connect picked automatically: a chip on the new line, one click to switch it. *@
    @if (C.AutoConnected is { } auto && C.Diagram.Edges.Contains(auto) && C.Current == DiagramController.Gesture.None && C.AutoAlternatives is { Count: > 0 } alts)
    {
        var at = C.ToScreen(Notation.Midpoint(Notation.RouteIn(C.Diagram, auto, C.BoundsOf)));
        var current = alts.FirstOrDefault(C.IsAutoChoice);
        <div class="conn-chip" data-testid="connector-chip" style="left:@F(at.X)px; top:@F(at.Y + 10)px"
             @onpointerdown:stopPropagation="true" @onkeydown:stopPropagation="true" @onwheel:stopPropagation="true">
            <button class="chip on" title="Connector type chosen automatically — click to change" @onclick="() => _connMenu = !_connMenu">
                @(current?.Label ?? Metamodel.DisplayName(auto.Relationship.Kind)) @(alts.Count > 1 ? "▾" : "")
            </button>
            @if (_connMenu && !C.ReadOnly)
            {
                <div class="conn-menu">
                    @foreach (var a in alts)
                    {
                        var choice = a;
                        <div class="conn-opt @(C.IsAutoChoice(choice) ? "on" : "")" data-testid="connector-option" @onclick="() => { C.SwitchAutoConnector(choice); _connMenu = false; }">
                            <span>@choice.Label</span>@if (choice.Reverse) { <span class="rev" title="Points the other way">⇄</span> }
                        </div>
                    }
                </div>
            }
        </div>
    }
    else { _connMenu = false; }

    @if (C.Tool is { } activeTool)
    {
        <div class="hint">
            @{ var title = C.ToolSubtype != null ? Subtypes.Display(C.ToolSubtype) : Metamodel.DisplayName(activeTool); }
            @(Metamodel.IsRelationship(activeTool) ? $"Drag from a source shape to a target to create {title}" : $"Click to place a {title}")
            · <b>Esc</b> to cancel
        </div>
    }

    @* Layers: a floating button in the top-right corner of the canvas. *@
    @{
        var layerCount = DiagramExtras.Layers(C.Diagram).Count;
        var hiddenCount = DiagramExtras.Layers(C.Diagram).Count(l => !l.Visible);
        <div class="layers-fab" @onpointerdown:stopPropagation="true" @onwheel:stopPropagation="true">
            <MudTooltip Text="Layers" Placement="Placement.Left">
                <button class="tool @(_layersOpen ? "on" : "")" @onclick="() => _layersOpen = !_layersOpen">
                    <MudIcon Icon="@Icons.Material.Outlined.Layers" />
                    @if (layerCount > 1) { <span class="badge @(hiddenCount > 0 ? "warn" : "")">@layerCount</span> }
                </button>
            </MudTooltip>
            @if (_layersOpen)
            {
                <LayersPanel C="C" Changed="StateHasChanged" />
            }
        </div>
    }

    @if (C.Diagram.Nodes.Count == 0)
    {
        <div class="empty-hint @(_shapesOpen && !C.ReadOnly ? "beside-shapes" : "")">
            <div class="empty-teach">
                <MudIcon Icon="@UiKinds.DiagramIcon(C.Diagram.DiagramType)" Style="font-size:44px; opacity:.5" />
                <h3>@Metamodel.DisplayName(C.Diagram.DiagramType) is empty</h3>
                <div class="teach-row">
                    <div class="teach">
                        <svg viewBox="0 0 120 70" width="120" height="70" aria-hidden="true">
                            <rect x="30" y="18" width="60" height="34" rx="6" fill="none" stroke="currentColor" stroke-dasharray="4,3" opacity=".55" />
                            <path d="M58,30 l0,14 l4,-4 l3,7 l3,-1 l-3,-7 l5,0 Z" fill="#4f8cff" />
                            <text x="60" y="66" text-anchor="middle" font-size="10" fill="currentColor">×2</text>
                        </svg>
                        <b>Double-click</b> anywhere to add a shape
                    </div>
                    <div class="teach">
                        <svg viewBox="0 0 120 70" width="120" height="70" aria-hidden="true">
                            <rect x="6" y="20" width="44" height="30" rx="5" fill="none" stroke="currentColor" opacity=".7" />
                            <path d="M56,30 h8 v-5 l9,10 l-9,10 v-5 h-8 Z" fill="#4f8cff" />
                            <line x1="74" y1="35" x2="84" y2="35" stroke="#4f8cff" stroke-width="2" stroke-dasharray="4,3" />
                            <rect x="86" y="20" width="30" height="30" rx="5" fill="none" stroke="#3fbf7f" stroke-width="1.5" />
                        </svg>
                        Hover a shape, <b>drag a blue arrow</b> to connect
                    </div>
                    <div class="teach">
                        <svg viewBox="0 0 120 70" width="120" height="70" aria-hidden="true">
                            <rect x="8" y="10" width="26" height="50" rx="4" fill="none" stroke="currentColor" opacity=".7" />
                            <rect x="13" y="16" width="16" height="10" rx="2" fill="currentColor" opacity=".35" />
                            <rect x="70" y="22" width="34" height="24" rx="4" fill="none" stroke="#4f8cff" />
                            <path d="M36,32 C48,26 56,30 66,33" fill="none" stroke="#4f8cff" stroke-width="1.6" stroke-dasharray="3,3" />
                        </svg>
                        <b>Drag</b> shapes, pictures or tree elements here
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="minimap" @onpointerdown="MiniMapClick" @onpointerdown:stopPropagation="true" @ref="_minimap">
            @{ var cb = C.ContentBounds(); var vp = C.Viewport; var shown = DiagramExtras.VisibleView(C.Diagram); }
            <svg viewBox="@F(cb.X) @F(cb.Y) @F(cb.Width) @F(cb.Height)" preserveAspectRatio="xMidYMid meet">
                @{ var miniRoutes = EdgeRouter.RouteAll(shown, C.MemoBounds()); }
                @foreach (var e in shown.Edges)
                {
                    var pts = miniRoutes[e];
                    <polyline points="@SvgRenderer.Points(pts)" fill="none" stroke="@Theme.Edge" stroke-opacity="0.6" stroke-width="@F(cb.Width / 200)" />
                }
                @foreach (var n in shown.Nodes)
                {
                    var b = C.BoundsOf(n);
                    <rect x="@F(b.X)" y="@F(b.Y)" width="@F(b.Width)" height="@F(b.Height)" rx="@F(cb.Width / 120)" fill="@Theme.Header(n.Element.Kind)" stroke="@Theme.Accent(n.Element.Kind)" stroke-width="@F(cb.Width / 260)" />
                }
                <rect x="@F(vp.X)" y="@F(vp.Y)" width="@F(vp.Width)" height="@F(vp.Height)" fill="#4f8cff" fill-opacity="0.08" stroke="#4f8cff" stroke-width="@F(cb.Width / 130)" rx="@F(cb.Width / 100)" />
            </svg>
        </div>
    }

    @if (C.Editing != null || C.EditingEdge != null)
    {
        var r = C.Editing is { } editing ? C.EditorRect(editing) : C.EditorRect(C.EditingEdge!);
        var multiline = C.Editing?.Element.Kind is ElementKind.Comment or ElementKind.Shape;
        <div class="inline-editor" style="left:@F(r.X)px; top:@F(r.Y)px; width:@F(r.W)px; height:@F(multiline && C.Editing?.Element.Kind == ElementKind.Comment ? r.H : 32)px"
             @onpointerdown:stopPropagation="true" @onkeydown:stopPropagation="true">
            @if (multiline)
            {
                <textarea @ref="_editor" @oninput="e => _editText = e.Value?.ToString()" @onkeydown="EditorKey" @onblur="CommitEdit" placeholder="Type a label"></textarea>
            }
            else
            {
                <input @ref="_editor" @oninput="e => _editText = e.Value?.ToString()" @onkeydown="EditorKey" @onblur="CommitEdit" placeholder="@(C.EditingEdge != null ? "Label" : "Name")" />
            }
        </div>
    }

    @if (C.QuickAddRequest is { } qa)
    {
        var hits = QuickAddItems().ToList();
        <div class="quickadd" style="left:@F(Math.Min(qa.X, C.ViewWidth - 250))px; top:@F(Math.Min(qa.Y, C.ViewHeight - 300))px"
             @onpointerdown:stopPropagation="true" @onkeydown:stopPropagation="true" @onwheel:stopPropagation="true">
            <input @ref="_quickInput" placeholder="Add shape…" value="@_quickQuery" @oninput="e => _quickQuery = e.Value?.ToString()" @onkeydown="QuickKey" />
            <div class="qa-list">
                @for (var i = 0; i < hits.Count; i++)
                {
                    var item = hits[i];
                    var idx = i;
                    <div class="qa-item @(idx == _quickIndex ? "on" : "")" @onclick="() => QuickPick(item)" @onmouseenter="() => _quickIndex = idx">
                        @Thumb(item, false)
                        <span>@item.Title</span>
                        <span class="qa-sec">@(Metamodel.GeneralItems.Contains(item) && C.Diagram.DiagramType != DiagramType.Whiteboard ? "General" : "")</span>
                    </div>
                }
                @if (hits.Count == 0) { <div class="qa-empty">No matching shapes</div> }
            </div>
        </div>
    }
</div>

<ContextMenu Entries="_dropMenu" X="_dropX" Y="_dropY" OnClose="() => _dropMenu = null" />

@code {
    [Parameter, EditorRequired] public DiagramController C { get; set; } = default!;
    [Parameter] public EventCallback<(double X, double Y, DiagramNode? Node, DiagramEdge? Edge)> OnContextMenu { get; set; }

    private ElementReference _canvas, _editor, _minimap, _quickInput;
    private DotNetObjectReference<DiagramView>? _self;
    private (double Left, double Top) _origin;
    private object? _editorShownFor;
    private string? _editText;
    private bool _shapesOpen = true;
    protected override void OnInitialized() => _shapesOpen = Ws.Preferences.ShowShapesPanel;   // Settings ▸ Diagrams
    private string? _shapeQuery;
    private PaletteItem? _paletteDrag;
    private Pt? _quickShownFor;
    private string? _quickQuery;
    private int _quickIndex;
    private long _lastDown;
    private (double X, double Y) _lastDownAt;
    private bool _skipRender;
    private DiagramController? _installedFor;
    private IReadOnlyList<Components.Workbench.MenuEntry>? _dropMenu;
    private double _dropX, _dropY;

    private string? _fmtMenu;
    private bool _layersOpen;
    private bool _connMenu;

    /// <summary>The shapes panel's "Image" tile: opens a file picker instead of creating a shape directly.</summary>
    private static readonly PaletteItem ImageItem = new(ElementKind.Shape, DiagramExtras.ImageSubtype, "Image");

    private static bool IsImageItem(PaletteItem item) => item.Kind == ElementKind.Shape && item.Subtype == DiagramExtras.ImageSubtype;

    private Task EditLink() => LinkDialog.EditAsync(Dialogs, Ws, C);

    private async Task PickImage(double? sx = null, double? sy = null)
    {
        if (C.ReadOnly) return;
        _self ??= DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("meridian.pickImage", _self, sx, sy);
    }

    /// <summary>A picture chosen, dropped or pasted in the browser (already downscaled to at most 2 MB).</summary>
    [JSInvokable]
    public Task OnImage(string data, double width, double height, double? x, double? y, string? name)
    {
        var caption = string.IsNullOrWhiteSpace(name) || name.StartsWith("image.", StringComparison.OrdinalIgnoreCase) ? null : Path.GetFileNameWithoutExtension(name);
        C.InsertImage(data, width, height, x, y, caption);
        StateHasChanged();
        return JS.InvokeVoidAsync("meridian.focus", _canvas).AsTask();
    }

    /// <summary>A Mermaid file (.mmd, .mermaid, .md) dropped on the canvas: imported into the diagram's package as one undo step.</summary>
    [JSInvokable]
    public void OnMermaidFile(string name, string text)
    {
        var options = new Meridian.Serialization.Mermaid.MermaidImportOptions { Markdown = Meridian.Serialization.Mermaid.MermaidImporter.IsMarkdownFile(name) };
        var target = C.Diagram.Owner?.AncestorsAndSelf().FirstOrDefault(a => a.Kind is ElementKind.Package or ElementKind.Model);
        MermaidImport.Apply(Ws, text, options, name, target);
        StateHasChanged();
    }

    [JSInvokable]
    public void OnImageError(string message)
    {
        Ws.SetStatus(message);
        StateHasChanged();
    }


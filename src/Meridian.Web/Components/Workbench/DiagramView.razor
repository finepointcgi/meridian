    protected override bool ShouldRender()
    {
        if (!_skipRender) return true;
        _skipRender = false;
        return false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender || !ReferenceEquals(_installedFor, C))
        {
            _self ??= DotNetObjectReference.Create(this);
            if (firstRender)
            {
                await JS.InvokeVoidAsync("meridian.installCanvas", _canvas, _self);
                await JS.InvokeVoidAsync("meridian.installCanvasExtras", _canvas, _self);
            }
            _installedFor = C;
            await RefreshOrigin();
            await JS.InvokeVoidAsync("meridian.focus", _canvas);
        }
        object? target = (object?)C.Editing ?? C.EditingEdge;
        if (target != null && !ReferenceEquals(_editorShownFor, target))
        {
            _editorShownFor = target;
            _editText = C.EditSeed ?? (C.Editing is { } n
                ? n.Element.Kind == ElementKind.Comment ? n.Element.Get(FieldKeys.Body) : n.Element.Name
                : C.EditingEdge!.Relationship.Name);
            await JS.InvokeVoidAsync("meridian.beginEdit", _editor, _canvas, C.EditSeed, _editText);
        }
        if (target == null) _editorShownFor = null;

        if (C.QuickAddRequest is { } qa && _quickShownFor != qa)
        {
            _quickShownFor = qa;
            _quickQuery = null;
            _quickIndex = 0;
            StateHasChanged();
            await Task.Yield();
            await JS.InvokeVoidAsync("meridian.select", _quickInput);
        }
        if (C.QuickAddRequest == null) _quickShownFor = null;
    }

    private async Task RefreshOrigin()
    {
        var r = await JS.InvokeAsync<RectDto?>("meridian.rect", _canvas);
        if (r == null) return;   // not laid out (prerendering, tests)
        _origin = (r.Left, r.Top);
        C.ViewWidth = r.Width;
        // Room for the shapes panel on the left, except on a phone-sized canvas, where the panel is hidden.
        C.LeftInset = r.Width < 600 ? 8 : _shapesOpen && !C.ReadOnly ? 236 : 64;
        C.ViewHeight = r.Height;
        if (C.NeedsFit && r.Width > 50) { C.InitialZoom(); StateHasChanged(); }
    }

    [JSInvokable]
    public async Task OnResize(double width, double height)
    {
        await RefreshOrigin();
        StateHasChanged();
    }

    private sealed record RectDto(double Left, double Top, double Width, double Height);

    private static Mods ModsOf(MouseEventArgs e) =>
        (e.ShiftKey ? Mods.Shift : 0) | (e.CtrlKey ? Mods.Ctrl : 0) | (e.AltKey ? Mods.Alt : 0) | (e.MetaKey ? Mods.Meta : 0);

    private void SetTool(PaletteItem? item)
    {
        C.SetTool(item);
        _ = JS.InvokeVoidAsync("meridian.focus", _canvas);
    }

    private async Task Down(PointerEventArgs e)
    {
        if (C.Editing != null || C.EditingEdge != null) CommitEdit();
        _fmtMenu = null;
        var sx = e.ClientX - _origin.Left;
        var sy = e.ClientY - _origin.Top;
        // Pointer events report detail = 0 in Chromium, so detect double-clicks from timing and distance.
        var clicks = (int)e.Detail;
        var now = Environment.TickCount64;
        if (e.Button == 0 && clicks < 2 && now - _lastDown < 450 && Math.Abs(e.ClientX - _lastDownAt.X) < 6 && Math.Abs(e.ClientY - _lastDownAt.Y) < 6) clicks = 2;
        _lastDown = clicks >= 2 || e.Button != 0 ? 0 : now;
        _lastDownAt = (e.ClientX, e.ClientY);
        var menu = C.PointerDown(sx, sy, (int)e.Button, ModsOf(e), clicks);
        if (C.DrillRequest is { } drill)
        {
            C.DrillRequest = null;
            Ws.DrillDown(drill);
            return;
        }
        if (C.LinkRequest is { } link)
        {
            C.LinkRequest = null;
            await FollowLink(link);
            return;
        }
        if (menu)
        {
            var node = C.HitNode(C.PressModel);
            var edge = node == null ? C.HitEdge(C.PressModel) : null;
            await OnContextMenu.InvokeAsync((e.ClientX, e.ClientY, node, edge));
        }
    }

    private void Move(PointerEventArgs e)
    {
        if (!C.PointerMove(e.ClientX - _origin.Left, e.ClientY - _origin.Top, ModsOf(e))) _skipRender = true;
    }

    private void Up(PointerEventArgs e) => C.PointerUp(ModsOf(e));

    private void Leave(PointerEventArgs e)
    {
        if (C.Current == DiagramController.Gesture.None && C.Hover != null) C.PointerMove(-10000, -10000);
        else _skipRender = true;
    }

    private void KeyUp(KeyboardEventArgs e)
    {
        if (e.Key == " " && C.SpaceHeld) C.SpaceHeld = false;
        else _skipRender = true;
    }


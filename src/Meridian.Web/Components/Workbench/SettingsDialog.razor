    private bool _desktopAutoOpen, _desktopUpdates = true, _desktopCrashPrompt = true;
    private int _desktopRecent, _desktopCrashes;
    // Updates: what the desktop host reported (Program.DesktopState / update-status messages).
    private string? _dVersion, _dLastCheck, _dMessage, _dStatus, _dAvailable, _dManifestUrl;
    private string _dSource = "GitHub", _dDraftSource = "GitHub", _dDraftUrl = "", _dGitLabUrl = "", _dGitLabProject = "", _dDraftGitLabUrl = "", _dDraftGitLabProject = "";
    private bool _dHasToken, _dHasGitLabToken, _dChecksDisabled, _dChecking, _dInstalling;
    private int? _dProgress;
    private DotNetObjectReference<SettingsDialog>? _dotnet;

    /// <summary>The desktop host's settings (the GitHub token is never part of it, only whether one is saved).</summary>
    public sealed record DesktopState(bool AutoOpen, bool CheckForUpdates, int RecentFiles, string? Version = null, string? LastCheck = null,
        string? LastMessage = null, string? LastStatus = null, string? Available = null, string? UpdateSource = null, string? ManifestUrl = null,
        bool HasToken = false, bool ChecksDisabled = false, string? GitLabUrl = null, string? GitLabProject = null, bool HasGitLabToken = false,
        bool CrashPrompt = true, int PendingCrashes = 0);

    private async Task LoadDesktopAsync()
    {
        try
        {
            _dotnet ??= DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("meridianSettings.desktopListen", _dotnet);
            if (await JS.InvokeAsync<DesktopState?>("meridianSettings.desktopSettings") is { } d)
            {
                ApplyDesktopState(d);
                StateHasChanged();
            }
        }
        catch (Exception e) when (e is JSException or InvalidOperationException or TaskCanceledException) { }
    }

    private void ApplyDesktopState(DesktopState d)
    {
        (_desktopAutoOpen, _desktopUpdates, _desktopRecent) = (d.AutoOpen, d.CheckForUpdates, d.RecentFiles);
        (_desktopCrashPrompt, _desktopCrashes) = (d.CrashPrompt, d.PendingCrashes);
        _dVersion = d.Version;
        _dLastCheck = d.LastCheck;
        _dMessage ??= d.LastMessage;
        _dStatus ??= d.LastStatus;
        _dAvailable = d.Available;
        _dSource = _dDraftSource = d.UpdateSource ?? "GitHub";
        _dManifestUrl = d.ManifestUrl;
        _dDraftUrl = d.ManifestUrl ?? "";
        _dHasToken = d.HasToken;
        _dGitLabUrl = _dDraftGitLabUrl = d.GitLabUrl ?? "";
        _dGitLabProject = _dDraftGitLabProject = d.GitLabProject ?? "";
        _dHasGitLabToken = d.HasGitLabToken;
        _dChecksDisabled = d.ChecksDisabled;
    }

    /// <summary>Messages from the desktop host: check results, download progress, errors and refreshed settings.</summary>
    [JSInvokable]
    public Task OnDesktopMessage(string raw)
    {
        System.Text.Json.Nodes.JsonObject? m;
        try { m = System.Text.Json.Nodes.JsonNode.Parse(raw) as System.Text.Json.Nodes.JsonObject; }
        catch (System.Text.Json.JsonException) { return Task.CompletedTask; }
        if (m is null) return Task.CompletedTask;
        switch ((string?)m["type"])
        {
            case "desktop-settings":
                var state = System.Text.Json.JsonSerializer.Deserialize<DesktopState>(m, System.Text.Json.JsonSerializerOptions.Web);
                if (state != null) { var (msg, st) = (_dMessage, _dStatus); ApplyDesktopState(state); (_dMessage, _dStatus) = (msg ?? state.LastMessage, st ?? state.LastStatus); }
                break;
            case "update-status":
                _dStatus = (string?)m["status"];
                _dMessage = (string?)m["message"];
                _dChecking = _dStatus == "checking";
                if (_dStatus is "failed" or "manual") { _dInstalling = false; _dProgress = null; }
                if ((string?)m["lastCheck"] is { } lc) _dLastCheck = lc;
                if (m.ContainsKey("available")) _dAvailable = (string?)m["available"];
                break;
            case "update":
                _dAvailable = (string?)m["version"];
                break;
            case "update-progress":
                _dInstalling = true;
                _dProgress = (int?)m["percent"];
                break;
            case "update-error":
                _dInstalling = false;
                _dProgress = null;
                (_dStatus, _dMessage) = ("failed", (string?)m["message"]);
                break;
            default:
                return Task.CompletedTask;
        }
        return InvokeAsync(StateHasChanged);
    }

    private void DesktopCommand(string command, object? payload = null) =>
        _ = JS.InvokeVoidAsync("meridianSettings.desktop", command, payload).AsTask().ContinueWith(_ => { });

    private void CheckNow()
    {
        _dChecking = true;
        (_dStatus, _dMessage) = ("checking", "Checking for updates…");
        DesktopCommand("checkUpdates");
    }

    private void InstallNow()
    {
        _dInstalling = true;
        _dProgress = 0;
        (_dStatus, _dMessage) = ("installing", $"Downloading Meridian {_dAvailable}…");
        DesktopCommand("update");
    }

    private void SaveSource()
    {
        if (_dDraftSource == "Manifest") DesktopCommand("updateSource", new { source = "Manifest", url = _dDraftUrl.Trim() });
        else if (_dDraftSource == "GitLab") DesktopCommand("updateSource", new { source = "GitLab", url = _dDraftGitLabUrl.Trim(), project = _dDraftGitLabProject.Trim() });
        else DesktopCommand("updateSource", new { source = _dDraftSource });
    }

    /// <summary>The token goes from the input straight to the desktop host in JavaScript: it never passes through this component or the server.</summary>
    private async Task SaveToken()
    {
        try
        {
            if (await JS.InvokeAsync<bool>("meridianSettings.desktopSaveToken", "desktop-token")) (_dStatus, _dMessage) = ("saving", "Saving the token…");
        }
        catch (Exception e) when (e is JSException or InvalidOperationException or TaskCanceledException) { }
    }

    private void RemoveToken() => DesktopCommand("updateToken", new { token = "" });

    /// <summary>Like <see cref="SaveToken"/>, for the GitLab token (sent only to the configured GitLab instance).</summary>
    private async Task SaveGitLabToken()
    {
        try
        {
            if (await JS.InvokeAsync<bool>("meridianSettings.desktopSaveToken", "desktop-gitlab-token", "GitLab")) (_dStatus, _dMessage) = ("saving", "Saving the token…");
        }
        catch (Exception e) when (e is JSException or InvalidOperationException or TaskCanceledException) { }
    }

    private void RemoveGitLabToken() => DesktopCommand("updateToken", new { token = "", provider = "GitLab" });

    private bool SourceUnchanged => _dDraftSource == _dSource && _dDraftSource switch
    {
        "Manifest" => _dDraftUrl.Trim() == (_dManifestUrl ?? ""),
        "GitLab" => _dDraftGitLabUrl.Trim().TrimEnd('/') == _dGitLabUrl && _dDraftGitLabProject.Trim().Trim('/') == _dGitLabProject,
        _ => true,
    };

    private string LastCheckText()
    {
        if (_dLastCheck is null || !DateTimeOffset.TryParse(_dLastCheck, System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.RoundtripKind, out var at)) return "Never checked.";
        var ago = DateTimeOffset.Now - at;
        var when = ago.TotalMinutes < 1 ? "just now" : ago.TotalHours < 1 ? $"{(int)ago.TotalMinutes} min ago" : ago.TotalDays < 1 ? $"{(int)ago.TotalHours} h ago" : at.ToLocalTime().ToString("d MMM yyyy, HH:mm", System.Globalization.CultureInfo.InvariantCulture);
        return $"Last checked {when}.";
    }


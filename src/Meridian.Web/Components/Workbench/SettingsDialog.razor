            {
                <div class="settings-hint">Releases of a GitLab project on gitlab.com or your own GitLab. Leave the address empty for gitlab.com.</div>
                <input class="settings-input desktop-gitlab-url" type="url" aria-label="GitLab address" placeholder="https://gitlab.com"
                       value="@_dDraftGitLabUrl" @oninput="e => _dDraftGitLabUrl = e.Value?.ToString() ?? string.Empty" />
                <input class="settings-input desktop-gitlab-project" type="text" aria-label="GitLab project" placeholder="my-group/meridian or 12345"
                       value="@_dDraftGitLabProject" @oninput="e => _dDraftGitLabProject = e.Value?.ToString() ?? string.Empty" />
                <div class="settings-hint">For a private project: a personal or project access token with read_api. Stored encrypted on this computer and sent only to that GitLab address.</div>
                <div class="settings-inline">
                    @* Not bound: the token is read by meridianSettings.desktopSaveToken and sent straight to the desktop app. *@
                    <input id="desktop-gitlab-token" class="settings-input desktop-gitlab-token" type="password" autocomplete="off" aria-label="GitLab token"
                           placeholder="@(_dHasGitLabToken ? "A token is saved (paste to replace)" : "glpat-… (optional)")" />
                    <button class="settings-btn desktop-gitlab-token-save" @onclick="SaveGitLabToken">Save token</button>
                    @if (_dHasGitLabToken) { <button class="settings-btn danger desktop-gitlab-token-remove" @onclick="RemoveGitLabToken">Remove</button> }
                </div>
            }
            else
            {
                <div class="settings-hint">An https:// address of an update manifest, for example your Meridian server's /api/desktop/latest.</div>
                <input class="settings-input desktop-manifest-url" type="url" aria-label="Update manifest address" placeholder="https://meridian.example.com/api/desktop/latest"
                       value="@_dDraftUrl" @oninput="e => _dDraftUrl = e.Value?.ToString() ?? string.Empty" />
            }
            @if (_dDraftSource != "GitHubToken" || _dSource != "GitHubToken")
            {
                <button class="settings-btn desktop-source-save" disabled="@SourceUnchanged" @onclick="SaveSource">Use this source</button>
            }
        </div>
    };

    private void Bridge(string command, bool enabled) =>
        _ = JS.InvokeVoidAsync("meridianSettings.desktop", command, new { enabled }).AsTask().ContinueWith(_ => { });

    private void ClearRecentFiles()
    {
        _ = JS.InvokeVoidAsync("meridianSettings.desktop", "clearRecent", null).AsTask().ContinueWith(_ => { });
        _desktopRecent = 0;
    }

    private void ReportCrash()
    {
        DesktopCommand("reportProblem");
        _desktopCrashes = 0;
    }

    private RenderFragment CrashFiles => __builder =>
    {
        <div class="settings-local desktop-crashes">
            @if (_desktopCrashes > 0)
            {
                <button class="settings-btn primary desktop-crash-report" @onclick="ReportCrash" title="Opens a prefilled GitHub issue in your browser to review before submitting">Report the latest crash…</button>
            }
            <button class="settings-btn desktop-crash-folder" @onclick="@(() => DesktopCommand("openCrashFolder"))">Show crash files</button>
        </div>
    };

    private RenderFragment ClearRecent => __builder =>
    {
        <button class="settings-btn" disabled="@(_desktopRecent == 0)" @onclick="ClearRecentFiles">Clear recent files</button>
    };
}

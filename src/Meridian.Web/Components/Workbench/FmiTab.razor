@using Meridian.Serialization
@inherits WorkspaceComponent
@inject IServiceProvider Services

<div class="d-flex align-center gap-2 px-3 py-2 flex-wrap">
    <label class="mud-button-root mud-button mud-button-outlined mud-button-outlined-size-small" style="cursor:pointer; padding:3px 10px; @(Ws.ReadOnly ? "opacity:.5; pointer-events:none" : "")">
        <InputFile accept=".fmu,.xml" OnChange="OnFile" style="display:none" />
        Choose FMU or modelDescription.xml…
    </label>
    @if (_md != null)
    {
        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Input" Disabled="Ws.ReadOnly" OnClick="Import">
            Import as block into @(Target.DisplayName)
        </MudButton>
    }
</div>
@if (_error != null) { <div class="var-problem" style="margin:0 14px">⚠ @_error</div> }
@if (_md is { } md)
{
    <div class="px-3" style="font-size:12.5px">
        <b>@md.ModelName</b> · FMI @md.FmiVersion · @(md.CoSimulation ? "Co-Simulation" : "") @(md.ModelExchange ? "Model Exchange" : "")
        @if (md.Binaries.Count > 0) { <span style="color:var(--text-3)"> · binaries: @string.Join(", ", md.Binaries.Select(System.IO.Path.GetDirectoryName).Distinct())</span> }
    </div>
    <table class="req-table" style="margin:6px 12px 8px; width:calc(100% - 24px)">
        <thead><tr><th>Variable</th><th>Causality</th><th>Type</th><th>Unit</th><th>Start</th><th>Becomes</th></tr></thead>
        <tbody>
            @foreach (var v in md.Variables)
            {
                <tr>
                    <td>@v.Name</td><td>@v.Causality</td><td>@v.Type</td><td>@v.Unit</td><td>@v.Start</td>
                    <td style="color:var(--text-3)">@(v.Causality switch { "input" => "in port", "output" => "out port", "independent" => "—", _ when v.Name.StartsWith("der(") => "—", _ => "value property" })</td>
                </tr>
            }
        </tbody>
    </table>
}
<div class="var-hint">
    Imports an FMU's interface (FMI 2.0 or 3.0 <code>modelDescription.xml</code>): inputs and outputs become in / out proxy ports, parameters
    and locals become value properties with their start values, and units are kept, so the block can type parts and be wired in internal
    block diagrams. Importing never runs the FMU's code. To simulate, type parts of a system block with the imported block, connect
    their ports in an internal block diagram and use the <b>Co-simulation</b> tab@(Settings.Enabled ? "" : " (running FMUs is turned off on this server)").
    @if (Settings.Enabled) { <text>The .fmu file is kept with the server's FMU store so the co-simulation can run it later.</text> }
</div>

@code {
    private FmiModelDescription? _md;
    private byte[]? _fmuBytes;
    private string? _fileName;
    private FmiCoSimSettings? _settings;
    private FmiCoSimSettings Settings => _settings ??= FmiCoSimSettings.From(Services.GetService<IConfiguration>(), Services.GetService<MeridianHostInfo>());
    private string? _error;

    private Element Target => Ws.Selected?.AncestorsAndSelf().FirstOrDefault(a => a.Kind is ElementKind.Package or ElementKind.Model) ?? Ws.Model.Root;

    private async Task OnFile(InputFileChangeEventArgs e)
    {
        _error = null; _md = null; _fmuBytes = null;
        try
        {
            await using var s = e.File.OpenReadStream(200 * 1024 * 1024);
            using var ms = new MemoryStream();
            await s.CopyToAsync(ms);
            ms.Position = 0;
            _md = FmiImport.Read(ms);
            _fmuBytes = _md.Binaries.Count > 0 ? ms.ToArray() : null;   // a complete .fmu (not just modelDescription.xml)
            _fileName = e.File.Name;
        }
        catch (Exception ex) when (ex is FormatException or IOException or System.Xml.XmlException or InvalidDataException)
        {
            _error = $"Could not read {e.File.Name}: {FriendlyError.Describe(ex)}. Choose an .fmu file or its modelDescription.xml.";
        }
    }

    private void Import()
    {
        if (_md == null) return;
        try
        {
            // Keep the .fmu (content-addressed) so the Co-simulation tab can run it; only where running FMUs is enabled.
            var hash = _fmuBytes != null && Settings.Enabled ? Settings.Store.Save(_fmuBytes) : null;
            var block = FmiImport.CreateBlock(Ws.Model, Target, _md, _fileName, hash);
            Ws.Select(block);
            Ws.SetStatus($"Imported FMU '{_md.ModelName}' as block {block.Name}" + (hash != null ? " (FMU stored for co-simulation)" : " (interface only)"));
        }
        catch (Exception ex) when (ex is InvalidOperationException or IOException or UnauthorizedAccessException) { _error = $"Could not import the FMU: {FriendlyError.Describe(ex)}."; }
    }
}

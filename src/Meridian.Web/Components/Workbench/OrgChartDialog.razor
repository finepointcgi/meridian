@* Project menu ▸ Import ▸ "Org chart from spreadsheet…" and ⌘K: choose an .xlsx / .csv (or paste cells), see the
   columns found, how many people and what could not be resolved, then draw the chart (Workbench.OrgChart.cs). *@
@using Meridian.Core.Model
@using Meridian.Serialization.Spreadsheets
@using Microsoft.AspNetCore.Components.Forms
@inject Workspace Ws

<MudDialog Class="orgchart-dialog">
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Outlined.AccountTree" />
            <MudText Typo="Typo.h6">Org chart from spreadsheet</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <div style="display:flex; flex-direction:column; gap:10px; font-size:13px">
            <MudText Typo="Typo.body2" Style="color:var(--text-2)">
                One row per person, with columns such as <b>Name</b>, <b>Title</b>, <b>Manager</b> (or <i>Reports to</i>, a name or an id),
                and optionally <b>Id</b>, <b>Department</b> and <b>Email</b>. The chart goes into <b>@Target.DisplayName</b>.
            </MudText>
            <div class="d-flex align-center gap-3" style="flex-wrap:wrap">
                <label class="oc-file mud-button-root mud-button mud-button-outlined" style="padding:4px 12px; border-radius:6px; cursor:pointer; position:relative; overflow:hidden">
                    <MudIcon Icon="@Icons.Material.Outlined.UploadFile" Style="font-size:16px; vertical-align:middle" />
                    <span>Choose .xlsx / .csv…</span>
                    <InputFile accept=".xlsx,.xlsm,.csv,.tsv,.txt" OnChange="OnFile" data-testid="oc-file" style="position:absolute; inset:0; opacity:0; cursor:pointer" />
                </label>
                <span style="color:var(--text-3)">@(_fileName.Length > 0 ? _fileName : "or paste cells copied from Excel")</span>
            </div>
            <textarea class="oc-paste" rows="3" placeholder="Paste cells here (tab separated, as Excel copies them)" @bind="_paste" @bind:event="oninput"
                      style="width:100%; font-family:var(--mono, ui-monospace, monospace); font-size:12px"></textarea>
            @if (_paste.Length > 0)
            {
                <div><MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="ReadPaste" Class="oc-read-paste">Read pasted cells</MudButton></div>
            }
            @if (_error != null)
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="oc-error">@_error</MudAlert>
            }
            @if (_book is { Sheets.Count: > 1 })
            {
                <label>Sheet
                    <select class="oc-sheet" value="@_sheet" @onchange="e => { _sheet = int.Parse((string)e.Value!); Parse(); }">
                        @for (var i = 0; i < _book.Sheets.Count; i++) { <option value="@i">@_book.Sheets[i].Name</option> }
                    </select>
                </label>
            }
            @if (_result is { } r)
            {
                <div class="oc-summary" style="display:flex; gap:16px; flex-wrap:wrap">
                    <span><b class="oc-people">@r.Tree.People.Count</b> @(r.Tree.People.Count == 1 ? "person" : "people")</span>
                    <span><b>@r.Tree.Roots.Count</b> at the top</span>
                    <span><b>@r.Tree.ManagerOf.Count</b> reporting lines</span>
                    @if (r.Warnings.Count > 0) { <span style="color:var(--warning, #b26a00)"><b class="oc-warning-count">@r.Warnings.Count</b> warning@(r.Warnings.Count == 1 ? "" : "s")</span> }
                </div>
                <div class="oc-columns" style="display:grid; grid-template-columns:auto 1fr; gap:2px 12px">
                    @foreach (var c in new[] { OrgColumn.Name, OrgColumn.FirstName, OrgColumn.LastName, OrgColumn.Title, OrgColumn.Manager, OrgColumn.Id, OrgColumn.Department, OrgColumn.Email, OrgColumn.Photo })
                    {
                        var header = r.HeaderOf(c);
                        if (header == null && c is OrgColumn.FirstName or OrgColumn.LastName or OrgColumn.Photo) continue;
                        <span style="color:var(--text-3)">@Label(c)</span>
                        <span class="oc-col" data-col="@c">@(header == null ? "—" : $"“{header}”")@(c == OrgColumn.Photo ? " (ignored)" : "")</span>
                    }
                </div>
                @if (r.Warnings.Count > 0)
                {
                    <div class="oc-warnings" style="max-height:20vh; overflow:auto; border:1px solid var(--border); border-radius:6px; padding:6px 10px; font-size:12px; color:var(--text-2)">
                        @foreach (var w in r.Warnings.Take(50)) { <div>@w</div> }
                        @if (r.Warnings.Count > 50) { <div>… and @(r.Warnings.Count - 50) more</div> }
                    </div>
                }
                <label>Diagram name <input class="oc-name" value="@_name" @onchange="e => _name = e.Value?.ToString() ?? _name" style="width:260px" /></label>
                @if (_previous != null)
                {
                    <div class="oc-again" style="color:var(--text-2)">This file was imported before: <b>@_previous.Name</b> is updated in place (cards matched by id or name).</div>
                }
            }
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => MudDialog.Cancel()">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="oc-import" Disabled="@(Ws.ReadOnly || _result is not { Tree.People.Count: > 0 })" OnClick="Import">
            @(_previous != null ? "Update org chart" : "Create org chart")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public Element Target { get; set; } = default!;
    [Parameter] public string FileName { get; set; } = "";
    [Parameter] public byte[]? Bytes { get; set; }

    /// <summary>What the dialog returns: the people read and where they came from.</summary>
    public sealed record Choice(OrgSheet Sheet, string Name, string? Source);

    private string _fileName = "";
    private string _paste = "";
    private string _name = "Org chart";
    private string? _error;
    private SheetBook? _book;
    private int _sheet;
    private OrgSheet? _result;
    private Diagram? _previous;

    protected override void OnInitialized()
    {
        _fileName = FileName;
        if (Bytes != null) Read(Bytes);
    }

    private static string Label(OrgColumn c) => c switch
    {
        OrgColumn.FirstName => "First name",
        OrgColumn.LastName => "Last name",
        OrgColumn.Id => "Id",
        OrgColumn.Photo => "Photo",
        _ => c.ToString(),
    };

    private async Task OnFile(InputFileChangeEventArgs e)
    {
        _error = null;
        try
        {
            await using var s = e.File.OpenReadStream(SheetLimits.MaxFileBytes);
            using var ms = new MemoryStream();
            await s.CopyToAsync(ms);
            _fileName = e.File.Name;
            _paste = "";
            Read(ms.ToArray());
        }
        catch (IOException ex) { _error = $"Could not read {e.File.Name}: {FriendlyError.Describe(ex)}"; }
    }

    private void Read(byte[] bytes)
    {
        _error = null;
        try
        {
            _book = SheetReader.Read(_fileName.Length > 0 ? _fileName : "sheet.csv", new MemoryStream(bytes));
            _sheet = 0;
            _name = Path.GetFileNameWithoutExtension(_fileName) is { Length: > 0 } stem ? stem : "Org chart";
            Parse();
        }
        catch (Exception ex) when (ex is FormatException or InvalidDataException or System.Xml.XmlException or IOException or ArgumentException)
        {
            _book = null;
            _result = null;
            _error = $"Could not read {_fileName}: {FriendlyError.Describe(ex)}";
        }
    }

    private void ReadPaste()
    {
        _error = null;
        try
        {
            _book = SheetReader.ReadText(_paste);
            _fileName = "";
            _sheet = 0;
            Parse();
        }
        catch (FormatException ex) { _error = ex.Message; }
    }

    private void Parse()
    {
        if (_book == null || _book.Sheets.Count == 0) { _result = null; return; }
        _result = OrgChartSheet.Read(_book.Sheets[Math.Clamp(_sheet, 0, _book.Sheets.Count - 1)], warnings: _book.Warnings);
        _previous = Source is { } src ? OrgChart.FindImported(Ws.Model, Target, src) : null;
        if (_previous != null) _name = _previous.Name;
    }

    /// <summary>Re-imports are recognised by file name (and sheet, for workbooks with several).</summary>
    private string? Source => _fileName.Length == 0 ? null : _book is { Sheets.Count: > 1 } b ? $"{_fileName}#{b.Sheets[_sheet].Name}" : _fileName;

    private void Import()
    {
        if (_result is not { Tree.People.Count: > 0 } r) return;
        MudDialog.Close(DialogResult.Ok(new Choice(r, _name, Source)));
    }

    /// <summary>Shows the dialog; returns the people to draw, or null when cancelled.</summary>
    public static async Task<Choice?> ShowAsync(IDialogService dialogs, Element target, string? fileName = null, byte[]? bytes = null)
    {
        var parameters = new DialogParameters<OrgChartDialog> { { x => x.Target, target }, { x => x.FileName, fileName ?? "" }, { x => x.Bytes, bytes } };
        var dialog = await dialogs.ShowAsync<OrgChartDialog>("Org chart from spreadsheet", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true, BackdropClick = false });
        var result = await dialog.Result;
        return result is { Canceled: false, Data: Choice c } ? c : null;
    }
}

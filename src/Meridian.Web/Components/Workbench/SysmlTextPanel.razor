@using Meridian.Serialization
@using Meridian.Core.Collaboration
@using System.Text.Json
@inherits WorkspaceComponent
@implements IAsyncDisposable

<link rel="stylesheet" href="css/sysml-editor.css" />
<div class="sx-panel @(State.Expanded ? "expanded" : "")">
    <div class="sx-bar">
        <span class="title"><MudIcon Icon="@Icons.Material.Outlined.Code" />SysML v2</span>
        <MudMenu AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" Dense="true">
            <ActivatorContent>
                <span class="sx-scope" title="@Scope.QualifiedName">
                    <MudIcon Icon="@(Scope.Kind == ElementKind.Model ? Icons.Material.Outlined.Public : Icons.Material.Outlined.Folder)" />
                    <span>@(Scope.Kind == ElementKind.Model ? "Whole model" : Scope.DisplayName)</span>
                    <MudIcon Icon="@Icons.Material.Filled.ExpandMore" />
                </span>
            </ActivatorContent>
            <ChildContent>
                <MudMenuItem Icon="@Icons.Material.Outlined.Public" OnClick="() => SwitchScope(Ws.Model.Root)">Whole model</MudMenuItem>
                @if (SelectionPackage() is { } sp && !ReferenceEquals(sp, Scope))
                {
                    <MudMenuItem Icon="@Icons.Material.Outlined.Folder" OnClick="() => SwitchScope(sp)">Package of selection: @sp.DisplayName</MudMenuItem>
                }
            </ChildContent>
        </MudMenu>
        <span class="sx-state @(_errors > 0 ? "bad" : State.Dirty ? "dirty" : "")">
            <span class="dot"></span>@(State.Dirty ? "Modified — not applied" : "In sync with the model")
        </span>
        @if (_errors > 0) { <span class="sx-chip">@_errors error@(_errors == 1 ? "" : "s")</span> }
        @if (_warnings > 0) { <span class="sx-chip warn">@_warnings warning@(_warnings == 1 ? "" : "s")</span> }
        @if (_remote.Count > 0)
        {
            <span class="sx-people" title="Also editing this text">
                @foreach (var c in _remote)
                {
                    <span class="sx-person" style="background:@SafeColor(c.Color)" title="@c.Name">@Initials(c.Name)</span>
                }
            </span>
        }
        <span style="flex:1"></span>
        <MudTooltip Text="Write element ids as /* @@id */ comments so renames and moves keep identity, diagrams and links">
            <label class="sx-toggle"><input type="checkbox" checked="@State.ShowIds" @onchange="ToggleIds" /> Ids</label>
        </MudTooltip>
        <MudTooltip Text="@(Shared ? "Discard everyone's unapplied edits and reload the text from the model" : "Discard edits and reload the text from the model")">
            <button class="sx-btn" @onclick="Reload" disabled="@(!State.Dirty && !State.Stale)"><MudIcon Icon="@Icons.Material.Outlined.Refresh" />Reload</button>
        </MudTooltip>
        <MudTooltip Text="Parse and apply the changes to the model (one undo step)">
            <button class="sx-btn primary" @onclick="ApplyClicked" disabled="@(Ws.ReadOnly || !State.Dirty)"><MudIcon Icon="@Icons.Material.Outlined.Check" />Apply <kbd>@(_mac ? "⌘↵" : "Ctrl+↵")</kbd></button>
        </MudTooltip>
        <MudTooltip Text="@(State.Expanded ? "Back to the dock" : "Full editor")">
            <MudIconButton Size="Size.Small" Icon="@(State.Expanded ? Icons.Material.Outlined.CloseFullscreen : Icons.Material.Outlined.OpenInFull)" OnClick="() => State.Expanded = !State.Expanded" aria-label="@(State.Expanded ? "Back to the dock" : "Full editor")" />
        </MudTooltip>
    </div>
    @if (State.Stale && State.Dirty)
    {
        <div class="sx-notice">
            <MudIcon Icon="@Icons.Material.Outlined.Sync" />
            <span>The model changed @(Shared ? "where this text has unapplied edits" : "since you started editing"). Applying now overwrites those changes within this scope.</span>
            <a @onclick="Reload">Reload</a>
            <a @onclick="KeepEditing" style="color:var(--text-3)">Keep editing</a>
        </div>
    }
    @if (Ws.ReadOnly)
    {
        <div class="sx-notice"><MudIcon Icon="@Icons.Material.Outlined.Visibility" /><span>View only — you can read but not apply text edits.</span></div>
    }
    <div class="sx-editor" @ref="_host"></div>
    @if (_problems.Count > 0)
    {
        <div class="sx-problems">
            @foreach (var d in _problems.Take(200))
            {
                var diag = d;
                <div class="sx-problem" @onclick="() => GoTo(diag)">
                    <MudIcon Icon="@(diag.IsError ? Icons.Material.Filled.Error : diag.Severity == SysmlSeverity.Warning ? Icons.Material.Filled.Warning : Icons.Material.Outlined.Info)"
                             Style="@($"color:{(diag.IsError ? "var(--danger)" : diag.Severity == SysmlSeverity.Warning ? "var(--warn)" : "var(--accent)")}")" />
                    <span class="pos">Ln @diag.Span.Line, Col @diag.Span.Column</span>
                    <span>@diag.Message</span>
                </div>
            }
        </div>
    }
    @if (_summary != null)
    {
        <div class="sx-summary" title="@_summaryDetail">@_summary</div>
    }
</div>

@code {
    /// <summary>Editor state that outlives the panel (the dock destroys inactive panels); owned by the workbench.</summary>
    public sealed class EditorState
    {
        public string? ScopeId { get; set; }
        public string Text { get; set; } = "";
        public string Baseline { get; set; } = "";
        public bool ShowIds { get; set; } = true;
        public bool Stale { get; set; }
        public bool Expanded { get; set; }
        /// <summary>For a shared (collaborative) text, whether anyone has unapplied edits — as the server says.</summary>
        public bool? SharedDirty { get; set; }
        public bool Dirty => SharedDirty ?? Text != Baseline;
        internal ModelRepository? Model { get; set; }
        internal int Request { get; private set; }
        internal int Handled { get; set; }
        internal string? RequestedScopeId { get; private set; }

        /// <summary>Asks the panel to show this package (or the whole model when null).</summary>
        public void RequestScope(Element? scope)
        {
            RequestedScopeId = scope?.Id;
            Request++;
        }
    }

    /// <summary>The text and its server revision, once the browser has no edits in flight.</summary>
    public sealed record SyncedText(string Text, int Revision);

    [Parameter, EditorRequired] public EditorState State { get; set; } = default!;
    [Inject] private IJSRuntime JS { get; set; } = default!;
    [Inject] private IDialogService Dialogs { get; set; } = default!;

    private ElementReference _host;
    private IJSObjectReference? _mod;
    private DotNetObjectReference<SysmlTextPanel>? _self;
    private ModelRepository? _model;
    private SysmlDocument? _doc;
    private List<SysmlDiagnostic> _problems = new();
    private int _errors, _warnings;
    private string? _summary, _summaryDetail;
    private bool _applying, _refreshQueued, _mac = true;
    private Element? _lastSelected;

    // collaborative mode: the text is a shared document of the project session (ProjectSession.SharedText.cs)
    private ProjectSession? _session;
    private string? _textKey;
    private int _openRevision;
    private SharedTextEvents? _client;
    private bool _jsReady, _holdForReset;
    private readonly List<Action> _beforeJs = new();
    private IReadOnlyList<TextCursor> _remote = [];
    private bool Shared => _textKey != null && _session != null;

    private Element Scope => State.ScopeId != null && Ws.Model.Find(State.ScopeId) is { } s ? s : Ws.Model.Root;

    private Element? SelectionPackage() =>
        Ws.Selected?.AncestorsAndSelf().FirstOrDefault(a => a.Kind is ElementKind.Package or ElementKind.Model);

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Attach();
        _lastSelected = Ws.Selected;
        if (State.Request != State.Handled && (!State.Dirty || Ws.Session != null))
        {   // opened through "Edit as SysML v2 text": take the requested scope
            State.ScopeId = State.RequestedScopeId is { } rid && Ws.Model.Find(rid) is { Kind: not ElementKind.Model } rs ? rs.Id : null;
            State.Model = null;
        }
        State.Handled = State.Request;
        if (State.ScopeId != null && Ws.Model.Find(State.ScopeId) == null) State.ScopeId = null;
        if (Ws.Session != null && !Ws.HasHiddenPackages)   // with hidden packages the text is my own, from my filtered model
        {
            OpenShared();
            Reparse();
            return;
        }
        State.SharedDirty = null;
        // Fresh baseline if nothing is being edited; otherwise keep the buffer and flag a changed model.
        var fresh = ExportScope();
        if (!ReferenceEquals(State.Model, Ws.Model) || !State.Dirty || State.ScopeId != null && Ws.Model.Find(State.ScopeId) == null) Load(fresh);
        else if (fresh != State.Baseline) State.Stale = true;
        Reparse();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (State.Request != State.Handled)
        {
            State.Handled = State.Request;
            var target = State.RequestedScopeId is { } id ? Ws.Model.Find(id) ?? Ws.Model.Root : Ws.Model.Root;
            await SwitchScope(target);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            _mod = await JS.InvokeAsync<IJSObjectReference>("import", "./js/sysml-editor.js");
            _self = DotNetObjectReference.Create(this);
            _mac = await _mod.InvokeAsync<bool>("isMac");
            await _mod.InvokeVoidAsync("create", _host, _self, State.Text, Ws.ReadOnly, Shared ? new { revision = _openRevision } : null);
            _jsReady = true;
            _holdForReset = false;
            FlushToEditor();   // shared-text events that arrived before the editor existed, in order
            await PushDiagnostics();
            if (Ws.Selected != null) await RevealElement(Ws.Selected, focus: false);
            StateHasChanged();
        }
        catch (JSException) { }
        catch (InvalidOperationException) { }   // prerendering / tests without a JS runtime
    }

    // ------------------------------------------------------------------ model <-> text

    private void Attach()
    {
        if (ReferenceEquals(_model, Ws.Model)) return;
        if (_model != null) _model.Changed -= OnModelChanged;
        _model = Ws.Model;
        _model.Changed += OnModelChanged;
    }

    private string ExportScope() =>
        SysMLv2Text.Export(Ws.Model, new SysMLv2ExportOptions { Scope = Scope, EmitIds = State.ShowIds }).Replace("\r\n", "\n");

    private void Load(string text)
    {
        State.Model = Ws.Model;
        State.Text = State.Baseline = text;
        State.Stale = false;
    }

    private void OnModelChanged(object? sender, ModelChange change)
    {
        // A shared text follows the model on the server (it knows whether anyone has unapplied edits).
        if (Shared || _applying || change.Kind == ChangeKind.DiagramChanged || _refreshQueued) return;
        _refreshQueued = true;
        _ = InvokeAsync(async () =>
        {
            await Task.Delay(250);
            _refreshQueued = false;
            await RefreshFromModel();
        });
    }

    private async Task RefreshFromModel()
    {
        if (Shared) return;
        var fresh = ExportScope();
        if (fresh == State.Baseline) return;
        if (!State.Dirty)
        {
            Load(fresh);
            Reparse();
            await PushText(keepView: true);
        }
        else State.Stale = true;
        StateHasChanged();
    }

    protected override void OnWorkspaceChanged()
    {
        if (!ReferenceEquals(_model, Ws.Model))
        {
            var sameSession = Shared && ReferenceEquals(_session, Ws.Session);
            Attach();
            if (!sameSession)
            {   // another project (or branch) was opened
                CloseShared();
                State.ScopeId = null;
                if (Ws.Session != null && !Ws.HasHiddenPackages)
                {
                    OpenShared();
                    Reparse();
                    _ = InvokeAsync(ResetEditor);
                }
                else
                {
                    State.SharedDirty = null;
                    Load(ExportScope());
                    Reparse();
                    _ = InvokeAsync(() => PushText(keepView: false));
                }
            }
        }
        if (!ReferenceEquals(_lastSelected, Ws.Selected))
        {
            _lastSelected = Ws.Selected;
            if (Ws.Selected is { } sel) _ = InvokeAsync(() => RevealElement(sel, focus: false));
        }
    }

    private void Reparse()
    {
        _doc = SysMLv2Parser.Parse(State.Text);
        _problems = _doc.Diagnostics.OrderBy(d => d.Span.Start).ToList();
        Count();
    }

    private void Count()
    {
        _errors = _problems.Count(d => d.IsError);
        _warnings = _problems.Count(d => d.Severity == SysmlSeverity.Warning);
    }

    private async Task PushText(bool keepView)
    {
        if (_mod == null) return;
        try
        {
            await _mod.InvokeVoidAsync("setText", _host, State.Text, keepView);
            await PushDiagnostics();
        }
        catch (JSDisconnectedException) { }
    }

    private async Task PushDiagnostics()
    {
        if (_mod == null || _doc == null) return;
        var list = _problems.Where(d => d.Span.Start <= State.Text.Length).Select(d => new
        {
            line = d.Span.Line, col = d.Span.Column, len = Math.Max(1, d.Span.Length),
            sev = d.Severity switch { SysmlSeverity.Error => 0, SysmlSeverity.Warning => 1, _ => 2 }, msg = d.Message,
        }).ToArray();
        try { await _mod.InvokeVoidAsync("setDiagnostics", _host, list); }
        catch (JSDisconnectedException) { }
    }

    private async Task RevealElement(Element e, bool focus)
    {
        if (_mod == null || _doc == null || !Ws.Model.Contains(e)) return;
        var spans = SysMLv2Sync.Locate(Ws.Model, Scope, _doc);
        // Relationships and unrepresented elements: fall back to the nearest represented owner.
        foreach (var a in e.AncestorsAndSelf())
            if (spans.TryGetValue(a.Id, out var span))
            {
                try { await _mod.InvokeVoidAsync("reveal", _host, span.Start, span.End, focus); }
                catch (JSDisconnectedException) { }
                return;
            }
    }

    // ------------------------------------------------------------------ shared text

    private void OpenShared()
    {
        if (Ws.Session is not { } session) return;
        _client ??= new SharedTextEvents(this);
        // Events can arrive while OpenText runs: accept them for this text, and hold them back from an existing browser
        // editor until it has been reset to the snapshot.
        _session = session;
        _textKey = ProjectSession.TextKey(State.ScopeId, State.ShowIds);
        _holdForReset = _jsReady;
        _remote = [];
        var snap = session.OpenText(Ws.ParticipantId, State.ScopeId, State.ShowIds, _client);
        _textKey = snap.Key;
        _openRevision = snap.Revision;
        State.Model = Ws.Model;
        State.Text = State.Baseline = snap.Text;
        State.SharedDirty = snap.Status.Dirty;
        State.Stale = snap.Status.Stale;
    }

    private void CloseShared()
    {
        if (_session != null && _textKey != null) _session.CloseText(_textKey, Ws.ParticipantId);
        _session = null;
        _textKey = null;
        _remote = [];
    }

    /// <summary>Points the browser editor at the (newly opened) shared text, or the private buffer.</summary>
    private async Task ResetEditor()
    {
        if (_mod == null) return;
        try
        {
            if (Shared)
            {
                var reset = _mod.InvokeVoidAsync("resetShared", _host, State.Text, _openRevision);
                _holdForReset = false;
                FlushToEditor();   // events that arrived after the snapshot, now in order after the reset
                await reset;
            }
            else await _mod.InvokeVoidAsync("setText", _host, State.Text, false);
            await PushDiagnostics();
        }
        catch (JSDisconnectedException) { }
    }

    private void FlushToEditor()
    {
        var pending = _beforeJs.ToList();
        _beforeJs.Clear();
        foreach (var a in pending) a();
    }

    /// <summary>Runs a browser call for a shared-text event now, or once the editor exists (keeping the order).</summary>
    private void ToEditor(string key, string fn, params object?[] args)
    {
        if (key != _textKey) return;
        void Call()
        {
            if (_mod == null) return;
            _ = _mod.InvokeVoidAsync(fn, [_host, .. args]).AsTask().ContinueWith(_ => { }, TaskScheduler.Default);
        }
        if (_jsReady && !_holdForReset) Call(); else _beforeJs.Add(Call);
    }

    /// <summary>Receives the session's shared-text events and hands them to the circuit, in order.</summary>
    /// <remarks>The session calls these under its lock, in server order. They are queued and drained on the circuit: Blazor runs
    /// InvokeAsync inline when already on the circuit, so posting each event separately could let an acknowledgement of our own
    /// edit overtake a remote operation queued before it.</remarks>
    private sealed class SharedTextEvents(SysmlTextPanel panel) : ISharedTextClient
    {
        private readonly System.Collections.Concurrent.ConcurrentQueue<Action> _queue = new();

        private void Post(Action a)
        {
            _queue.Enqueue(a);
            _ = panel.InvokeAsync(Drain);
        }

        private void Drain()
        {
            while (_queue.TryDequeue(out var a)) a();
        }

        public void TextOperation(string key, TextOperation op)
        {
            // One argument: an object[] passed to a params object?[] parameter would be spread into separate arguments.
            object wire = op.ToWire();
            Post(() => panel.ToEditor(key, "remoteOp", wire));
        }

        public void TextAck(string key) => Post(() => panel.ToEditor(key, "ack"));

        public void TextCursors(string key, int revision, IReadOnlyList<TextCursor> cursors) => Post(() =>
        {
            if (key != panel._textKey) return;
            var others = cursors.Where(c => c.ParticipantId != panel.Ws.ParticipantId).ToList();
            var people = others.Select(c => c.Name).ToList();
            var changed = !people.SequenceEqual(panel._remote.Select(c => c.Name));
            panel._remote = others;
            panel.ToEditor(key, "setCursors", revision, others.Where(c => c.Head >= 0).Select(c => new { name = c.Name, color = c.Color, anchor = c.Anchor, head = c.Head }).ToArray());
            if (changed) panel.StateHasChanged();
        });

        public void TextStatus(string key, SharedTextStatus status) => Post(() =>
        {
            if (key != panel._textKey) return;
            panel.State.SharedDirty = status.Dirty;
            panel.State.Stale = status.Stale;
            if (status.Notice != null) { panel._summary = status.Notice; panel._summaryDetail = null; }
            panel.StateHasChanged();
        });

        public void TextReset(string key, string text, int revision) => Post(() =>
        {
            if (key != panel._textKey) return;
            panel.State.Text = text;
            panel._openRevision = revision;
            panel.Reparse();
            panel.ToEditor(key, "resetShared", text, revision);
            panel.StateHasChanged();
        });
    }

    private static string SafeColor(string c) => System.Text.RegularExpressions.Regex.IsMatch(c ?? "", "^#[0-9a-fA-F]{3,8}$") ? c! : "#4f8cff";

    private static string Initials(string name) =>
        string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => char.ToUpperInvariant(w[0])));

    // ------------------------------------------------------------------ JS callbacks

    [JSInvokable]
    public async Task OnEdit(string text)
    {
        State.Text = text;
        Reparse();
        if (_summary != null && State.Dirty) _summary = null;
        await PushDiagnostics();
        StateHasChanged();
    }

    /// <summary>A local edit of the shared text, made against <paramref name="revision"/>.</summary>
    [JSInvokable]
    public void OnTextOp(int revision, JsonElement ops)
    {
        if (!Shared || Ws.ReadOnly) return;
        TextOperation op;
        try { op = TextOperation.FromJson(ops); }
        catch (Exception ex) when (ex is FormatException or InvalidOperationException or OverflowException) { OnTextOutOfStep(); return; }
        _session!.SubmitText(_textKey!, Ws.ParticipantId, revision, op);
    }

    [JSInvokable]
    public void OnCursor(int revision, int anchor, int head)
    {
        if (Shared) _session!.UpdateTextCursor(_textKey!, Ws.ParticipantId, revision, anchor, head);
    }

    /// <summary>The browser could not apply a server operation: start over from the server's text.</summary>
    [JSInvokable]
    public void OnTextOutOfStep()
    {
        if (!Shared || _session!.TextState(_textKey!) is not { } s) return;
        _client!.TextReset(_textKey!, s.Text, s.Revision);
    }

    [JSInvokable]
    public async Task OnApplyShortcut(string text)
    {
        if (Shared) { await ApplyShared(); return; }
        State.Text = text;
        await Apply();
    }

    [JSInvokable]
    public Task OnNavigate(int offset)
    {
        if (_doc == null || _doc.Text != State.Text) Reparse();
        var e = SysMLv2Sync.ElementAt(Ws.Model, Scope, _doc!, offset);
        if (e != null)
        {
            if (Shell != null) Shell.Navigate(e); else Ws.Select(e);
            Ws.SetStatus($"{Metamodel.DisplayName(e.Kind)} {e.QualifiedName}");
        }
        else Ws.SetStatus(State.Dirty ? "No element there yet — apply the text first" : "No model element at that position");
        return Task.CompletedTask;
    }

    // ------------------------------------------------------------------ commands

    private async Task ApplyClicked()
    {
        if (Shared) { await ApplyShared(); return; }
        if (_mod != null)
        {
            try { State.Text = await _mod.InvokeAsync<string?>("getText", _host) ?? State.Text; }
            catch (JSDisconnectedException) { return; }
        }
        await Apply();
    }

    /// <summary>Parses and maps the text; returns the result, or null when it has errors (which are shown).</summary>
    private async Task<SysmlSyncResult?> ApplyText()
    {
        Reparse();
        if (_doc!.HasErrors)
        {
            await PushDiagnostics();
            _summary = $"Not applied: fix {_errors} error{(_errors == 1 ? "" : "s")} first.";
            _summaryDetail = null;
            Ws.SetStatus(_summary);
            if (_problems.FirstOrDefault(p => p.IsError) is { } first) await GoTo(first);
            StateHasChanged();
            return null;
        }
        if (Ws.ReadOnly) return null;
        _applying = true;
        try { return SysMLv2Sync.Apply(Ws.Model, Scope, _doc); }
        catch (InvalidOperationException ex)
        {
            _summary = "Could not apply: " + ex.Message;
            StateHasChanged();
            return null;
        }
        finally { _applying = false; }
    }

    private void Summarize(SysmlSyncResult result)
    {
        var n = result.Changes.Count;
        _summary = n == 0 ? "Applied — no changes." : $"Applied {n} change{(n == 1 ? "" : "s")} (one undo step): " +
            string.Join(" · ", result.Changes.Take(4).Select(c => c.Description)) + (n > 4 ? $" · +{n - 4} more" : "");
        _summaryDetail = string.Join("\n", result.Changes.Select(c => c.Description));
        foreach (var c in result.Changes) Ws.Log("SysML v2 text: " + c.Description);
        Ws.SetStatus(n == 0 ? "SysML v2 text applied — model already up to date" : $"Applied {n} change{(n == 1 ? "" : "s")} from SysML v2 text");
    }

    private async Task Apply()
    {
        if (await ApplyText() is not { } result) return;
        Summarize(result);
        // Canonical text from the model; mapping warnings stay listed (their positions refer to the applied text).
        Load(ExportScope());
        Reparse();
        _problems.AddRange(result.Diagnostics.Where(d => d.Severity != SysmlSeverity.Info || result.Diagnostics.Count < 20));
        Count();
        await PushText(keepView: true);
        Ws.Bump();
    }

    /// <summary>Applies the shared text once, here; the model operations replicate to everyone and the session rewrites the
    /// shared text into the model's canonical form for all editors.</summary>
    private async Task ApplyShared()
    {
        if (Ws.ReadOnly || !Shared) return;
        SyncedText? synced = null;
        if (_mod != null)
        {
            try { synced = await _mod.InvokeAsync<SyncedText?>("syncedText", _host); }
            catch (JSException) { _summary = "Your last edits are still being sent — try again in a moment."; StateHasChanged(); return; }
            catch (JSDisconnectedException) { return; }
        }
        var key = _textKey!;
        var session = _session!;
        State.Text = synced?.Text ?? State.Text;
        if (await ApplyText() is not { } result) return;
        Summarize(result);
        var who = Ws.User?.DisplayName ?? "Someone";
        var n = result.Changes.Count;
        session.TextApplied(key, Ws.ParticipantId, synced?.Revision ?? -1, State.Text, n == 0 ? $"{who} applied the text — no changes." : $"{who} applied {n} change{(n == 1 ? "" : "s")}.");
        _problems.AddRange(result.Diagnostics.Where(d => d.Severity != SysmlSeverity.Info || result.Diagnostics.Count < 20));
        Count();
        await PushDiagnostics();
        Ws.Bump();
    }

    private async Task Reload()
    {
        if (Shared)
        {
            if (_remote.Count > 0)
            {
                var ok = await Dialogs.ShowMessageBox("Discard unapplied edits", "This text is shared: reloading discards everyone's unapplied edits in it.", yesText: "Reload", cancelText: "Cancel");
                if (ok != true) return;
            }
            // Let this tab's own typed edits reach the session first; otherwise they are replayed after the reset and the
            // "discarded" text comes back.
            if (_mod != null)
            {
                try { await _mod.InvokeAsync<SyncedText?>("syncedText", _host); }
                catch (JSException) { /* still sending: the reset below wins for everything that already arrived */ }
                catch (JSDisconnectedException) { return; }
            }
            if (Ws.ReadOnly)
            {
                // Viewers can't discard the editors' unapplied edits: just resynchronise this tab with the shared text.
                OnTextOutOfStep();
                _summary = null;
                return;
            }
            _session!.ResetText(_textKey!, Ws.ParticipantId, $"{Ws.User?.DisplayName ?? "Someone"} reloaded the text from the model.");
            _summary = null;
            return;
        }
        Load(ExportScope());
        Reparse();
        _summary = null;
        await PushText(keepView: true);
    }

    private void KeepEditing()
    {
        if (Shared) _session!.DismissTextStale(_textKey!, Ws.ParticipantId);
        State.Stale = false;
    }

    private async Task ToggleIds(ChangeEventArgs e)
    {
        if (Shared)
        {   // id comments on / off is another shared text of the same scope
            State.ShowIds = e.Value is true;
            CloseShared();
            OpenShared();
            Reparse();
            await ResetEditor();
            return;
        }
        var wasDirty = State.Dirty;
        State.ShowIds = e.Value is true;
        if (!wasDirty) await Reload();
        else _summary = "Id comments will change on the next reload or apply.";
    }

    private async Task SwitchScope(Element scope)
    {
        if (ReferenceEquals(scope, Scope) && State.Model == Ws.Model && (Shared || Ws.Session == null)) { await RevealSelectionLater(); return; }
        if (Shared || Ws.Session != null)
        {   // unapplied edits stay in the shared text of the old scope
            CloseShared();
            State.ScopeId = scope.Kind == ElementKind.Model ? null : scope.Id;
            OpenShared();
            Reparse();
            _summary = null;
            await ResetEditor();
            await RevealSelectionLater();
            StateHasChanged();
            return;
        }
        if (State.Dirty)
        {
            var ok = await Dialogs.ShowMessageBox("Unapplied SysML v2 edits", "Switching the scope discards the text edits you haven't applied.", yesText: "Discard", cancelText: "Keep editing");
            if (ok != true) return;
        }
        State.ScopeId = scope.Kind == ElementKind.Model ? null : scope.Id;
        await Reload();
        await RevealSelectionLater();
        StateHasChanged();
    }

    private async Task RevealSelectionLater()
    {
        if (Ws.Selected is { } sel) await RevealElement(sel, focus: false);
    }

    private async Task GoTo(SysmlDiagnostic d)
    {
        if (_mod == null) return;
        try { await _mod.InvokeVoidAsync("revealLine", _host, d.Span.Line, d.Span.Column); }
        catch (JSDisconnectedException) { }
    }

    public async ValueTask DisposeAsync()
    {
        base.Dispose();
        if (_model != null) _model.Changed -= OnModelChanged;
        CloseShared();
        if (_mod != null)
        {
            try
            {
                if (State.SharedDirty == null) State.Text = await _mod.InvokeAsync<string?>("getText", _host) ?? State.Text;
                await _mod.InvokeVoidAsync("dispose", _host);
                await _mod.DisposeAsync();
            }
            catch (JSDisconnectedException) { }
            catch (TaskCanceledException) { }
        }
        _self?.Dispose();
    }
}

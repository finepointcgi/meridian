@* Template-driven document generation (SRS, ICD, SDD, VCRM, model overview, user templates) to PDF / Word / HTML,
   generated on a model snapshot with progress and cancel. A numbering pass sizes the document first: very big documents
   get a warning (split per package, or narrow the scope), big ones run as background jobs (status bar + notification),
   small ones download straight away. Files stream from GET api/reports/{id}/file (Services/ReportJobs.cs). *@
@using Meridian.Serialization.Reports
@implements IDisposable
@inject Workspace Ws
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject IDialogService Dialogs
@inject IServiceProvider Services

<MudDialog>
    <TitleContent><div class="d-flex align-center gap-2"><MudIcon Icon="@Icons.Material.Outlined.Description" /><MudText Typo="Typo.h6">Generate document</MudText></div></TitleContent>
    <DialogContent>
        <div style="display:flex; flex-direction:column; gap:10px">
            <div class="d-flex align-center gap-2">
                <MudSelect T="string" Label="Template" Value="_selectedKey" ValueChanged="Select" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Disabled="_busy" Style="flex:1">
                    @foreach (var e in _entries)
                    {
                        <MudSelectItem Value="@e.Key">@e.Label</MudSelectItem>
                    }
                </MudSelect>
                <MudMenu Icon="@Icons.Material.Filled.MoreVert" Dense="true" Disabled="_busy" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                    <MudMenuItem Icon="@Icons.Material.Outlined.Edit" OnClick="EditTemplate">@(_current?.Element != null ? "Edit template…" : "Edit a copy…")</MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Outlined.ContentCopy" OnClick="Duplicate">Duplicate into model</MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Outlined.Download" OnClick="ExportJson">Export template (.json)</MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Outlined.UploadFile" OnClick="@(() => JS.InvokeVoidAsync("meridian.click", "report-template-file").AsTask())">Import template (.json)…</MudMenuItem>
                    @if (_current?.Element != null)
                    {
                        <MudDivider />
                        <MudMenuItem Icon="@Icons.Material.Outlined.Delete" OnClick="DeleteTemplate">Delete from model</MudMenuItem>
                    }
                </MudMenu>
            </div>
            @if (_current != null && _current.Template.Description.Length > 0)
            {
                <MudText Typo="Typo.caption" Style="color:var(--text-3); margin-top:-6px">@_current.Template.Description</MudText>
            }
            <MudTextField T="string" @bind-Value="_title" Label="Title" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="_busy" />
            <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px">
                <MudTextField T="string" @bind-Value="_subtitle" Label="Subtitle" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="_busy" />
                <MudTextField T="string" @bind-Value="_number" Label="Document number" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="_busy" />
                <MudTextField T="string" @bind-Value="_revision" Label="Revision" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="_busy" />
                <MudTextField T="string" @bind-Value="_classification" Label="Classification marking" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="_busy" />
                <MudTextField T="string" @bind-Value="_author" Label="Author" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="_busy" />
                <MudSelect T="string" @bind-Value="_pageSize" Label="Page size" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Disabled="_busy">
                    <MudSelectItem Value="@("Letter")">US Letter</MudSelectItem>
                    <MudSelectItem Value="@("A4")">A4</MudSelectItem>
                </MudSelect>
            </div>
            <div class="section-title" style="margin-top:4px">Format</div>
            <MudRadioGroup T="ReportFormat" @bind-Value="_format" Disabled="_busy">
                <MudRadio Value="ReportFormat.Pdf" Color="Color.Primary" Dense="true">PDF</MudRadio>
                <MudRadio Value="ReportFormat.Docx" Color="Color.Primary" Dense="true">Word (.docx)</MudRadio>
                <MudRadio Value="ReportFormat.Html" Color="Color.Primary" Dense="true">HTML (single file)</MudRadio>
            </MudRadioGroup>
            <div class="section-title" style="margin-top:4px">Scope</div>
            <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px">
                <MudSelect T="string" @bind-Value="_scope" Label="Report on" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Disabled="_busy" Class="report-scope">
                    <MudSelectItem Value="@("model")">Whole model</MudSelectItem>
                    @if (SelectionScope is { } sel)
                    {
                        <MudSelectItem Value="@("selection")">Selection: @sel.Name</MudSelectItem>
                    }
                    <MudSelectItem Value="@("package")">A package…</MudSelectItem>
                </MudSelect>
                @if (_scope == "package")
                {
                    <MudSelect T="string" @bind-Value="_scopePackage" Label="Package" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Disabled="_busy" Class="report-scope-package">
                        @foreach (var p in _packages)
                        {
                            <MudSelectItem Value="@p.Id">@p.Label</MudSelectItem>
                        }
                    </MudSelect>
                }
                else
                {
                    <MudNumericField T="int" @bind-Value="_depth" Label="Package depth (0 = all)" Min="0" Max="20" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="_busy" Class="report-depth" />
                }
                <MudSelect T="ReportSplit" @bind-Value="_split" Label="Output" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Disabled="_busy" Class="report-split" Style="grid-column:1 / span 2">
                    <MudSelectItem Value="ReportSplit.None">One document</MudSelectItem>
                    <MudSelectItem Value="ReportSplit.PartPerPackage">One document, a part per top-level package (with contents)</MudSelectItem>
                    <MudSelectItem Value="ReportSplit.ZipPerPackage">A zip with one document per top-level package</MudSelectItem>
                </MudSelect>
            </div>
            @if (_ai != null)
            {
                @* AI narrative: Claude drafts an overview and rationale per section; shown here for review and editing, never added silently. *@
                <div class="section-title" style="margin-top:4px">AI narrative</div>
                <MudSwitch T="bool" Value="_aiNarrative" ValueChanged="v => { _aiNarrative = v; }" Color="Color.Primary" Disabled="_busy || _drafting" Class="ai-narrative-switch"
                           Label="Have Claude draft an overview and a rationale for each section (you review them first)" />
                @if (_aiNarrative)
                {
                    @if (!_ai.Acknowledged)
                    {
                        <MudText Typo="Typo.caption" Style="color:var(--text-3)">Open the AI assistant once and accept its notice about sending model content to Anthropic first.</MudText>
                    }
                    else
                    {
                        <div class="d-flex align-center gap-2">
                            <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Outlined.AutoAwesome" Disabled="_busy || _drafting || _current == null" OnClick="DraftNarrative">
                                @(_drafting ? "Drafting…" : _narrative == null ? "Draft narrative" : "Redraft")
                            </MudButton>
                            @if (_drafting) { <MudProgressCircular Size="Size.Small" Indeterminate="true" /> }
                            <MudText Typo="Typo.caption" Style="color:var(--text-3)">Sends a summary of the model to Anthropic. Edit or untick anything before generating.</MudText>
                        </div>
                        @if (_narrativeError != null) { <MudText Typo="Typo.caption" Color="Color.Error">@_narrativeError</MudText> }
                        @if (_narrative != null)
                        {
                            <div class="narrative-review" style="display:flex; flex-direction:column; gap:8px; max-height:38vh; overflow:auto; padding-right:4px">
                                @foreach (var n in _narrative)
                                {
                                    var section = n;
                                    <div style="border:1px solid var(--border); border-radius:8px; padding:8px">
                                        <MudCheckBox T="bool" Value="section.Include" ValueChanged="v => section.Include = v" Dense="true" Color="Color.Primary" Label="@section.Title" />
                                        <MudTextField T="string" Value="section.Overview" ValueChanged="v => section.Overview = v" Label="Overview" Lines="3" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="!section.Include" />
                                        <MudTextField T="string" Value="section.Rationale" ValueChanged="v => section.Rationale = v" Label="Rationale" Lines="2" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="!section.Include" />
                                    </div>
                                }
                            </div>
                        }
                    }
                }
            }
            @if (_warning != null)
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="report-size-warning">
                    <div>@_warning</div>
                    <div class="d-flex gap-2 mt-2" style="flex-wrap:wrap">
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Class="report-split-zip" OnClick="SplitAndGenerate">Split per top-level package</MudButton>
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Class="report-limit" OnClick="LimitScope">Limit to a package or depth</MudButton>
                        <MudButton Size="Size.Small" Variant="Variant.Text" Class="report-anyway" OnClick="GenerateAnyway">Generate anyway</MudButton>
                    </div>
                </MudAlert>
            }
            @if (_busy || _progressText.Length > 0)
            {
                <div class="report-progress">
                    <MudProgressLinear Color="Color.Primary" Value="@(_progress * 100)" Rounded="true" Size="Size.Small" />
                    <MudText Typo="Typo.caption" Style="color:var(--text-3)" Class="report-progress-text">@_progressText</MudText>
                    @if (_detail.Length > 0) { <MudText Typo="Typo.caption" Style="color:var(--text-3); display:block" Class="report-progress-detail">@_detail</MudText> }
                    @if (_job is { Background: true, IsDone: false })
                    {
                        <MudText Typo="Typo.caption" Style="display:block" Class="report-background-note">This is a big document, so it is generated in the background: you can close this dialog and keep working. The status bar shows its progress, and a Download button when it is ready.</MudText>
                    }
                </div>
            }
        </div>
        <InputFile id="report-template-file" accept=".json,application/json" OnChange="ImportJson" style="display:none" />
    </DialogContent>
    <DialogActions>
        @if (_busy)
        {
            <MudButton OnClick="CancelGeneration" StartIcon="@Icons.Material.Outlined.StopCircle">Cancel generation</MudButton>
        }
        @if (!_busy || _job is { Background: true })
        {
            <MudButton OnClick="() => MudDialog.Cancel()">Close</MudButton>
        }
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy || _drafting || _current == null" OnClick="Generate">@(_busy ? "Generating…" : "Generate")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private sealed record Entry(string Key, string Label, DocTemplate Template, Element? Element);

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    private List<Entry> _entries = new();
    private string _selectedKey = "";
    private Entry? _current;
    private string _title = "", _subtitle = "", _number = "", _revision = "", _classification = "", _author = "", _pageSize = "Letter";
    private ReportFormat _format = ReportFormat.Pdf;
    private bool _busy;
    private double _progress;
    private string _progressText = "", _detail = "";
    private CancellationTokenSource? _cts;

    // Scope and splitting.
    private sealed record PackageOption(string Id, string Label);
    private string _scope = "model";
    private string? _scopePackage;
    private int _depth;
    private ReportSplit _split = ReportSplit.None;
    private List<PackageOption> _packages = new();

    // Size check and the job.
    private string? _warning;
    private (ModelRepository Snapshot, DocTemplate Template, ResolveOptions Options, PreparedReport Prepared)? _pending;
    private ReportJobService _jobs = default!;
    private ReportJob? _job;
    private System.Diagnostics.Stopwatch _clock = new();

    private Element? SelectionScope => Ws.Selected is { } e && e.Kind != ElementKind.Model && !e.IsRelationship ? e : null;

    /// <summary>Name of a built-in template to select when the dialog opens (e.g. the SDD from "Generate SDD…").</summary>
    [Parameter] public string? Preselect { get; set; }

    private Meridian.Web.Services.AssistantService? _ai;
    private bool _aiNarrative;
    private bool _drafting;
    private List<Meridian.Assistant.Engine.NarrativeSection>? _narrative;
    private string? _narrativeError;
    private CancellationTokenSource? _draftCts;

    protected override void OnInitialized()
    {
        _jobs = ReportJobService.From(Services);
        _jobs.Changed += OnJobChanged;
        // Packages to scope to: the first few levels (a Cameo-size model has thousands of packages).
        _packages = Ws.Model.OfKind(ElementKind.Package)
            .Select(p => (p, Depth: p.AncestorsAndSelf().Count()))
            .Where(x => x.Depth <= 4 && x.p.Name != ReportTemplates.PackageName)
            .OrderBy(x => x.p.QualifiedName, StringComparer.OrdinalIgnoreCase).Take(400)
            .Select(x => new PackageOption(x.p.Id, x.p.QualifiedName)).ToList();
        _scopePackage = _packages.FirstOrDefault()?.Id;
        Load();
        var pre = Preselect is { Length: > 0 } name ? _entries.FirstOrDefault(e => e.Element == null && e.Template.Name == name)?.Key : null;
        Select(pre ?? _entries.FirstOrDefault()?.Key ?? "");
        // The assistant is optional (not registered in every host); the narrative needs it configured.
        _ai = Services.GetService(typeof(Meridian.Web.Services.AssistantService)) as Meridian.Web.Services.AssistantService;
        if (_ai?.UnavailableReason != null) _ai = null;
    }

    private async Task DraftNarrative()
    {
        if (_ai?.NarrativeWriter() is not { } writer) { _narrativeError = "The AI assistant is not available."; return; }
        _drafting = true;
        _narrativeError = null;
        StateHasChanged();
        _draftCts?.Dispose();
        _draftCts = new CancellationTokenSource();
        try
        {
            var t = Effective();
            var result = await writer.DraftAsync(Ws.Model, DocResolverTitle(t, Ws.Model), t.Sections.Select(s => s.Title).ToList(), _draftCts.Token);
            if (result.Ok) _narrative = result.Sections.ToList();
            else _narrativeError = result.Error;
        }
        finally
        {
            _drafting = false;
            StateHasChanged();
        }
    }

    private void Load(string? select = null)
    {
        _entries = ReportTemplates.BuiltIn.Select((t, i) => new Entry("builtin:" + i, t.Name + " (built-in)", t, null))
            .Concat(ReportTemplates.InModel(Ws.Model).Select(x => new Entry("model:" + x.Element.Id, x.Template.Name, x.Template, x.Element)))
            .ToList();
        if (select != null) Select(select);
    }

    private void Select(string key)
    {
        _selectedKey = key;
        _current = _entries.FirstOrDefault(e => e.Key == key);
        if (_current == null) return;
        var t = _current.Template;
        _title = t.Title;
        _subtitle = t.Subtitle;
        _number = t.DocumentNumber;
        _revision = t.Revision;
        _classification = t.Classification;
        _author = t.Author.Length > 0 ? t.Author : Ws.User?.DisplayName ?? "";
        _pageSize = t.PageSize;
        _progressText = "";
        _narrative = null;   // a narrative belongs to the template it was drafted for
        _narrativeError = null;
    }

    /// <summary>The selected template with this dialog's document properties applied.</summary>
    private DocTemplate Effective()
    {
        var t = _current!.Template.Clone();
        t.Title = _title ?? ""; t.Subtitle = _subtitle ?? ""; t.DocumentNumber = _number ?? ""; t.Revision = _revision ?? "";
        t.Classification = _classification ?? ""; t.Author = _author ?? ""; t.PageSize = _pageSize;
        return t;
    }

    /// <summary>The scope and output options chosen in the dialog.</summary>
    private ResolveOptions Options() => new()
    {
        Scope = _scope switch
        {
            "selection" when SelectionScope is { } e => [e.Id],
            "package" when _scopePackage != null => [_scopePackage],
            _ => null,
        },
        ScopeDepth = _scope == "package" ? 0 : Math.Max(0, _depth),
        SplitByPackage = _split == ReportSplit.PartPerPackage,
    };

    /// <summary>Snapshot, then a numbering pass that sizes the document; warns when it is huge, otherwise generates.</summary>
    private async Task Generate()
    {
        if (_current == null) return;
        _busy = true;
        _warning = null;
        _pending = null;
        _progress = 0;
        _detail = "";
        _progressText = "Taking a model snapshot…";
        StateHasChanged();
        _cts?.Dispose();
        _cts = new CancellationTokenSource();
        var ct = _cts.Token;
        var template = Effective();
        if (_aiNarrative && _narrative != null) Meridian.Assistant.Engine.NarrativeWriter.ApplyTo(template, _narrative);
        try
        {
            var snapshot = ReportEngine.Snapshot(Ws.Model);   // UI thread: consistent copy, then work off-thread
            var options = Options();
            _progressText = "Estimating the document's size…";
            StateHasChanged();
            var progress = UiProgress();
            var prepared = await Task.Run(() => ReportEngine.Prepare(snapshot, template, options, progress, ct), ct);
            ct.ThrowIfCancellationRequested();
            if (ReportEngine.ShouldWarn(prepared.Stats) && _split == ReportSplit.None)
            {
                // Don't start a 40,000-page document by accident: offer to split it or narrow it first.
                _pending = (snapshot, template, options, prepared);
                _warning = $"This {_current.Template.Name} would be ~{prepared.EstimatedPages:N0} pages ({prepared.Stats.TableRows:N0} table rows, " +
                           $"{prepared.Stats.FigureCount:N0} diagrams). Generate it per top-level package, or limit it to a package or a package depth?";
                _progressText = "";
                _busy = false;
                return;
            }
            await Run(snapshot, template, options, prepared);
        }
        catch (OperationCanceledException)
        {
            _progressText = "Generation cancelled.";
            _busy = false;
        }
        catch (Exception ex) when (ex is IOException or InvalidOperationException or ArgumentException or Meridian.Core.Analysis.QueryParseException or System.Text.Json.JsonException)
        {
            _progressText = "";
            _busy = false;
            Snackbar.Add($"Could not generate the document: {FriendlyError.Describe(ex)}. Check the template's queries, or try another format.", Severity.Error);
        }
        finally
        {
            StateHasChanged();
        }
    }

    private Task GenerateAnyway() => _pending is { } p ? Start(() => Run(p.Snapshot, p.Template, p.Options, p.Prepared)) : Task.CompletedTask;

    private Task SplitAndGenerate()
    {
        _split = ReportSplit.ZipPerPackage;
        return _pending is { } p ? Start(() => Run(p.Snapshot, p.Template, p.Options, p.Prepared)) : Task.CompletedTask;
    }

    private void LimitScope()
    {
        _warning = null;
        _pending = null;
        if (_scope == "model") _scope = "package";
    }

    private async Task Start(Func<Task> run)
    {
        _warning = null;
        _pending = null;
        _busy = true;
        StateHasChanged();
        try { await run(); }
        finally { StateHasChanged(); }
    }

    /// <summary>Starts the job: big documents keep running in the background (status bar), small ones are awaited and downloaded.</summary>
    private async Task Run(ModelRepository snapshot, DocTemplate template, ResolveOptions options, PreparedReport prepared)
    {
        var format = _format;
        var split = _split;
        var title = DocResolverTitle(template, snapshot);
        var (ext, mime) = ReportEngine.Output(format, split);
        var name = ReportEngine.FileName(title) + "." + ext;
        var background = ReportEngine.ShouldRunInBackground(prepared.Stats);
        // The numbering pass is reused for the document; a zip prepares each package's document itself.
        var reuse = split == ReportSplit.ZipPerPackage ? null : prepared;
        _clock = System.Diagnostics.Stopwatch.StartNew();
        _job = _jobs.Start(title, name, mime, (stream, progress, ct) => ReportEngine.Generate(snapshot, template, format, stream, split, options, progress, ct, reuse),
                           Ws.User?.Id, Ws.Session?.ProjectId, background, prepared.EstimatedPages, snapshot, Ws.Access);
        _job.Watched = true;   // this dialog reports the outcome while it is open
        _progress = 0.05;
        _progressText = background ? $"Generating ~{prepared.EstimatedPages:N0} pages in the background…" : "Generating…";
        StateHasChanged();
        if (background)
        {
            Ws.SetStatus($"Generating {name} in the background");
            await _jobs.WhenDone(_job);
            if (_disposed) return;   // the status bar has taken over
        }
        else await _jobs.WhenDone(_job);
        await Finish(_job);
    }

    private async Task Finish(ReportJob job)
    {
        _busy = false;
        switch (job.State)
        {
            case ReportJobState.Completed:
                await ReportDownloads.DownloadAsync(JS, _jobs, job);
                job.Dismissed = true;   // downloaded from here: the status bar needn't offer it again
                _progress = 1;
                _progressText = $"Generated {job.FileName} ({job.Length / 1024:N0} KB) in {_clock.Elapsed.TotalSeconds:0.0} s";
                Snackbar.Add($"Generated {job.FileName}", Severity.Success);
                break;
            case ReportJobState.Cancelled:
                _progressText = "Generation cancelled.";
                break;
            default:
                _progressText = "";
                Snackbar.Add($"Could not generate the document: {job.Error}. Check the template's queries, or try another format.", Severity.Error);
                break;
        }
        StateHasChanged();
    }

    private bool _disposed;

    private void OnJobChanged(ReportJob job)
    {
        if (!ReferenceEquals(job, _job) || _disposed) return;
        _progress = Math.Max(_progress, job.Fraction);
        _progressText = job.IsDone ? _progressText : job.Phase;
        _detail = job.Detail;
        _ = InvokeAsync(StateHasChanged);
    }

    /// <summary>Progress of the sizing pass, throttled for the UI.</summary>
    private IProgress<ReportProgress> UiProgress()
    {
        var lastUi = DateTime.MinValue;
        return new Progress<ReportProgress>(p =>
        {
            if (!double.IsNaN(p.Fraction)) _progress = Math.Min(0.05, p.Fraction * 0.05);
            _progressText = "Estimating the document's size: " + p.Phase;
            _detail = p.Sections > 0 ? $"Section {Math.Max(1, p.Section)} of {p.Sections} · {p.Elements:N0} elements" : "";
            if ((DateTime.UtcNow - lastUi).TotalMilliseconds < 120) return;
            lastUi = DateTime.UtcNow;
            _ = InvokeAsync(StateHasChanged);
        });
    }

    private static string DocResolverTitle(DocTemplate t, ModelRepository m)
    {
        var title = t.Title.Replace("{model.name}", m.Root.Name, StringComparison.OrdinalIgnoreCase);
        var sub = t.Subtitle.Replace("{model.name}", m.Root.Name, StringComparison.OrdinalIgnoreCase);
        return (t.DocumentNumber.Length > 0 ? t.DocumentNumber + " " : "") + title + (sub.Length > 0 ? " - " + sub : "");
    }

    private void CancelGeneration()
    {
        _cts?.Cancel();
        if (_job != null) _jobs.Cancel(_job);
        _progressText = "Cancelling…";
    }

    /// <summary>Opens the template in the report template editor, as a tab in the workbench (this dialog closes).</summary>
    private void EditTemplate()
    {
        if (_current == null) return;
        var template = Effective();
        if (_current.Element == null) template.Name = _current.Template.Name + " (copy)";
        Ws.OpenView(ViewTabKind.ReportTemplate, _current.Element, template, forceNew: _current.Element == null);
        MudDialog.Close();
    }

    private void Duplicate()
    {
        if (_current == null) return;
        var copy = Effective();
        copy.Name = _current.Template.Name + " (copy)";
        var e = ReportTemplates.Save(Ws.Model, copy);
        Snackbar.Add($"Saved '{copy.Name}' in the {ReportTemplates.PackageName} package", Severity.Success);
        Load("model:" + e.Id);
    }

    private void DeleteTemplate()
    {
        if (_current?.Element is not { } e) return;
        Ws.Model.Delete(e);
        Snackbar.Add($"Deleted template '{_current.Template.Name}' (undo restores it)", Severity.Info);
        Load();
        Select(_entries.FirstOrDefault()?.Key ?? "");
    }

    private async Task ExportJson()
    {
        if (_current == null) return;
        var t = Effective();
        t.Name = _current.Template.Name;
        var name = string.Join("_", t.Name.Split(Path.GetInvalidFileNameChars(), StringSplitOptions.RemoveEmptyEntries)) + ".report.json";
        await JS.InvokeVoidAsync("meridian.download", name, "application/json", Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(t.ToJson())));
    }

    private async Task ImportJson(InputFileChangeEventArgs e)
    {
        try
        {
            using var reader = new StreamReader(e.File.OpenReadStream(4 * 1024 * 1024));
            var t = DocTemplate.FromJson(await reader.ReadToEndAsync());
            var saved = ReportTemplates.Save(Ws.Model, t);
            Snackbar.Add($"Imported template '{t.Name}'", Severity.Success);
            Load("model:" + saved.Id);
        }
        catch (Exception ex) when (ex is System.Text.Json.JsonException or IOException or NotSupportedException)
        {
            Snackbar.Add($"That file is not a report template: {FriendlyError.Describe(ex)}.", Severity.Error);
        }
    }

    public void Dispose()
    {
        _disposed = true;
        _jobs.Changed -= OnJobChanged;
        _draftCts?.Cancel();
        _draftCts?.Dispose();
        _cts?.Cancel();
        _cts?.Dispose();
        // A small document generated for this dialog is abandoned with it; a background one carries on (status bar).
        if (_job is { Background: false, IsDone: false } job) _jobs.Cancel(job);
        if (_job != null) _job.Watched = false;
    }
}

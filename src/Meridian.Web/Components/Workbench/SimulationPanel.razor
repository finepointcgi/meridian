@inherits WorkspaceComponent

<MudTabs Elevation="0" Rounded="false" PanelClass="pt-1" @bind-ActivePanelIndex="_tab">
    <MudTabPanel Text="Step" Icon="@Icons.Material.Outlined.SkipNext">
        <SimulationStepTab />
    </MudTabPanel>
    <MudTabPanel Text="Timed (discrete event)" Icon="@Icons.Material.Outlined.Timer">
        <TimedSimTab />
    </MudTabPanel>
    <MudTabPanel Text="Monte Carlo" Icon="@Icons.Material.Outlined.Casino">
        <MonteCarloTab />
    </MudTabPanel>
    <MudTabPanel Text="FMI import" Icon="@Icons.Material.Outlined.Extension">
        <FmiTab />
    </MudTabPanel>
    <MudTabPanel Text="Co-simulation" Icon="@Icons.Material.Outlined.ShowChart">
        <CoSimTab />
    </MudTabPanel>
</MudTabs>

@code {
    private int _tab;
}

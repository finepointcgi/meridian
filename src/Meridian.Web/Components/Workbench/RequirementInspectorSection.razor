@using Meridian.Core.Analysis
@inherits WorkspaceComponent

@* Requirement-management additions to the inspector: attributes, test verdict and suspect links. *@
@if (E is { } e && Ws.Model.Contains(e))
{
    if (e.Kind == ElementKind.Requirement)
    {
        <div class="section-title">Requirement attributes <span class="grow"></span></div>
        <div class="req-attrs">
            @foreach (var (key, label, values) in ReqFields.Standard)
            {
                var k = key;
                if (values != null)
                {
                    <MudSelect @key="@(e.Id + k)" T="string" Label="@label" Value="@e.Get(k)" ValueChanged="v => Set(e, k, v)" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" Disabled="Ws.ReadOnly">
                        <MudSelectItem Value="@("")">(unspecified)</MudSelectItem>
                        @foreach (var v in values) { <MudSelectItem Value="@v">@v</MudSelectItem> }
                    </MudSelect>
                }
                else
                {
                    <MudTextField @key="@(e.Id + k)" T="string" Label="@label" Value="@e.Get(k)" ValueChanged="v => Set(e, k, v)" Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Lines="@(k == ReqFields.Rationale ? 2 : 1)" AutoGrow="@(k == ReqFields.Rationale)" MaxLines="8" ReadOnly="Ws.ReadOnly" Class="@(k == ReqFields.Rationale ? "span2" : "")" />
                }
            }
        </div>
        <div class="tg-title" style="margin-top:8px; font-size:11.5px; color:var(--text-2)">Custom attributes</div>
        @foreach (var (name, value) in ReqFields.CustomAttributes(e).ToList())
        {
            var n = name;
            <div class="d-flex align-center gap-1">
                <span style="min-width:90px; font-size:12px; color:var(--text-2); overflow:hidden; text-overflow:ellipsis" title="@n">@n</span>
                <MudTextField @key="@(e.Id + "attr" + n)" T="string" Value="@value" ValueChanged="v => Set(e, ReqFields.CustomPrefix + n, v)" Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="Ws.ReadOnly" />
                <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Close" Disabled="Ws.ReadOnly" OnClick="() => Set(e, ReqFields.CustomPrefix + n, null)" aria-label="Remove" title="Remove" />
            </div>
        }
        @if (!Ws.ReadOnly)
        {
            <div class="d-flex align-center gap-1">
                <MudTextField T="string" @bind-Value="_newAttr" Placeholder="attribute" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
                <MudTextField T="string" @bind-Value="_newAttrValue" Placeholder="value" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
                <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Add" Disabled="string.IsNullOrWhiteSpace(_newAttr)" OnClick="() => AddAttr(e)" aria-label="Add" title="Add" />
            </div>
        }
        @* Simulation-driven verification: the criteria, each with its last result, and the aggregate (Analysis/Verification.cs). *@
        var criteria = Verification.Criteria(e);
        var vr = Ws.Verification.ResultOf(e);
        var checks = vr?.Checks ?? Verification.StoredChecks(Ws.Model, e);
        <div class="section-title">Verification criteria <span class="grow"></span>
            @if (!Ws.ReadOnly && criteria.Count > 0)
            {
                <span class="link" style="text-transform:none; letter-spacing:0; font-weight:500" data-testid="inspector-add-criterion" @onclick="() => _addingCriterion = true">Add criterion</span>
            }
        </div>
        @for (var k = 0; k < criteria.Count; k++)
        {
            var i = k;
            var crit = criteria[i];
            var critError = VerificationCriterion.Check(crit);
            var check = checks.FirstOrDefault(c => c.Index == i);
            <div class="d-flex align-start gap-1" data-testid="inspector-criterion" data-index="@i">
                <MudTextField @key="@($"{e.Id}{VerificationKeys.Criterion}{i}:{crit}")" T="string" Label="@(criteria.Count == 1 ? "Criterion" : $"Criterion {i + 1}")" Value="@crit"
                              ValueChanged="v => SetCriterionAt(e, i, v)" Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="Ws.ReadOnly" Class="vfy-crit"
                              Error="@(critError != null)" ErrorText="@critError" />
                @if (!Ws.ReadOnly)
                {
                    <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Close" OnClick="() => RemoveCriterion(e, i)" aria-label="Remove criterion" title="Remove this criterion"
                                   Style="margin-top:6px" data-testid="inspector-remove-criterion" />
                }
            </div>
            @if (criteria.Count > 1 && check is { NotRun: false })
            {
                <div style="font-size:11.5px; margin:-2px 0 4px 2px" data-testid="inspector-criterion-result">
                    @VerificationPanel.CheckBadge(check) <b>@check.Value</b>@(check.Bound.Length > 0 ? $" vs {check.Bound}" : "")@(check.Margin.Length > 0 ? $" · margin {check.Margin}" : "")
                </div>
            }
        }
        @if (criteria.Count == 0 || _addingCriterion)
        {
            <MudTextField @key="@($"{e.Id}-new-criterion-{criteria.Count}")" T="string" Label="@(criteria.Count == 0 ? "Criterion" : "New criterion")" Value="@("")"
                          ValueChanged="v => AddCriterion(e, v)" Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="Ws.ReadOnly" Class="vfy-crit"
                          HelperText="e.g. mass <= 1500 kg · mc: p95(accelTime) < 8 s · timed: final(speed) >= 25 m/s" data-testid="inspector-new-criterion" />
        }
        @if (vr is not null)
        {
            <div style="font-size:12px; margin-top:4px" data-testid="inspector-verify-result">
                @VerificationPanel.Badge(vr) @(criteria.Count > 1 ? $"all {criteria.Count} criteria · " : "")<b>@vr.Value</b>@(criteria.Count > 1 ? "" : $" vs {vr.Bound} · margin {vr.Margin}")
                <div style="color:var(--text-3)">@vr.Variant · @vr.At · @vr.Analysis</div>
            </div>
        }
    }

    if (e.Kind == ElementKind.TestCase)
    {
        <div class="section-title">Verification <span class="grow"></span></div>
        <MudSelect @key="@(e.Id + ReqFields.Verdict)" T="string" Label="Verdict" Value="@e.Get(ReqFields.Verdict)" ValueChanged="v => Set(e, ReqFields.Verdict, v)" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" Disabled="Ws.ReadOnly">
            <MudSelectItem Value="@("")">(not run)</MudSelectItem>
            @foreach (var v in ReqFields.Verdicts) { <MudSelectItem Value="@v">@v</MudSelectItem> }
        </MudSelect>
    }

    var suspect = SuspectLinks.Of(Ws.Model, e).ToList();
    if (suspect.Count > 0)
    {
        <div class="section-title suspect-title">
            <MudIcon Icon="@Icons.Material.Filled.WarningAmber" Style="font-size:14px" /> Suspect links
            <span class="grow"></span>
            @if (suspect.Count > 1 && !Ws.ReadOnly)
            {
                <span class="link" style="text-transform:none; letter-spacing:0; font-weight:500" @onclick="() => ClearAll(suspect)">Clear all</span>
            }
        </div>
        @foreach (var rel in suspect)
        {
            var r = rel;
            var other = ReferenceEquals(r.Source, e) ? r.Target : ReferenceEquals(r.Target, e) ? r.Source : null;
            <div class="suspect-row">
                <MudIcon Icon="@Icons.Material.Filled.WarningAmber" Style="font-size:15px; color:var(--warn)" />
                <div style="min-width:0; flex:1">
                    <div class="link" @onclick="() => Shell.Navigate(r)">
                        «@(Metamodel.Style(r.Kind).Keyword ?? Metamodel.DisplayName(r.Kind))» @(other != null ? TraceabilityTable.Label(other) : $"{TraceabilityTable.Label(r.Source)} → {TraceabilityTable.Label(r.Target)}")
                    </div>
                    <div class="why">@SuspectLinks.Describe(r, Ws.Model)</div>
                </div>
                @if (!Ws.ReadOnly)
                {
                    <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="() => Clear(r)">Clear</MudButton>
                }
            </div>
        }
    }
}

@code {
    [Parameter] public Element? E { get; set; }

    private string? _newAttr;
    private string? _newAttrValue;
    private bool _addingCriterion;

    private void SetCriterionAt(Element e, int index, string? value)
    {
        try { Verification.SetCriterionAt(Ws.Model, e, index, value); }
        catch (InvalidOperationException ex) { Ws.SetStatus(ex.Message); }
    }

    private void RemoveCriterion(Element e, int index)
    {
        try { Verification.RemoveCriterion(Ws.Model, e, index); }
        catch (InvalidOperationException ex) { Ws.SetStatus(ex.Message); }
    }

    private void AddCriterion(Element e, string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return;
        try { Verification.AddCriterion(Ws.Model, e, value); _addingCriterion = false; }
        catch (InvalidOperationException ex) { Ws.SetStatus(ex.Message); }
    }

    private void Set(Element e, string key, string? value)
    {
        try { Ws.Model.Set(e, key, value); }
        catch (InvalidOperationException ex) { Ws.SetStatus(ex.Message); }
    }

    private void AddAttr(Element e)
    {
        var name = _newAttr?.Trim();
        if (string.IsNullOrEmpty(name)) return;
        Set(e, ReqFields.CustomPrefix + name, string.IsNullOrEmpty(_newAttrValue) ? "—" : _newAttrValue);
        _newAttr = _newAttrValue = null;
    }

    private void Clear(Relationship r)
    {
        try { SuspectLinks.Clear(Ws.Model, r); Ws.SetStatus("Suspect link cleared"); }
        catch (InvalidOperationException ex) { Ws.SetStatus(ex.Message); }
    }

    private void ClearAll(IEnumerable<Relationship> links)
    {
        try { Ws.SetStatus($"Cleared {SuspectLinks.ClearAll(Ws.Model, links)} suspect links"); }
        catch (InvalidOperationException ex) { Ws.SetStatus(ex.Message); }
    }
}

@page "/"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@implements IDisposable

<PageTitle>@(Ws.Session?.Name ?? "Meridian") — Meridian</PageTitle>

<CascadingValue Value="this" IsFixed="true">
<div class="app @Theme.AppClass" style="@Theme.AppStyle">

    @* ================================================================ title bar *@
    <header class="titlebar">
        <div class="brand">
            <span class="logo"><MudIcon Icon="@Icons.Material.Filled.Hub" Style="font-size:16px; color:#fff" /></span>
            Meridian
        </div>
        <TabletDrawers />
        <MudMenu AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" Dense="true" PopoverClass="menu-fit" ListClass="project-menu">
            <ActivatorContent>
                <div class="project" title="Project menu: open, import, versions, sharing, integrations and export">
                    <MudIcon Icon="@Icons.Material.Outlined.FolderSpecial" Style="font-size:17px; color:var(--accent-2)" />
                    <span style="font-weight:600">@(Ws.Session?.Name ?? "No project")</span>
                    @if (Ws.ReadOnly) { <span class="ro-badge">View only</span> }
                    <span class="meta">@SavedText()</span>
                    <MudIcon Icon="@Icons.Material.Filled.ExpandMore" Style="font-size:16px; color:var(--text-3)" />
                </div>
            </ActivatorContent>
            <ChildContent>
                <MudMenuItem Disabled="true" Class="menu-heading">Project</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Outlined.FolderOpen" OnClick="OpenProjects">Projects… <Key>⌘O</Key></MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Outlined.NoteAdd" OnClick="NewModel">New project…</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Outlined.DriveFileRenameOutline" OnClick="() => Rename(Ws.Model.Root)">Rename model…</MudMenuItem>
                <MudDivider />
                <MudMenuItem Disabled="true" Class="menu-heading">Import</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Outlined.UploadFile" OnClick="@(() => PickFile("file-open"))" title="Meridian, XMI, SysML v2, Enterprise Architect .qea, Cameo / MagicDraw .mdzip, Mermaid .mmd / Markdown">Open a file as a new project…</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Outlined.Input" OnClick="@(() => ImportInto("file-into"))" Disabled="Ws.ReadOnly" title="BPMN, ArchiMate, SQL DDL, C# source, Mermaid (.mmd, Markdown), or a Cameo / MagicDraw re-import">Import into this project…</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Outlined.Schema" OnClick="@(() => PasteMermaid())" Disabled="Ws.ReadOnly" title="Flowcharts, class, state, sequence, requirement, ER and C4 diagrams written in Mermaid (for example by an AI assistant)">Paste Mermaid…</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Outlined.Storage" OnClick="ImportDatabaseSchema" Disabled="Ws.ReadOnly" data-testid="menu-import-database" title="PostgreSQL, SQL Server, MySQL / MariaDB, SQLite or Oracle DDL, a SQL Server .dacpac or a Mermaid erDiagram">Database schema (DDL / .dacpac)…</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Outlined.Cable" OnClick="ConnectToDatabase" Disabled="Ws.Session == null" title="Integrations ▸ Databases: import a live PostgreSQL, MySQL / MariaDB or SQLite schema and refresh it later">Connect to a database…</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Outlined.Badge" OnClick="AddUafProfile" Disabled="Ws.ReadOnly">Add UAF profile</MudMenuItem>
                <MudDivider />
                <MudMenuItem Disabled="true" Class="menu-heading">Versions &amp; team</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Outlined.Commit" OnClick="Save" Disabled="Ws.ReadOnly">Commit version… <Key>⌘S</Key></MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Outlined.History" OnClick="ShowHistory">Version history…</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Outlined.CallSplit" OnClick="ShowBranches">Branches &amp; merge…</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Outlined.Flag" OnClick="ShowBaselines">Baselines…</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Outlined.LibraryBooks" OnClick="ShowUsedProjects" Disabled="Ws.Session == null" data-testid="menu-used-projects">Used projects…</MudMenuItem>
                @if (!Host.LocalMode)
                {
                    <MudMenuItem Icon="@Icons.Material.Outlined.Group" OnClick="ShareProject">Share &amp; members…</MudMenuItem>
                }
                <MudMenuItem Icon="@Icons.Material.Outlined.Extension" OnClick="@(() => Dialogs.ShowAsync<IntegrationsDialog>("Integrations", new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true }))" Disabled="Ws.Session == null"
                             title="Issue trackers (Jira, Azure DevOps, GitHub, GitLab), webhooks, DOORS Next and Polarion, code repositories and live databases">Integrations… <span class="menu-hint">Jira, DOORS, Polarion, Git, databases</span></MudMenuItem>
                <MudDivider />
                <MudMenuItem Disabled="true" Class="menu-heading">Export</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Outlined.Download" OnClick="DownloadProject">Download .meridian file</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Outlined.FileDownload" OnClick="ExportXmi">Export XMI 2.5.1</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Outlined.Code" OnClick="ExportSysML">Export SysML v2 text</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Outlined.Image" OnClick="ExportSvg" Disabled="Ws.Active == null">Export diagram as SVG</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Outlined.Photo" OnClick="ExportImage" Disabled="Ws.Active == null">Export diagram as PNG…</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Outlined.ContentCopy" OnClick="CopyDiagramImage" Disabled="Ws.Active == null">Copy diagram as image</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Outlined.Schema" OnClick="ExportMermaid" Disabled="!CanExportMermaid" title="Activity, state machine, sequence, block definition and requirement diagrams">Export diagram as Mermaid (.mmd)</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Outlined.ContentCopy" OnClick="CopyMermaid" Disabled="!CanExportMermaid">Copy diagram as Mermaid</MudMenuItem>
            </ChildContent>
        </MudMenu>
        <BranchPicker />
        <CodeChangesBadge />
        <LibraryUpdatesBadge />

        <div class="cmdk" @onclick="() => _palette!.Show()">
            <MudIcon Icon="@Icons.Material.Outlined.Search" Style="font-size:16px" />
            <span class="cmdk-label">Search commands, diagrams, elements…</span>
            <kbd>⌘K</kbd>
        </div>

        <div class="presence">
            @foreach (var p in Ws.Others.GroupBy(o => o.User.Id).Select(g => g.First()).Take(6))
            {
                var element = p.SelectedId != null ? Ws.Model.Find(p.SelectedId) : null;
                <MudTooltip Text="@($"{p.User.DisplayName}{(element != null ? $" — on {element.DisplayName}" : "")}")">
                    <span class="avatar" style="background:@p.User.Color; cursor:pointer" @onclick="() => { if (element != null) Navigate(element); }">@MembersDialog.Initials(p.User)</span>
                </MudTooltip>
            }
        </div>
        <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Dense="true" Class="tb-help" PopoverClass="menu-fit" AriaLabel="Help">
            <ActivatorContent>
                <MudTooltip Text="Help: tour, keyboard shortcuts, what's new"><MudIconButton Size="Size.Small" Icon="@Icons.Material.Outlined.HelpOutline" aria-label="Help" data-testid="help-menu" /></MudTooltip>
            </ActivatorContent>
            <ChildContent>
                <MudMenuItem Icon="@Icons.Material.Outlined.Tour" OnClick="ShowTour" data-testid="help-tour">Tour…</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Outlined.SwapHoriz" OnClick="() => StartTourChapter(TourChapters.ComingFrom)">Coming from Cameo or EA</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Outlined.Keyboard" OnClick="ShowHelp">Keyboard &amp; mouse</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Outlined.Search" OnClick="() => _palette!.Show()">All commands… <Key>⌘K</Key></MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Outlined.NewReleases" OnClick="ShowWhatsNew">What's new in @TourChapters.WhatsNewVersion</MudMenuItem>
                <MudDivider />
                <MudMenuItem Icon="@Icons.Material.Outlined.Info" OnClick="ShowAbout">About Meridian</MudMenuItem>
            </ChildContent>
        </MudMenu>
        @if (!Host.LocalMode)
        {
            <NotificationBell />
        }
        @if (!Host.LocalMode)
        {
            <MudTooltip Text="Share & members"><button class="rbtn" style="height:30px" @onclick="ShareProject"><MudIcon Icon="@Icons.Material.Outlined.Group" /><span class="t">Share</span></button></MudTooltip>
        }
        <MudTooltip Text="Version history"><MudIconButton Size="Size.Small" Icon="@Icons.Material.Outlined.History" OnClick="ShowHistory" aria-label="Version history" /></MudTooltip>
        <div class="tb-actions">
            <MudTooltip Text="Undo (⌘Z)"><MudIconButton Size="Size.Small" Icon="@Icons.Material.Outlined.Undo" Disabled="!Ws.Model.History.CanUndo" OnClick="Undo" aria-label="Undo (⌘Z)" /></MudTooltip>
            <MudTooltip Text="Redo (⇧⌘Z)"><MudIconButton Size="Size.Small" Icon="@Icons.Material.Outlined.Redo" Disabled="!Ws.Model.History.CanRedo" OnClick="Redo" aria-label="Redo (⇧⌘Z)" /></MudTooltip>
            <MudTooltip Text="@(Ws.DarkMode ? "Light mode" : "Dark mode")">
                <MudIconButton Class="tb-theme" Size="Size.Small" Icon="@(Ws.DarkMode ? Icons.Material.Outlined.LightMode : Icons.Material.Outlined.DarkMode)" OnClick="ToggleTheme" aria-label="@(Ws.DarkMode ? "Light mode" : "Dark mode")" />
            </MudTooltip>
            <MudTooltip Text="Settings (⌘,)"><MudIconButton Class="tb-settings" Size="Size.Small" Icon="@Icons.Material.Outlined.Settings" OnClick="() => OpenSettings()" aria-label="Settings" /></MudTooltip>
            <button class="btn-primary" @onclick="Save" disabled="@Ws.ReadOnly" title="Save a named version you can compare or restore later. Your work is already saved automatically as you go."><MudIcon Icon="@Icons.Material.Outlined.Commit" Style="font-size:16px" /> Commit</button>
            @if (Ws.User is { } me)
            {
                <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Dense="true">
                    <ActivatorContent><span class="avatar me" style="background:@me.Color" title="@me.DisplayName">@MembersDialog.Initials(me)</span></ActivatorContent>
                    <ChildContent>
                        <MudText Typo="Typo.body2" Class="px-4 pt-2" Style="font-weight:600">@me.DisplayName</MudText>
                        <MudText Typo="Typo.caption" Class="px-4 pb-2" Style="opacity:.6">@me.Username</MudText>
                        <MudText Typo="Typo.caption" Class="px-4 pb-2" Style="opacity:.6">@(Host.LocalMode ? "Local workspace on this computer" : Nav.BaseUri.TrimEnd('/'))</MudText>
                        <MudDivider />
                        <MudMenuItem Icon="@Icons.Material.Outlined.Settings" OnClick="() => OpenSettings()">Settings… <Key>⌘,</Key></MudMenuItem>
                        @if (_desktop)
                        {
                            <MudMenuItem Icon="@Icons.Material.Outlined.SwapHoriz" OnClick="SwitchWorkspace">Switch workspace or server…</MudMenuItem>
                        }
                        @if (!Host.LocalMode)
                        {
                            <MudMenuItem Icon="@Icons.Material.Outlined.Key" OnClick="@(() => Dialogs.ShowAsync<ApiTokensDialog>("API tokens", new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true }))">API tokens…</MudMenuItem>
                            <Meridian.Web.Components.Admin.AdminMenuLink />
                            <MudMenuItem Icon="@Icons.Material.Outlined.Logout" OnClick="SignOut">Sign out</MudMenuItem>
                        }
                    </ChildContent>
                </MudMenu>
            }
        </div>
    </header>

    @* ================================================================ context toolbar *@
    <nav class="ribbon">
        <div class="rtabs" role="tablist" aria-label="Ribbon">
            @foreach (var (id, label) in RibbonTabs())
            {
                var tabId = id;
                <button role="tab" class="rtab @RibbonGroupClass(tabId)" data-tab="@tabId" aria-selected="@(ActiveRibbonTab == tabId ? "true" : "false")" @onclick="() => SelectRibbonTab(tabId)">@label</button>
            }
        </div>
        <div class="rgroup compact-md @RibbonGroupClass("create")" data-tab="create">
            <div class="rlabel">Create</div>
            <div class="ritems">
                @foreach (var k in new[] { ElementKind.Package, ElementKind.Block, ElementKind.InterfaceBlock, ElementKind.ValueType, ElementKind.Requirement, ElementKind.Actor, ElementKind.UseCase })
                {
                    var kind = k;
                    <MudTooltip Text="@($"New {Metamodel.DisplayName(kind)} in the selection (shown on the active diagram when it fits)")">
                        <button class="rbtn" @onclick="() => CreateFromRibbon(kind)"><MudIcon Icon="@UiKinds.Icon(kind)" Style="@($"color:{UiKinds.Accent(kind)}")" /><span class="t">@Metamodel.DisplayName(kind)</span></button>
                    </MudTooltip>
                }
            </div>
        </div>
        <div class="rgroup @RibbonGroupClass("diagram")" data-tab="diagram">
            <div class="rlabel">Diagram</div>
            <div class="ritems">
                @foreach (var t in new[] { DiagramType.Whiteboard, DiagramType.BlockDefinition, DiagramType.InternalBlock, DiagramType.Requirement, DiagramType.Activity, DiagramType.StateMachine, DiagramType.Sequence, DiagramType.UseCase, DiagramType.Package })
                {
                    var type = t;
                    <MudTooltip Text="@($"New {Metamodel.DisplayName(type)} for the selection")">
                        <button class="rbtn dtype" @onclick="() => NewDiagramSmart(type)"><MudIcon Icon="@UiKinds.DiagramIcon(type)" /><span class="t">@Metamodel.DiagramAbbreviation(type).ToUpperInvariant()</span></button>
                    </MudTooltip>
                }
                <MudMenu AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" Dense="true">
                    <ActivatorContent><button title="More diagram types" class="rbtn"><MudIcon Icon="@Icons.Material.Outlined.MoreHoriz" /><span class="t">More</span></button></ActivatorContent>
                    <ChildContent>
                        @foreach (var t in new[] { DiagramType.Parametric, DiagramType.Bpmn, DiagramType.ArchiMate, DiagramType.Database, DiagramType.Class, DiagramType.Timing, DiagramType.InteractionOverview, DiagramType.Communication })
                        {
                            var type = t;
                            <MudMenuItem Icon="@UiKinds.DiagramIcon(type)" OnClick="() => NewDiagramSmart(type)">@Metamodel.DisplayName(type)</MudMenuItem>
                        }
                    </ChildContent>
                </MudMenu>
                <MudTooltip Text="Automatic layout"><button class="rbtn" disabled="@(Ws.Active == null)" @onclick="() => Ws.Active?.Arrange()"><MudIcon Icon="@Icons.Material.Outlined.AutoAwesomeMosaic" /><span class="t">Arrange</span></button></MudTooltip>
                <MudTooltip Text="Diagram it all out: a package overview, structure, internal structure, requirements and behavior views, laid out automatically (⌘K “Diagram the whole model”)"><button class="rbtn" data-tour="auto-diagram" disabled="@Ws.ReadOnly" @onclick="() => AutoDiagram(Ws.Selected is { Kind: ElementKind.Package } p ? p : null)"><MudIcon Icon="@Icons.Material.Outlined.Dashboard" /><span class="t">Auto-diagram</span></button></MudTooltip>
                <MudMenu AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" Dense="true" Class="derive-menu">
                    <ActivatorContent><MudTooltip Text="Create a diagram from the selection: use cases from requirements, activity from a use case, sequence from an activity, BDD + IBD or a state machine from a sequence"><button class="rbtn" data-testid="ribbon-create-from" data-tour="create-from" disabled="@Ws.ReadOnly"><MudIcon Icon="@Icons.Material.Outlined.AccountTree" /><span class="t">Create from…</span></button></MudTooltip></ActivatorContent>
                    <ChildContent>
                        @foreach (var o in RibbonDerivations())
                        {
                            var offer = o;
                            <MudMenuItem Icon="@Icons.Material.Outlined.AccountTree" OnClick="() => DeriveAsync(offer)">@offer.Label (@offer.Source.DisplayName)</MudMenuItem>
                        }
                        @if (!RibbonDerivations().Any())
                        {
                            <MudMenuItem Disabled="true">Select a use case, activity, sequence, block or requirements</MudMenuItem>
                        }
                    </ChildContent>
                </MudMenu>
            </div>
        </div>
        <div class="rgroup compact @RibbonGroupClass("requirements")" data-tab="requirements">
            <div class="rlabel">Requirements</div>
            <div class="ritems">
                <button title="New test case in the selection" class="rbtn" @onclick="() => CreateFromRibbon(ElementKind.TestCase)"><MudIcon Icon="@UiKinds.Icon(ElementKind.TestCase)" Style="color:#3fbf7f" /><span class="t">Test case</span></button>
                <button title="Requirements table: every requirement with its attributes and coverage" class="rbtn @(_dockOpen && _dock == 1 ? "on" : "")" @onclick="() => ToggleDock(1)"><MudIcon Icon="@Icons.Material.Outlined.TableRows" /><span class="t">Table</span></button>
                <MudMenu AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" Dense="true">
                    <ActivatorContent><button title="Import or export requirements (ReqIF, CSV, Excel)" class="rbtn"><MudIcon Icon="@Icons.Material.Outlined.SwapVert" /><span class="t">Exchange</span></button></ActivatorContent>
                    <ChildContent>
                        <MudMenuItem Icon="@Icons.Material.Outlined.UploadFile" OnClick="ImportReqIfIntoSelection">Import ReqIF (.reqif / .reqifz)…</MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Outlined.UploadFile" OnClick="ImportCsvIntoSelection">Import CSV…</MudMenuItem>
                        <MudDivider />
                        <MudMenuItem Icon="@Icons.Material.Outlined.Download" OnClick="ExportReqIf">Export ReqIF</MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Outlined.Download" OnClick="ExportCsv">Export CSV</MudMenuItem>
                        <MudDivider />
                        <MudMenuItem Icon="@Icons.Material.Outlined.GridOn" OnClick="ExportRequirementsXlsx">Export Excel (.xlsx)</MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Outlined.Difference" OnClick="ImportRequirementsSheet" Disabled="Ws.ReadOnly">Re-import Excel / CSV with preview…</MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Outlined.FormatListNumbered" OnClick="RenumberRequirements" Disabled="Ws.ReadOnly">Renumber requirements…</MudMenuItem>
                    </ChildContent>
                </MudMenu>
            </div>
        </div>
        <div class="rgroup compact @RibbonGroupClass("trace")" data-tab="trace">
            <div class="rlabel">Traceability</div>
            <div class="ritems">
                <button title="Traceability matrix: requirements against design elements" class="rbtn @(_dockOpen && _dock == 2 ? "on" : "")" @onclick="() => ToggleDock(2)"><MudIcon Icon="@Icons.Material.Outlined.GridOn" /><span class="t">Matrix</span></button>
                <MudTooltip Text="Traceability table: links, gaps and suspect links per requirement"><button class="rbtn @(_dockOpen && _dock == 7 ? "on" : "")" @onclick="() => ToggleDock(7)"><MudIcon Icon="@Icons.Material.Outlined.Link" /><span class="t">Trace table</span></button></MudTooltip>
                <button title="Impact analysis: what depends on the selected element" class="rbtn" disabled="@(Ws.Selected == null)" @onclick="ImpactOfSelection"><MudIcon Icon="@Icons.Material.Outlined.CallSplit" /><span class="t">Impact</span></button>
                <button title="Requirements coverage: how many are satisfied and verified" class="rbtn" @onclick="Coverage"><MudIcon Icon="@Icons.Material.Outlined.DonutLarge" /><span class="t">Coverage</span></button>
                <button title="Check the model for errors and warnings (F7)" class="rbtn @(_dockOpen && _dock == 0 ? "on" : "")" @onclick="Validate"><MudIcon Icon="@Icons.Material.Outlined.FactCheck" /><span class="t">Validate</span></button>
            </div>
        </div>
        <div class="rgroup compact @RibbonGroupClass("review")" data-tab="review">
            <div class="rlabel">Review</div>
            <div class="ritems">
                <MudTooltip Text="@(Host.LocalMode ? "New review checklist for the selection" : "Request a review of the selection")">
                    <button class="rbtn" disabled="@(Ws.Session == null)" @onclick="() => RequestReview()"><MudIcon Icon="@Icons.Material.Outlined.RateReview" /><span class="t">Request</span></button>
                </MudTooltip>
                <button title="Open reviews and approvals" class="rbtn @(_dockOpen && _dock == ReviewsDock ? "on" : "")" @onclick="() => ToggleDock(ReviewsDock)"><MudIcon Icon="@Icons.Material.Outlined.Checklist" /><span class="t">Reviews</span></button>
            </div>
        </div>
        <Meridian.Web.Components.Workbench.Database.DatabaseRibbonGroup Active="@(ActiveRibbonTab == "database")" />
        <div class="rgroup compact @RibbonGroupClass("views")" data-tab="views">
            <div class="rlabel">Model views</div>
            <div class="ritems">
                <MudTooltip Text="Generic table: any element kind as rows, chosen columns, inline editing"><button class="rbtn @(TablesTabActive(TablesPanel.Mode.Table) ? "on" : "")" @onclick="() => ToggleTables(TablesPanel.Mode.Table)"><MudIcon Icon="@Icons.Material.Outlined.TableChart" /><span class="t">Generic table</span></button></MudTooltip>
                <MudTooltip Text="Model query / search builder"><button class="rbtn @(TablesTabActive(TablesPanel.Mode.Query) ? "on" : "")" @onclick="() => ToggleTables(TablesPanel.Mode.Query)"><MudIcon Icon="@Icons.Material.Outlined.ManageSearch" /><span class="t">Query</span></button></MudTooltip>
                <MudTooltip Text="@(LibState.Updates.Count > 0 ? $"{LibState.Updates.Count} used project update(s) available — review" : "Used projects (shared libraries): check for updates")">
                    <button class="rbtn lib-rbtn" disabled="@(Ws.Session == null)" data-testid="ribbon-libraries" data-tour="used-projects"
                            @onclick="@(() => LibState.Updates.Count > 0 ? UpdateUsedProject() : CheckLibraryUpdates())">
                        <MudIcon Icon="@Icons.Material.Outlined.LibraryBooks" /><span class="t">Used projects</span>
                        @if (LibState.Updates.Count > 0) { <span class="lib-count">@LibState.Updates.Count</span> }
                    </button>
                </MudTooltip>
            </div>
        </div>
        <div class="rgroup compact @RibbonGroupClass("simulate")" data-tab="simulate">
            <div class="rlabel">Simulate</div>
            <div class="ritems">
                <button title="Step through activities and state machines, timed or Monte Carlo" class="rbtn @(_dockOpen && _dock == 5 ? "on" : "")" @onclick="() => ToggleDock(5)"><MudIcon Icon="@Icons.Material.Outlined.PlayCircle" /><span class="t">Simulate</span></button>
                <button title="Solve parametric constraints" class="rbtn @(_dockOpen && _dock == 6 ? "on" : "")" @onclick="() => ToggleDock(6)"><MudIcon Icon="@Icons.Material.Outlined.Functions" /><span class="t">Parametrics</span></button>
                <button title="Product variants and trade studies" class="rbtn @(_dockOpen && _dock == 11 ? "on" : "")" @onclick="() => ToggleDock(11)"><MudIcon Icon="@Icons.Material.Outlined.Balance" /><span class="t">Variants</span></button>
                <button title="Verify requirements: evaluate their criteria with parametrics, Monte Carlo, timed simulation or co-simulation" class="rbtn @(_dockOpen && _dock == VerificationDock ? "on" : "")" data-tour="verify" disabled="@Ws.Verification.Running" @onclick="VerifyRequirements"><MudIcon Icon="@Icons.Material.Outlined.Rule" /><span class="t">Verify</span></button>
            </div>
        </div>
        <div class="rgroup compact @RibbonGroupClass("generate")" data-tab="generate">
            <div class="rlabel">Generate</div>
            <div class="ritems">
                <MudTooltip Text="Generate a document (SRS, ICD, SDD, VCRM …) from a template as PDF, Word or HTML"><button class="rbtn" @onclick="ExportDocx"><MudIcon Icon="@Icons.Material.Outlined.Article" /><span class="t">Report</span></button></MudTooltip>
                <button title="Export the model as SysML v2 text" class="rbtn" @onclick="ExportSysML"><MudIcon Icon="@Icons.Material.Outlined.Code" /><span class="t">SysML v2</span></button>
                <MudTooltip Text="Edit as SysML v2 text — the selected package, live-synced with the model"><button class="rbtn @(_dockOpen && _dock == 12 ? "on" : "")" @onclick="EditAsSysml"><MudIcon Icon="@Icons.Material.Outlined.EditNote" /><span class="t">Edit text</span></button></MudTooltip>
                <button title="Export XMI 2.5.1 for other tools" class="rbtn" @onclick="ExportXmi"><MudIcon Icon="@Icons.Material.Outlined.SwapHoriz" /><span class="t">XMI</span></button>
                <button title="Generate C# code from blocks" class="rbtn" @onclick="GenerateCode"><MudIcon Icon="@Icons.Material.Outlined.DataObject" /><span class="t">C#</span></button>
                <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Dense="true">
                    <ActivatorContent><button title="More export formats: Word/PDF, BPMN, ArchiMate, ReqIF, SQL" class="rbtn"><MudIcon Icon="@Icons.Material.Outlined.MoreHoriz" /><span class="t">Formats</span></button></ActivatorContent>
                    <ChildContent>
                        <MudMenuItem Icon="@Icons.Material.Outlined.Description" OnClick="GenerateSdd">Generate SDD (System Design Description)…</MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Outlined.Description" OnClick="ExportDocx">Word / PDF / HTML document from template…</MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Outlined.OpenInNew" OnClick="OpenReport">Quick HTML model report</MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Outlined.AccountTree" OnClick="ExportBpmn" Disabled="@(Ws.Active?.Diagram.DiagramType != DiagramType.Bpmn)">BPMN 2.0 XML (active diagram)</MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Outlined.Schema" OnClick="ExportMermaid" Disabled="!CanExportMermaid">Mermaid .mmd (active diagram)</MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Outlined.Layers" OnClick="ExportArchiMate">ArchiMate exchange file</MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Outlined.Assignment" OnClick="ExportReqIf">ReqIF</MudMenuItem>
                        <MudDivider />
                        @foreach (var d in Enum.GetValues<Meridian.Serialization.SqlDialect>())
                        {
                            var dialect = d;
                            <MudMenuItem Icon="@Icons.Material.Outlined.Storage" OnClick="() => ExportDdl(dialect)">SQL DDL — @dialect</MudMenuItem>
                        }
                    </ChildContent>
                </MudMenu>
            </div>
        </div>
        <PluginsMenu @ref="_plugins" Active="@(ActiveRibbonTab == "extend")" ScriptOpen="@(_dockOpen && _dock == 10)" OnScript="() => ToggleDock(10)" />
        <div class="rgroup compact @RibbonGroupClass("ai")" data-tab="ai">
            <div class="rlabel">AI</div>
            <div class="ritems">
                <MudTooltip Text="Ask the assistant about this model — ⌘K “Ask the assistant”"><button class="rbtn @(_dockOpen && _dock == AssistantDock ? "on" : "")" data-tour="assistant" @onclick="ToggleAssistant"><MudIcon Icon="@Icons.Material.Outlined.AutoAwesome" /><span class="t">Assistant</span></button></MudTooltip>
                <MudTooltip Text="The assistant picks and names the diagrams that tell the model's story; you accept or reject each one"><button class="rbtn" data-testid="ribbon-ai-diagram" @onclick="() => RunAssistant(Meridian.Web.Services.QuickAction.DiagramModel)"><MudIcon Icon="@Icons.Material.Outlined.AccountTree" /><span class="t">Diagram my model</span></button></MudTooltip>
                <MudTooltip Text="Describe a system or process in words and get a diagram"><button class="rbtn" @onclick="() => RunAssistant(Meridian.Web.Services.QuickAction.DiagramFromDescription)"><MudIcon Icon="@Icons.Material.Outlined.Schema" /><span class="t">Diagram from text</span></button></MudTooltip>
                <MudTooltip Text="Paste a specification and get requirements to review"><button class="rbtn" @onclick="() => RunAssistant(Meridian.Web.Services.QuickAction.GenerateRequirements)"><MudIcon Icon="@Icons.Material.Outlined.PlaylistAdd" /><span class="t">Requirements from text</span></button></MudTooltip>
                <MudTooltip Text="Suggest satisfy and verify links for requirements without them"><button class="rbtn" @onclick="() => RunAssistant(Meridian.Web.Services.QuickAction.SuggestTraceLinks)"><MudIcon Icon="@Icons.Material.Outlined.Link" /><span class="t">Suggest links</span></button></MudTooltip>
                <MudTooltip Text="Review the model for gaps, inconsistencies and naming problems"><button class="rbtn" @onclick="() => RunAssistant(Meridian.Web.Services.QuickAction.ReviewModel)"><MudIcon Icon="@Icons.Material.Outlined.Rule" /><span class="t">Review model</span></button></MudTooltip>
            </div>
        </div>
        @if (Ws.CodeChanges is not null || HasArchitecture)
        {
            <div class="rgroup compact @RibbonGroupClass("code")" data-tab="code" data-tour="code-group">
                <div class="rlabel">Code</div>
                <div class="ritems">
                    @if (Ws.CodeChanges is not null)
                    {
                    <MudTooltip Text="Code changes from connected repositories to accept or reject"><button class="rbtn @(Ws.ActiveView?.Kind == ViewTabKind.CodeChanges ? "on" : "")" @onclick="OpenCodeChanges"><MudIcon Icon="@Icons.Material.Outlined.Difference" /><span class="t">Code changes</span></button></MudTooltip>
                    <MudTooltip Text="Highlight code changes on diagrams (⌘K “Highlight code changes”)"><button class="rbtn @(Ws.HighlightCodeChanges ? "on" : "")" @onclick="ToggleCodeHighlights"><MudIcon Icon="@Icons.Material.Outlined.Highlight" /><span class="t">Highlight</span></button></MudTooltip>
                    }
                    @if (HasArchitecture)
                    {
                    <MudTooltip Text="Check architecture: the last synced code against this model (⌘K “Check architecture”)"><button class="rbtn arch-ribbon @(Ws.ActiveView?.Kind == ViewTabKind.Architecture ? "on" : "")" @onclick="CheckArchitecture"><MudIcon Icon="@Icons.Material.Outlined.Rule" /><span class="t">Architecture</span></button></MudTooltip>
                    }
                </div>
            </div>
        }
    </nav>

    @* ================================================================ workspace *@
    <main class="workbench">
        <section class="card"><ModelTree @ref="_tree" /></section>
        <div class="splitter" @ref="_leftSplitter"></div>

        <section class="card center">
            <div class="tabstrip">
                @foreach (var c in Ws.OpenDiagrams)
                {
                    var ctl = c;
                    <div class="tab @(Ws.ActiveView == null && ReferenceEquals(Ws.Active, ctl) ? "active" : "")" @onclick="() => Ws.Activate(ctl)" title="@ctl.Diagram.QualifiedName">
                        <MudIcon Icon="@UiKinds.DiagramIcon(ctl.Diagram.DiagramType)" Style="color:var(--accent-2)" />
                        <span>@ctl.Diagram.Name</span>
                        @if (IsStale(ctl.Diagram)) { <span class="derive-dot" title="Its source changed: update from source" data-testid="derive-dot"></span> }
                        <span class="x" @onclick="() => Ws.Close(ctl)" @onclick:stopPropagation="true"><MudIcon Icon="@Icons.Material.Filled.Close" Style="font-size:14px" /></span>
                    </div>
                }
                @foreach (var v in Ws.OpenViews)
                {
                    var view = v;
                    <div class="tab view-tab @(ReferenceEquals(Ws.ActiveView, view) ? "active" : "")" @onclick="() => Ws.ActivateView(view)" title="@view.Title">
                        <MudIcon Icon="@ViewTabIcon(view)" Style="color:var(--accent-2)" />
                        <span>@view.Title</span>
                        <span class="x" @onclick="() => Ws.CloseView(view)" @onclick:stopPropagation="true"><MudIcon Icon="@Icons.Material.Filled.Close" Style="font-size:14px" /></span>
                    </div>
                }
                <MudMenu Class="newtab" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" Dense="true">
                    <ActivatorContent><MudTooltip Text="New diagram"><MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Add" aria-label="New diagram" /></MudTooltip></ActivatorContent>
                    <ChildContent>
                        @foreach (var t in Enum.GetValues<DiagramType>())
                        {
                            var type = t;
                            <MudMenuItem Icon="@UiKinds.DiagramIcon(type)" OnClick="() => NewDiagramSmart(type)">@Metamodel.DisplayName(type)</MudMenuItem>
                        }
                        <MudDivider />
                        <MudMenuItem Icon="@Icons.Material.Outlined.AddChart" OnClick="NewDiagramFromTemplate" Disabled="Ws.ReadOnly">From template…</MudMenuItem>
                    </ChildContent>
                </MudMenu>
            </div>

            <div class="crumbs">
                <MudTooltip Text="Back"><MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.ArrowBack" Disabled="!Ws.CanGoBack" OnClick="Ws.GoBack" aria-label="Back" /></MudTooltip>
                <MudTooltip Text="Forward"><MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.ArrowForward" Disabled="!Ws.CanGoForward" OnClick="Ws.GoForward" aria-label="Forward" /></MudTooltip>
                @if (Ws.ActiveView is { } shownView)
                {
                    <span class="crumb current">@shownView.Title</span>
                    <span class="dtype">@(shownView.Kind switch { ViewTabKind.Table => "TABLE", ViewTabKind.Query => "QUERY", ViewTabKind.CodeChanges => "CODE SYNC", ViewTabKind.Architecture => "ARCHITECTURE", _ => "TEMPLATE" })</span>
                }
                else if (Ws.Active is { } act)
                {
                    foreach (var a in act.Diagram.AncestorsAndSelf().Skip(1).Reverse())
                    {
                        var anc = a;
                        <span class="crumb" title="@(anc.OwnedElements.OfType<Diagram>().Any(d => !ReferenceEquals(d, act.Diagram)) ? "Open its diagram" : "Select")" @onclick="() => Crumb(anc)">@anc.DisplayName</span>
                        <span class="sep">›</span>
                    }
                    <span class="crumb current">@act.Diagram.Name</span>
                    <span class="dtype">@Metamodel.DiagramAbbreviation(act.Diagram.DiagramType).ToUpperInvariant()</span>
                    <DerivedSourceBadge Diagram="act.Diagram" OnUpdate="UpdateFromSource" />
                    <span class="spacer"></span>
                    <MudTooltip Text="Zoom out"><MudIconButton Size="Size.Small" Icon="@Icons.Material.Outlined.Remove" OnClick="() => act.SetZoom(act.Zoom / 1.2)" aria-label="Zoom out" /></MudTooltip>
                    <span class="zoom">@act.Zoom.ToString("P0", System.Globalization.CultureInfo.InvariantCulture)</span>
                    <MudTooltip Text="Zoom in"><MudIconButton Size="Size.Small" Icon="@Icons.Material.Outlined.Add" OnClick="() => act.SetZoom(act.Zoom * 1.2)" aria-label="Zoom in" /></MudTooltip>
                    <MudTooltip Text="Fit"><MudIconButton Size="Size.Small" Icon="@Icons.Material.Outlined.FitScreen" OnClick="act.ZoomToFit" aria-label="Fit" /></MudTooltip>
                }
                else
                {
                    <span class="crumb current">No diagram open</span>
                }
            </div>

            <div class="diagram-host">
                @* A view tab lies over the canvas: the diagram stays mounted (no teardown, zoom and scroll kept). *@
                @if (Ws.ActiveView is { } openView)
                {
                    <div class="view-host" @key="openView.Id">@ViewTabContent(openView)</div>
                }
                @if (Ws.Active is { } active)
                {
                    <DiagramView C="active" OnContextMenu="ShowCanvasMenu" />
                }
                else
                {
                    <EmptyProjectHint OnAction="EmptyProjectAction" />
                }
            </div>

            <div class="dock">
                <div class="hsplitter" @ref="_bottomSplitter" style="@(_dockOpen ? "" : "display:none")"></div>
                <div class="dock-tabs">
                    @{ var h = Ws.Health; }
                    @DockTab(0, "Validation", Icons.Material.Outlined.FactCheck, h.Errors + h.Warnings)
                    @DockTab(1, "Requirements", Icons.Material.Outlined.TableRows, null, "Requirements table")
                    @DockTab(2, "Matrix", Icons.Material.Outlined.GridOn, null, "Traceability matrix")
                    @DockTab(4, "Impact", Icons.Material.Outlined.CallSplit, null, "Impact analysis")
                    @DockTab(5, "Simulation", Icons.Material.Outlined.PlayCircle, null)
                    @DockTab(6, "Parametrics", Icons.Material.Outlined.Functions, null)
                    @DockTab(7, "Trace table", Icons.Material.Outlined.Link, null, "Traceability table")
                    @DockTab(ReviewsDock, "Reviews", Icons.Material.Outlined.Checklist, null)
                    @DockTab(10, "Script", Icons.Material.Outlined.DataObject, null, "C# script console")
                    @DockTab(11, "Variants", Icons.Material.Outlined.Balance, null, "Variants & trade studies")
                    @DockTab(VerificationDock, "Verification", Icons.Material.Outlined.Rule, null, "Simulation-driven requirement verification")
                    @DockTab(12, "SysML text", Icons.Material.Outlined.Code, null, "SysML v2 text editor")
                    @DockTab(AssistantDock, "Assistant", Icons.Material.Outlined.AutoAwesome, null, "AI assistant")
                    @DockTab(3, "Output", Icons.Material.Outlined.Terminal, null)
                    <span style="flex:1"></span>
                    <MudIconButton Size="Size.Small" Icon="@(_dockOpen ? Icons.Material.Filled.KeyboardArrowDown : Icons.Material.Filled.KeyboardArrowUp)" OnClick="() => _dockOpen = !_dockOpen" aria-label="@(_dockOpen ? "Hide the panel" : "Show the panel")" title="@(_dockOpen ? "Hide the panel" : "Show the panel")" />
                </div>
                @if (_dockOpen)
                {
                    <div class="dock-body">
                        @switch (_dock)
                        {
                            case 0: <ValidationPanel @ref="_validation" />; break;
                            case 1: <RequirementsPanel />; break;
                            case 2: <MatrixPanel />; break;
                            case 4: <ImpactPanel />; break;
                            case 5: <SimulationPanel />; break;
                            case 6: <ParametricsPanel />; break;
                            case 7: <TraceabilityPanel />; break;
                            case ReviewsDock: <ReviewsPanel Focus="_reviewFocus" />; break;
                            case 10: <ScriptPanel />; break;
                            case 11: <VariantsPanel />; break;
                            case VerificationDock: <VerificationPanel />; break;
                            case 12: <SysmlTextPanel State="_sysml" />; break;
                            case AssistantDock: <AssistantPanel Launcher="_assistant" />; break;
                            default: <pre class="output">@string.Join("\n", Ws.Output)</pre>; break;
                        }
                    </div>
                }
            </div>
        </section>

        <div class="splitter" @ref="_rightSplitter"></div>
        <aside class="stack">
            <section class="card" style="flex:1.35"><Inspector /></section>
            <section class="card" style="flex:1"><RequirementsSide /></section>
        </aside>
    </main>

    @* ================================================================ status bar *@
    <footer class="statusbar">
        @{ var health = Ws.Health; var color = health.Errors > 0 ? "var(--danger)" : health.Warnings > 0 ? "var(--warn)" : "var(--ok)"; }
        <span class="item" style="cursor:pointer" @onclick="Validate" title="Model health — click to validate">
            <span class="health" style="background:@color; box-shadow:0 0 0 3px @(health.Errors > 0 ? "rgba(255,107,107,.18)" : health.Warnings > 0 ? "rgba(240,180,41,.18)" : "rgba(63,191,127,.18)")"></span>
            @(health.Errors == 0 && health.Warnings == 0 ? "Model healthy" : $"{health.Errors} errors · {health.Warnings} warnings")
        </span>
        <span class="msg">@Ws.Status</span>
        <ReportJobsStatus />
        <span class="item">@Counts()</span>
        <span class="item"><MudIcon Icon="@Icons.Material.Outlined.CloudDone" Style="font-size:14px" /> @SavedText()</span>
    </footer>

    @* ================================================================ phone / tablet shell (Components/Mobile, mobile.css) *@
    <MobileShell />

    <ContextMenu Entries="_menu" X="_menuX" Y="_menuY" OnClose="() => _menu = null" />
    <CommandPalette @ref="_palette" Source="PaletteCommands" />
    <OnboardingTour @ref="_tour" OnReveal="RevealForTour" />

    <div style="display:none">
        <InputFile id="file-open" accept=".meridian,.json,.xmi,.xml,.uml,.sysml,.qea,.qeax,.mdzip,.mdxml,.mmd,.mermaid,.md" OnChange="OnOpenFile" />
        <InputFile id="file-reqif" accept=".reqif,.reqifz,.xml" OnChange="OnReqIfFile" />
        <InputFile id="file-into" accept=".bpmn,.xml,.sql,.ddl,.dacpac,.cs,.zip,.mdzip,.mdxml,.mmd,.mermaid,.md" multiple OnChange="OnImportInto" />
        <InputFile id="file-csv" accept=".csv,text/csv" OnChange="OnCsvFile" />
        <InputFile id="file-req-sheet" accept=".xlsx,.csv" OnChange="OnRequirementsSheetFile" />
    </div>
</div>
</CascadingValue>

@code {
    private static string ViewTabIcon(ViewTab v) => v.Kind switch
    {
        ViewTabKind.Table => Icons.Material.Outlined.TableChart,
        ViewTabKind.Query => Icons.Material.Outlined.ManageSearch,
        ViewTabKind.CodeChanges => Icons.Material.Outlined.Difference,
        ViewTabKind.Architecture => Icons.Material.Outlined.Rule,
        _ => Icons.Material.Outlined.EditNote,
    };

    /// <summary>The content of a view tab: a table or query (TablesPanel), or the report template editor.</summary>
    private RenderFragment ViewTabContent(ViewTab v) => __builder =>
    {
        if (v.Kind is ViewTabKind.Table or ViewTabKind.Query)
        {
            var request = v.State as TablesPanel.Request ?? new TablesPanel.Request(v.Kind == ViewTabKind.Table ? TablesPanel.Mode.Table : TablesPanel.Mode.Query, v.Element);
            v.State = request;
            <TablesPanel Open="request" CurrentChanged="e => { if (!ReferenceEquals(v.Element, e)) { v.Element = e; InvokeAsync(StateHasChanged); } }" />
        }
        else if (v.Kind == ViewTabKind.CodeChanges)
        {
            <CodeChangesTab />
        }
        else if (v.Kind == ViewTabKind.Architecture)
        {
            <ArchitectureTab />
        }
        else if (v.State is Meridian.Serialization.Reports.DocTemplate template)
        {
            <ReportTemplateEditor Template="template" Element="v.Element"
                                  OnSaved="e => { v.Element = e; StateHasChanged(); }" OnClose="() => Ws.CloseView(v)" />
        }
    };


    private RenderFragment DockTab(int index, string label, string icon, int? count, string? tip = null) => __builder =>
    {
        <span class="dock-tab @(_dockOpen && _dock == index ? "on" : "")" @onclick="() => ToggleDock(index)" title="@(tip ?? label)">
            <MudIcon Icon="@icon" /><span class="dl">@label</span>
            @if (count is > 0) { <span class="count">@count</span> }
        </span>
    };
}

@inject Workspace Ws

@* Package context menu ▸ Permissions… (docs/PERMISSIONS.md) *@
<MudDialog>
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Outlined.Lock" />
            <MudText Typo="Typo.h6">Permissions — “@Package.DisplayName”</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <PackagePermissionsEditor Package="Package" />
    </DialogContent>
    <DialogActions><MudButton OnClick="() => MudDialog.Close()" data-testid="perm-done">Done</MudButton></DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter, EditorRequired] public Element Package { get; set; } = default!;
}

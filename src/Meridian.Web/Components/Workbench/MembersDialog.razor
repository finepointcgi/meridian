@using Meridian.Data
@inject IMeridianStore Db
@inject Workspace Ws
@inject Meridian.Web.Admin.IAuditLog Audit

<MudDialog>
    <TitleContent><div class="d-flex align-center gap-2"><MudIcon Icon="@Icons.Material.Outlined.Group" /><MudText Typo="Typo.h6">Share “@Ws.Session?.Name”</MudText></div></TitleContent>
    <DialogContent>
        @if (_canManage)
        {
            <div class="d-flex gap-2 align-start">
                <MudTextField T="string" @bind-Value="_username" Placeholder="Username" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
                <MudSelect T="ProjectRole" @bind-Value="_role" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:130px">
                    <MudSelectItem Value="ProjectRole.Editor">Editor</MudSelectItem>
                    <MudSelectItem Value="ProjectRole.Viewer">Viewer</MudSelectItem>
                    <MudSelectItem Value="ProjectRole.Owner">Owner</MudSelectItem>
                </MudSelect>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="string.IsNullOrWhiteSpace(_username)" OnClick="Add" Class="mt-1">Invite</MudButton>
            </div>
            @if (_error != null) { <MudText Typo="Typo.caption" Color="Color.Error">@_error</MudText> }
        }
        <MudList T="string" Dense="true" Class="mt-2">
            @foreach (var m in _members)
            {
                var member = m;
                <MudListItem T="string">
                    <div class="d-flex align-center gap-3">
                        <span class="avatar" style="background:@member.User.Color">@Initials(member.User)</span>
                        <div style="flex:1">
                            <div style="font-weight:600">@member.User.DisplayName @(member.User.Id == Ws.User?.Id ? "(you)" : "")</div>
                            <div style="font-size:11.5px; opacity:.65">@member.User.Username</div>
                        </div>
                        @if (_canManage && member.User.Id != Ws.User?.Id)
                        {
                            <MudSelect T="ProjectRole" Value="member.Role" ValueChanged="r => SetRole(member, r)" Dense="true" Variant="Variant.Text" Style="max-width:110px">
                                <MudSelectItem Value="ProjectRole.Viewer">Viewer</MudSelectItem>
                                <MudSelectItem Value="ProjectRole.Editor">Editor</MudSelectItem>
                                <MudSelectItem Value="ProjectRole.Owner">Owner</MudSelectItem>
                            </MudSelect>
                            <MudIconButton Size="Size.Small" Icon="@Icons.Material.Outlined.PersonRemove" OnClick="() => Remove(member)" />
                        }
                        else
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@member.Role</MudChip>
                        }
                    </div>
                </MudListItem>
            }
        </MudList>
        <MudText Typo="Typo.caption" Style="opacity:.65">Viewers can browse, comment and export. Editors can change the model. Owners can also manage members and delete the project.</MudText>
    </DialogContent>
    <DialogActions><MudButton OnClick="() => MudDialog.Close()">Done</MudButton></DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public Guid ProjectId { get; set; }
    private IReadOnlyList<ProjectMember> _members = [];
    private string? _username;
    private string? _error;
    private ProjectRole _role = ProjectRole.Editor;
    private bool _canManage;

    protected override async Task OnInitializedAsync()
    {
        _canManage = Ws.Role == ProjectRole.Owner;
        await Reload();
    }

    private async Task Reload() => _members = await Db.MembersAsync(ProjectId);

    public static string Initials(UserAccount u) =>
        string.Concat(u.DisplayName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => char.ToUpperInvariant(w[0])));

    private async Task Add()
    {
        _error = null;
        var user = await Db.FindUserAsync(_username!);
        if (user is null) { _error = $"No user called “{_username}”. They need to create an account first."; return; }
        await Db.SetMemberAsync(ProjectId, user.Id, _role);
        await Audit.RecordAsync(Meridian.Web.Admin.AuditActions.MemberSet, Ws.User, ProjectId, Ws.Session?.Name, target: user.Username, details: new { role = _role.ToString().ToLowerInvariant() });
        _username = null;
        await Reload();
    }

    private async Task SetRole(ProjectMember m, ProjectRole r)
    {
        await Db.SetMemberAsync(ProjectId, m.User.Id, r);
        await Audit.RecordAsync(Meridian.Web.Admin.AuditActions.MemberSet, Ws.User, ProjectId, Ws.Session?.Name, target: m.User.Username, details: new { role = r.ToString().ToLowerInvariant(), from = m.Role.ToString().ToLowerInvariant() });
        await Reload();
    }

    private async Task Remove(ProjectMember m)
    {
        if (_members.Count(x => x.Role == ProjectRole.Owner) == 1 && m.Role == ProjectRole.Owner) { _error = "A project needs at least one owner."; return; }
        await Db.RemoveMemberAsync(ProjectId, m.User.Id);
        await Audit.RecordAsync(Meridian.Web.Admin.AuditActions.MemberRemove, Ws.User, ProjectId, Ws.Session?.Name, target: m.User.Username);
        await Reload();
    }
}

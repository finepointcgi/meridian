@* Help ▸ Keyboard & mouse: the shortcut reference (KeyboardShortcuts), scrolling inside the dialog on small windows. *@
<MudDialog Class="kbd-help" ContentStyle="max-height:min(62vh, 560px); overflow:auto; padding-top:0">
    <TitleContent>
        <div class="d-flex align-center gap-2"><MudIcon Icon="@Icons.Material.Outlined.Keyboard" /><MudText Typo="Typo.h6">Keyboard &amp; mouse</MudText></div>
    </TitleContent>
    <DialogContent>
        <div class="kbd-note">On Windows and Linux use <b>Ctrl</b> wherever this shows ⌘.</div>
        @foreach (var section in KeyboardShortcuts.All)
        {
            <h4 class="kbd-section">@section.Title</h4>
            <table class="kbd-table" data-section="@section.Title">
                @foreach (var (keys, action) in section.Rows)
                {
                    <tr><td class="kbd-keys"><kbd>@keys</kbd></td><td>@action</td></tr>
                }
            </table>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="() => MudDialog.Close()">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
}

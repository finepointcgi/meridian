@inherits WorkspaceComponent
@using Microsoft.AspNetCore.Components.Web.Virtualization

<div class="card-header">
    <MudIcon Icon="@Icons.Material.Outlined.AccountTree" Style="font-size:15px" />
    <span style="flex:1">Model explorer</span>
    <MudTooltip Text="@(ShowRelationships ? "Hide relationships" : "Show relationships")">
        <MudIconButton Size="Size.Small" Icon="@(ShowRelationships ? Icons.Material.Outlined.Link : Icons.Material.Outlined.LinkOff)" OnClick="ToggleRelationships" />
    </MudTooltip>
    <MudTooltip Text="Collapse all"><MudIconButton Size="Size.Small" Icon="@Icons.Material.Outlined.UnfoldLess" OnClick="CollapseAll" /></MudTooltip>
</div>
<div class="px-3 pb-2">
    <MudTextField T="string" @ref="_search" Value="_query" ValueChanged="Search" Immediate="true" DebounceInterval="SearchDebounce"
                  Placeholder="Search elements…" Variant="Variant.Outlined" Margin="Margin.Dense"
                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Search" Clearable="true" />
</div>
<div class="chips">
    @foreach (var f in Filters)
    {
        var filter = f;
        <span class="chip @(_filter == filter.Name ? "on" : "")" @onclick="() => _filter = filter.Name">@filter.Name</span>
    }
    @if (Meridian.Core.DataModeling.DbModel.HasDataModel(Ws.Model))
    {
        @* Data models: every table, or the tables of one subject area. *@
        <span class="chip @(_filter == DataFilter ? "on" : "")" @onclick="() => _filter = DataFilter" data-testid="tree-filter-data">Data</span>
        @foreach (var g in Meridian.Core.DataModeling.DbModel.Groups(Ws.Model))
        {
            var key = "group:" + g.Id;
            <span class="chip @(_filter == key ? "on" : "")" @onclick="() => _filter = key" data-group="@g.Name" title="Tables of the subject area @g.Name">
                <span style="display:inline-block; width:8px; height:8px; border-radius:2px; background:@Meridian.Core.DataModeling.DbModel.ColorOf(g); margin-right:4px"></span>@g.Name
            </span>
        }
    }
</div>

<div class="card-body">
    @{ var favorites = Ws.FavoriteElements.ToList(); }
    @if (favorites.Count > 0 && _hits == null)
    {
        <div class="section-label"><MudIcon Icon="@Icons.Material.Filled.Star" Style="font-size:13px; color:#f0b429" /> Favorites</div>
        @foreach (var f in favorites) { @FlatItem(f) }
        <div class="section-label">Model</div>
    }

    @if (_hits != null)
    {
        <div class="section-label">@_hits.Count result@(_hits.Count == 1 ? "" : "s")</div>
        @foreach (var h in _hits) { @FlatItem(h) }
    }
    else if (_filter != "All")
    {
        var items = FilteredItems();
        <Virtualize Items="items" ItemSize="46" OverscanCount="10" Context="e">@FlatItem(e)</Virtualize>
        if (items.Count == 0) { <div class="section-label" style="text-transform:none; letter-spacing:0">Nothing here yet.</div> }
    }
    else
    {
        @* Windowed rendering: only the rows in (and near) the viewport exist in the DOM, however big the model is. *@
        <div class="mtree" role="tree" style="padding:2px 0 12px">
            <Virtualize Items="_rows" ItemSize="RowHeight" OverscanCount="20" Context="row">
                @TreeRow(row)
            </Virtualize>
        </div>
    }
</div>

@code {
    private static readonly (string Name, ElementKind[] Kinds)[] Filters =
    [
        ("All", []),
        ("Diagrams", [ElementKind.Diagram]),
        ("Requirements", [ElementKind.Requirement, ElementKind.TestCase]),
        ("Structure", [ElementKind.Block, ElementKind.InterfaceBlock, ElementKind.ValueType, ElementKind.ConstraintBlock, ElementKind.Class, ElementKind.Interface, ElementKind.DataType, ElementKind.Enumeration, ElementKind.Component]),
        ("Behavior", [ElementKind.Actor, ElementKind.UseCase, ElementKind.Activity, ElementKind.StateMachine]),
    ];

    /// <summary>Fixed row height (px) the virtualizer uses; matches <c>.mtree-row</c> in app.css.</summary>
    private const float RowHeight = 26;

    /// <summary>One visible line of the tree: an element at a depth. Children are only flattened for expanded branches.</summary>
    private sealed record Row(Element Element, int Depth, bool Expandable);

    private List<Row> _rows = new();
    private readonly HashSet<string> _expanded = new();
    private int _builtTreeVersion = -1;
    private Element? _revealed;
    private ModelRepository? _builtFor;
    private string? _query;
    private int _hitsVersion = -1;
    private string _filter = "All";
    private const string DataFilter = "Data";
    private List<Element>? _hits;
    private (string Filter, int Version) _filteredKey;
    private List<Element> _filtered = new();
    private Element? _dropTarget;
    private MudTextField<string>? _search;
    public bool ShowRelationships { get; private set; }

    /// <summary>Small models search on every keystroke; large ones wait for a pause in typing.</summary>
    private int SearchDebounce => Ws.Model.Count > 5_000 ? 250 : 120;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Sync();
    }

    protected override void OnWorkspaceChanged() => Sync();

    /// <summary>
    /// Brings the rows up to date. The flattened rows are rebuilt only when the tree's shape or sort keys changed
    /// (<see cref="Workspace.TreeVersion"/>) or the selection moved into a collapsed branch; selection, presence and other
    /// workspace bumps only re-render the visible rows.
    /// </summary>
    private void Sync()
    {
        if (!ReferenceEquals(_builtFor, Ws.Model))
        {
            _expanded.Clear();
            _expanded.Add(Ws.Model.Root.Id);
            foreach (var c in Ws.Model.Root.OwnedElements) _expanded.Add(c.Id);
            _builtFor = Ws.Model;
            _builtTreeVersion = -1;
            _revealed = null;
        }
        var reveal = !ReferenceEquals(_revealed, Ws.Selected) && RevealSelected();
        if (_builtTreeVersion != Ws.TreeVersion || reveal) Rebuild();
        if (_query is { Length: >= 2 } && _hitsVersion != Ws.ModelVersion) RunSearch();
    }

    /// <summary>Expands the ancestors of the selection; true when that opened a branch.</summary>
    private bool RevealSelected()
    {
        _revealed = Ws.Selected;
        var opened = false;
        if (Ws.Selected != null) foreach (var a in Ws.Selected.AncestorsAndSelf().Skip(1)) opened |= _expanded.Add(a.Id);
        return opened;
    }

    public void Rebuild()
    {
        RevealSelected();
        var rows = new List<Row>();
        Flatten(Ws.Model.Root, 0, rows);
        _rows = rows;
        _builtTreeVersion = Ws.TreeVersion;
        if (_query is { Length: >= 2 }) RunSearch();
    }

    private void Flatten(Element e, int depth, List<Row> into)
    {
        var expandable = HasChildren(e);
        into.Add(new Row(e, depth, expandable));
        if (expandable && _expanded.Contains(e.Id))
            foreach (var c in Order(e)) Flatten(c, depth + 1, into);
    }

    private bool HasChildren(Element e)
    {
        foreach (var c in e.OwnedElements)
            if (ShowRelationships || c is not Relationship) return true;
        return false;
    }

    private List<Element> FilteredItems()
    {
        if (_filteredKey == (_filter, Ws.TreeVersion) && ReferenceEquals(_builtFor, Ws.Model)) return _filtered;
        if (_filter.StartsWith("group:", StringComparison.Ordinal))
            _filtered = Ws.Model.Find(_filter[6..]) is { } area ? Meridian.Core.DataModeling.DbModel.Members(Ws.Model, area).ToList() : [];
        else
        {
            var kinds = _filter == DataFilter ? [ElementKind.Table, ElementKind.Sequence, ElementKind.Routine] : Filters.FirstOrDefault(f => f.Name == _filter).Kinds ?? [];
            _filtered = Ws.Model.AllElements.Where(e => kinds.Contains(e.Kind)).OrderBy(e => e.Kind == ElementKind.Requirement ? e.Get(FieldKeys.RequirementId) : e.Name, StringComparer.OrdinalIgnoreCase).ToList();
        }
        _filteredKey = (_filter, Ws.TreeVersion);
        return _filtered;
    }

    public Task FocusSearch() => _search?.FocusAsync().AsTask() ?? Task.CompletedTask;

    private RenderFragment TreeRow(Row row) => __builder =>
    {
        var el = row.Element;
        var expanded = row.Expandable && _expanded.Contains(el.Id);
        var selected = ReferenceEquals(Ws.Selected, el);
        var lib = Ws.Model.HasLibraries ? Ws.Model.LibraryOf(el) : null;
        <div class="mtree-row @(selected ? "sel" : "") @(_dropTarget == el ? "drop-target" : "") @(lib != null ? "lib" : "")" role="treeitem" aria-selected="@(selected ? "true" : "false")"
             aria-expanded="@(row.Expandable ? (expanded ? "true" : "false") : null)" @key="el.Id"
             style="padding-left:@(4 + row.Depth * 16)px" draggable="true" data-drag="@el.Id"
             @onclick="() => OnSelected(el)"
             @ondragstart="() => Ws.Dragging = el"
             @ondragenter="() => _dropTarget = el" @ondragenter:preventDefault="true" @ondragover:preventDefault="true"
             @ondragleave="() => { if (_dropTarget == el) _dropTarget = null; }"
             @ondrop="() => Drop(el)"
             @ondblclick="() => Shell.Activate(el)"
             @oncontextmenu="e => Context(e, el)" @oncontextmenu:preventDefault="true" @oncontextmenu:stopPropagation="true">
            @if (row.Expandable)
            {
                <span class="mtree-toggle @(expanded ? "open" : "")" title="@(expanded ? "Collapse" : "Expand")"
                      @onclick="() => Toggle(el)" @onclick:stopPropagation="true">
                    <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Style="font-size:16px" />
                </span>
            }
            else
            {
                <span class="mtree-toggle"></span>
            }
            <div class="row">
                @KindIcon.For(el)
                <span class="label">@UiKinds.Label(Ws.Model, el)</span>
                @if (el is Diagram d) { <span class="meta">@Metamodel.DiagramAbbreviation(d.DiagramType)</span> }
                @if (Ws.LockOf(el) is { } lk)
                {
                    var mine = lk.User.Id == Ws.User?.Id;
                    var lockTip = (mine ? "Locked by you" : "Locked by " + lk.User.DisplayName) + (lk.ElementId != el.Id ? " (with its container)" : "");
                    <span class="vc-lock @(mine ? "mine" : "")" title="@lockTip"
                          style="@(mine ? "" : $"--lc:{lk.User.Color}")">
                        <MudIcon Icon="@Icons.Material.Filled.Lock" Style="font-size:11px" />@(mine ? "" : MembersDialog.Initials(lk.User))
                    </span>
                }
                @if (Ws.PermissionBadge(el) is { } badge)
                {
                    <span class="perm-badge @badge.Css" title="@badge.Tip" data-testid="perm-badge"><MudIcon Icon="@Icons.Material.Filled.Lock" Style="font-size:11px" /></span>
                }
                @if (lib != null && ReferenceEquals(lib.Root, el))
                {
                    @* Used project (docs/LIBRARIES.md): the library's root package shows where it comes from and its pin. *@
                    <span class="lib-badge" title="@($"Used project “{lib.Info.SourceProjectName}”, pinned to {lib.Info.PinLabel} — read-only")" data-testid="lib-badge">
                        <MudIcon Icon="@Icons.Material.Outlined.LibraryBooks" Style="font-size:11px" />@lib.Info.PinLabel
                    </span>
                }
                else if (lib != null && el.Kind == ElementKind.Package)
                {
                    <span class="lib-dot" title="@($"From {lib.Info.Badge} — read-only")"><MudIcon Icon="@Icons.Material.Outlined.LibraryBooks" Style="font-size:11px" /></span>
                }
                @if (el.Kind != ElementKind.Model)
                {
                    <span class="star @(Ws.Favorites.Contains(el.Id) ? "on" : "")" title="Favorite" @onclick="() => Ws.ToggleFavorite(el)" @onclick:stopPropagation="true">
                        <MudIcon Icon="@(Ws.Favorites.Contains(el.Id) ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarBorder)" Style="font-size:14px" />
                    </span>
                }
            </div>
        </div>
    };

    private RenderFragment FlatItem(Element e) => __builder =>
    {
        <div class="flat-item @(ReferenceEquals(Ws.Selected, e) ? "sel" : "")" draggable="true" data-drag="@e.Id"
             @ondragstart="() => Ws.Dragging = e" @onclick="() => Ws.Select(e)" @ondblclick="() => Shell.Activate(e)"
             @oncontextmenu="ev => Context(ev, e)" @oncontextmenu:preventDefault="true">
            @KindIcon.For(e)
            <div style="min-width:0; flex:1">
                <div class="row"><span class="label">@UiKinds.Label(Ws.Model, e)</span></div>
                <div class="row"><span class="meta" style="margin:0">@(e.Owner?.QualifiedName ?? "")</span></div>
            </div>
        </div>
    };

    /// <summary>Diagrams, packages, features (model order), other elements (alphabetical), relationships.</summary>
    private IEnumerable<Element> Order(Element e)
    {
        int Group(Element c) => c switch
        {
            Diagram => 0,
            { Kind: ElementKind.Package } => 1,
            Relationship => 4,
            _ when Metamodel.IsTypedFeature(c.Kind) || c.Kind is ElementKind.Operation or ElementKind.EnumerationLiteral => 2,
            _ => 3,
        };
        var behaviour = e.Kind is ElementKind.Activity or ElementKind.StateMachine;
        return e.OwnedElements
            .Where(c => ShowRelationships || c is not Relationship)
            .GroupBy(Group).OrderBy(g => g.Key)
            .SelectMany(g => g.Key == 2 || behaviour ? g.AsEnumerable()
                : g.OrderBy(x => x.Kind == ElementKind.Requirement ? x.Get(FieldKeys.RequirementId) : x.Name, StringComparer.OrdinalIgnoreCase));
    }

    private void Toggle(Element e)
    {
        if (!_expanded.Remove(e.Id)) _expanded.Add(e.Id);
        Rebuild();
    }

    private void OnSelected(Element? e)
    {
        if (e != null && !ReferenceEquals(e, Ws.Selected)) Ws.Select(e);
    }

    private void Context(MouseEventArgs e, Element el)
    {
        Ws.Select(el);
        Shell.ShowTreeMenu(el, e.ClientX, e.ClientY);
    }

    private void Drop(Element target)
    {
        _dropTarget = null;
        var dragged = Ws.Dragging;
        Ws.Dragging = null;
        if (dragged == null || ReferenceEquals(dragged, target) || ReferenceEquals(dragged.Owner, target)) return;
        try
        {
            Ws.Model.Move(dragged, target);
            _expanded.Add(target.Id);
            Ws.Select(dragged);
            Ws.SetStatus($"Moved {dragged.DisplayName} into {target.DisplayName}");
        }
        catch (InvalidOperationException ex) { Ws.SetStatus(ex.Message); }
    }

    private void Search(string? q)
    {
        _query = q;
        if (q is { Length: >= 2 }) RunSearch();
        else _hits = null;
    }

    private void RunSearch()
    {
        _hits = Ws.Model.Search(_query!.Trim()).Take(150).ToList();
        _hitsVersion = Ws.ModelVersion;
    }

    private void ToggleRelationships()
    {
        ShowRelationships = !ShowRelationships;
        Rebuild();
    }

    private void CollapseAll()
    {
        _expanded.Clear();
        _expanded.Add(Ws.Model.Root.Id);
        Rebuild();
    }
}

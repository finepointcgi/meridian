@using Meridian.Assistant.Changes
@using Meridian.Assistant.Engine
@using Meridian.Assistant.Tools
@inherits WorkspaceComponent
@inject AssistantService Assistant
@inject IJSRuntime JS
@implements IAsyncDisposable

@* AI assistant (dock 13). Powered by Claude through the Anthropic API; see docs/AI.md. *@
<div class="ai-panel">
    @if (Assistant.UnavailableReason is { } reason)
    {
        <div class="ai-off">
            <MudIcon Icon="@Icons.Material.Outlined.AutoAwesome" Style="font-size:28px; opacity:.5" />
            <div>
                <div class="ai-off-title">AI assistant is off</div>
                <div class="ai-off-text">@reason</div>
                @if ((Assistant.Settings.LocalMode && !Assistant.Settings.DisabledByAdmin) || !Ws.Preferences.AssistantEnabled)
                {
                    <button class="ai-btn primary ai-open-settings" @onclick="OpenSettings"><MudIcon Icon="@Icons.Material.Outlined.Settings" />@(Ws.Preferences.AssistantEnabled ? "Add your key in Settings" : "Open Settings")</button>
                }
            </div>
        </div>
    }
    else
    {
        <div class="ai-bar">
            <button class="ai-btn" disabled="@(Assistant.Busy || !Assistant.Acknowledged)" @onclick="() => OpenForm(QuickAction.GenerateRequirements)" title="Paste a specification and get proposed requirements"><MudIcon Icon="@Icons.Material.Outlined.PlaylistAdd" />Generate requirements from text…</button>
            <button class="ai-btn" disabled="@(Assistant.Busy || !Assistant.Acknowledged)" @onclick="() => Quick(QuickAction.SuggestTraceLinks)" title="Proposed satisfy / verify / derive links with confidence and reason"><MudIcon Icon="@Icons.Material.Outlined.Link" />Suggest trace links</button>
            <button class="ai-btn" disabled="@(Assistant.Busy || !Assistant.Acknowledged)" @onclick="() => Quick(QuickAction.ReviewModel)" title="Find gaps: unsatisfied or unverified requirements, orphan blocks, vague wording, missing units"><MudIcon Icon="@Icons.Material.Outlined.Rule" />Review this model</button>
            <button class="ai-btn" disabled="@(Assistant.Busy || !Assistant.Acknowledged)" @onclick="() => OpenForm(QuickAction.DiagramFromDescription)" title="Describe a system and get a proposed BDD, IBD or activity diagram"><MudIcon Icon="@Icons.Material.Outlined.Schema" />Diagram from description…</button>
            <span style="flex:1"></span>
            @if (Assistant.Busy)
            {
                <button class="ai-btn danger" @onclick="Assistant.Stop" title="Stop the answer"><MudIcon Icon="@Icons.Material.Outlined.StopCircle" />Stop</button>
            }
            <button class="ai-btn" disabled="@Assistant.Busy" @onclick="NewChat" title="Start a new conversation"><MudIcon Icon="@Icons.Material.Outlined.AddComment" />New chat</button>
            <button class="ai-btn icon ai-open-settings" @onclick="OpenSettings" title="Assistant settings (model, API key, privacy)"><MudIcon Icon="@Icons.Material.Outlined.Settings" /></button>
        </div>

        @if (_form is { } form)
        {
            <div class="ai-form">
                <div class="ai-form-title">@(form == QuickAction.GenerateRequirements ? "Generate requirements from text" : "Diagram from description")</div>
                <textarea class="ai-textarea" rows="5" @bind="_formText" @bind:event="oninput"
                          placeholder="@(form == QuickAction.GenerateRequirements ? "Paste the specification, statement of work or notes…" : "Describe the system, its parts and how they interact (or the steps of the process)…")"></textarea>
                <div class="ai-form-row">
                    @if (form == QuickAction.DiagramFromDescription)
                    {
                        <select class="ai-select" @bind="_diagramKind" title="Diagram kind">
                            @foreach (var k in Prompts.DiagramKinds) { <option value="@k">@k</option> }
                        </select>
                    }
                    <label class="ai-label">In</label>
                    <select class="ai-select" @bind="_targetId" title="Package">
                        @foreach (var p in Packages()) { <option value="@p.Id">@(p.Kind == ElementKind.Model ? $"{p.DisplayName} (model root)" : p.QualifiedName)</option> }
                    </select>
                    <span style="flex:1"></span>
                    <button class="ai-btn" @onclick="() => _form = null">Cancel</button>
                    <button class="ai-btn primary" disabled="@(string.IsNullOrWhiteSpace(_formText) || Assistant.Busy || !Assistant.Acknowledged)" @onclick="SubmitForm">
                        <MudIcon Icon="@Icons.Material.Outlined.AutoAwesome" />Propose
                    </button>
                </div>
            </div>
        }

        <div class="ai-log" @ref="_log">
            @if (Conversation.Items.Count == 0)
            {
                <div class="ai-empty">
                    <MudIcon Icon="@Icons.Material.Outlined.AutoAwesome" Style="font-size:30px; opacity:.45" />
                    <div>Ask about this model, or pick a quick action. The selection, the active diagram and a project summary are included automatically.</div>
                    <div class="ai-hint">Changes are proposed as a reviewable diff; nothing is applied until you click Apply.</div>
                </div>
            }
            @foreach (var item in Conversation.Items)
            {
                switch (item)
                {
                    case UserItem u:
                        <div class="ai-msg user"><div class="ai-bubble">@(u.Label ?? u.Text)</div></div>
                        break;
                    case AssistantTextItem a:
                        <div class="ai-msg assistant">
                            <AssistantMarkdown Text="@a.Text" Resolve="ResolveName" OnMention="Mention" />
                            @if (a.Streaming && Assistant.Busy) { <span class="ai-caret"></span> }
                        </div>
                        break;
                    case ToolActivityItem t:
                        <div class="ai-tool @(t.IsError ? "err" : "")" title="@(t.Error ?? t.Tool)">
                            <MudIcon Icon="@ToolIcon(t.Tool)" />
                            <span>@t.Summary</span>
                            @if (t.IsError) { <span class="ai-tool-err">— @t.Error</span> }
                            else if (!t.Done) { <span class="ai-dots">…</span> }
                        </div>
                        break;
                    case ChangeSetItem c:
                        @ChangeCard(c.Changes)
                        break;
                    case FindingsItem f:
                        @Findings(f)
                        break;
                    case NoticeItem n:
                        <div class="ai-notice @n.Kind.ToString().ToLowerInvariant()">
                            <MudIcon Icon="@(n.Kind switch { NoticeKind.Refusal => Icons.Material.Outlined.Block, NoticeKind.Error => Icons.Material.Outlined.ErrorOutline, NoticeKind.Warning => Icons.Material.Outlined.WarningAmber, _ => Icons.Material.Outlined.Info })" />
                            <span>@n.Text</span>
                        </div>
                        break;
                }
            }
            @if (Assistant.Busy && Conversation.Items.LastOrDefault() is not AssistantTextItem)
            {
                <div class="ai-thinking"><span class="ai-dot"></span><span class="ai-dot"></span><span class="ai-dot"></span></div>
            }
        </div>

        @if (!Assistant.Acknowledged)
        {
            <div class="ai-privacy">
                <MudIcon Icon="@Icons.Material.Outlined.PrivacyTip" Style="font-size:20px; color:var(--warn)" />
                <div>
                    <b>Your model is sent to Anthropic.</b>
                    To answer, the assistant sends your question, the selection, the active diagram, a project summary and whatever model
                    content it looks up to Anthropic's API (Claude). Don't use it for content you may not share with that service.
                </div>
                <button class="ai-btn primary" @onclick="Assistant.Acknowledge">I understand</button>
            </div>
        }

        <div class="ai-input">
            <textarea class="ai-textarea" rows="2" @ref="_input" @bind="_question" @bind:event="oninput" disabled="@(!Assistant.Acknowledged)"
                      placeholder="Ask about the model… (Enter to send, Shift+Enter for a new line)"></textarea>
            <button class="ai-send" @ref="_send" title="Send" disabled="@(Assistant.Busy || !Assistant.Acknowledged || string.IsNullOrWhiteSpace(_question))" @onclick="Send">
                <MudIcon Icon="@Icons.Material.Filled.Send" />
            </button>
        </div>
        @if (Conversation.InputTokens + Conversation.OutputTokens > 0)
        {
            <div class="ai-usage">@($"{Conversation.InputTokens:N0} input ({Conversation.CacheReadTokens:N0} cached) · {Conversation.OutputTokens:N0} output tokens in this chat · {Assistant.Options.Model}")</div>
        }
    }
</div>

<style>
    .ai-panel { display: flex; flex-direction: column; height: 100%; min-height: 0; font-size: 13px; }
    .ai-bar { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; padding: 6px 10px; border-bottom: 1px solid var(--border); }
    .ai-btn { display: inline-flex; align-items: center; gap: 4px; height: 26px; padding: 0 9px; border-radius: 7px; border: 1px solid var(--border-strong);
              background: var(--panel-2); color: var(--text); font-size: 12px; cursor: pointer; white-space: nowrap; }
    .ai-btn .mud-icon-root { font-size: 16px; }
    .ai-btn:disabled { opacity: .45; cursor: default; }
    .ai-btn.primary { background: var(--accent); border-color: var(--accent); color: #fff; }
    .ai-btn.danger { border-color: var(--danger); color: var(--danger); }
    .ai-btn.icon { padding: 0 6px; }
    .ai-off { display: flex; gap: 14px; align-items: flex-start; padding: 16px; color: var(--text-2); max-width: 760px; }
    .ai-off-title { font-weight: 600; color: var(--text); margin-bottom: 4px; }
    .ai-off-text { margin-bottom: 10px; }
    .ai-form { display: flex; flex-direction: column; gap: 6px; padding: 8px 10px; border-bottom: 1px solid var(--border); background: var(--panel-2); }
    .ai-form-title { font-weight: 600; }
    .ai-form-row { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
    .ai-label { color: var(--text-2); font-size: 12px; }
    .ai-select, .ai-key { height: 26px; border-radius: 7px; border: 1px solid var(--border-strong); background: var(--panel); color: var(--text); font-size: 12px; padding: 0 6px; max-width: 360px; }
    .ai-key { width: 320px; }
    .ai-textarea { width: 100%; resize: vertical; border-radius: 8px; border: 1px solid var(--border-strong); background: var(--panel); color: var(--text);
                   font: inherit; padding: 6px 8px; min-height: 36px; }
    .ai-log { flex: 1; min-height: 0; overflow-y: auto; padding: 10px 12px; display: flex; flex-direction: column; gap: 8px; }
    .ai-empty { margin: auto; text-align: center; color: var(--text-2); max-width: 520px; display: flex; flex-direction: column; gap: 6px; align-items: center; }
    .ai-hint { font-size: 12px; opacity: .8; }
    .ai-msg.user { align-self: flex-end; max-width: 80%; }
    .ai-bubble { background: var(--accent); color: #fff; border-radius: 12px 12px 2px 12px; padding: 6px 10px; white-space: pre-wrap; }
    .ai-msg.assistant { max-width: 100%; line-height: 1.5; }
    .ai-md p { margin: 0 0 6px; }
    .ai-md ul, .ai-md ol { margin: 0 0 6px; padding-left: 20px; }
    .ai-md li.ai-check { list-style: none; margin-left: -18px; }
    .ai-md code { background: var(--panel-2); border-radius: 4px; padding: 0 4px; font-size: 12px; }
    .ai-md pre.ai-code { background: var(--panel-2); border: 1px solid var(--border); border-radius: 6px; padding: 8px; overflow-x: auto; font-size: 12px; margin: 0 0 6px; }
    .ai-md blockquote { border-left: 3px solid var(--border-strong); margin: 0 0 6px; padding-left: 8px; color: var(--text-2); }
    .ai-md .ai-h { font-weight: 650; margin: 8px 0 4px; }
    .ai-md .ai-h1 { font-size: 16px; } .ai-md .ai-h2 { font-size: 15px; } .ai-md .ai-h3, .ai-md .ai-h4 { font-size: 13.5px; }
    .ai-table-wrap { overflow-x: auto; margin-bottom: 6px; }
    .ai-table { border-collapse: collapse; font-size: 12px; }
    .ai-table th, .ai-table td { border: 1px solid var(--border); padding: 3px 7px; text-align: left; vertical-align: top; }
    .ai-table th { background: var(--panel-2); }
    .ai-chip { display: inline-flex; align-items: center; border: 1px solid var(--accent); color: var(--accent-2, var(--accent)); background: transparent;
               border-radius: 999px; padding: 0 7px; font-size: 12px; line-height: 18px; cursor: pointer; margin: 0 1px; }
    .ai-chip:hover { background: var(--accent); color: #fff; }
    .ai-chip.missing { border-color: var(--border-strong); color: var(--text-3); cursor: default; text-decoration: line-through; }
    .ai-caret { display: inline-block; width: 7px; height: 14px; background: var(--accent); vertical-align: -2px; animation: ai-blink 1s steps(2) infinite; }
    @@keyframes ai-blink { 50% { opacity: 0; } }
    .ai-tool { display: flex; align-items: center; gap: 6px; color: var(--text-3); font-size: 12px; }
    .ai-tool .mud-icon-root { font-size: 15px; }
    .ai-tool.err { color: var(--warn); }
    .ai-tool-err { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 60%; }
    .ai-thinking { display: flex; gap: 4px; padding: 4px 0; }
    .ai-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--text-3); animation: ai-pulse 1.2s infinite ease-in-out; }
    .ai-dot:nth-child(2) { animation-delay: .2s; } .ai-dot:nth-child(3) { animation-delay: .4s; }
    @@keyframes ai-pulse { 0%, 80%, 100% { opacity: .25; } 40% { opacity: 1; } }
    .ai-notice { display: flex; gap: 6px; align-items: flex-start; padding: 6px 8px; border-radius: 8px; background: var(--panel-2); font-size: 12px; }
    .ai-notice .mud-icon-root { font-size: 16px; }
    .ai-notice.error, .ai-notice.refusal { color: var(--danger); }
    .ai-notice.warning { color: var(--warn); }
    .ai-card { border: 1px solid var(--border-strong); border-radius: 10px; background: var(--panel-2); overflow: hidden; }
    .ai-card-head { display: flex; align-items: center; gap: 8px; padding: 7px 10px; border-bottom: 1px solid var(--border); font-weight: 600; }
    .ai-count { font-weight: 500; font-size: 12px; }
    .ai-count.add { color: var(--ok); } .ai-count.chg { color: var(--warn); } .ai-count.rem { color: var(--danger); }
    .ai-change { display: flex; gap: 8px; padding: 6px 10px; border-bottom: 1px solid var(--border); align-items: flex-start; }
    .ai-change.off { opacity: .5; }
    .ai-change.off .ai-change-title { text-decoration: line-through; }
    .ai-badge { flex: none; width: 18px; height: 18px; border-radius: 4px; display: inline-flex; align-items: center; justify-content: center; font-weight: 700; font-size: 12px; color: #fff; }
    .ai-badge.added { background: var(--ok); } .ai-badge.changed { background: var(--warn); } .ai-badge.removed { background: var(--danger); }
    .ai-change-body { flex: 1; min-width: 0; }
    .ai-change-detail { color: var(--text-2); font-size: 12px; margin-top: 2px; word-break: break-word; }
    .ai-old { text-decoration: line-through; color: var(--danger); }
    .ai-new { color: var(--ok); }
    .ai-conf { display: inline-block; min-width: 34px; text-align: center; border-radius: 4px; font-size: 11px; padding: 0 4px; margin-right: 4px; background: var(--panel); border: 1px solid var(--border-strong); }
    .ai-accept { display: flex; gap: 4px; flex: none; }
    .ai-accept button { height: 22px; padding: 0 7px; border-radius: 6px; border: 1px solid var(--border-strong); background: var(--panel); color: var(--text-2); font-size: 11px; cursor: pointer; }
    .ai-accept button.on { background: var(--accent); border-color: var(--accent); color: #fff; }
    .ai-card-foot { display: flex; align-items: center; gap: 8px; padding: 7px 10px; flex-wrap: wrap; }
    .ai-outcome { font-size: 12px; color: var(--text-2); }
    .ai-outcome.ok { color: var(--ok); } .ai-outcome.bad { color: var(--danger); }
    .ai-finding { display: flex; gap: 8px; padding: 5px 10px; border-bottom: 1px solid var(--border); align-items: flex-start; }
    .ai-finding.done { opacity: .5; }
    .ai-sev { flex: none; font-size: 11px; border-radius: 4px; padding: 0 5px; color: #fff; text-transform: uppercase; }
    .ai-sev.error { background: var(--danger); } .ai-sev.warning { background: var(--warn); } .ai-sev.info { background: var(--accent); }
    .ai-cat { color: var(--text-3); font-size: 11px; }
    .ai-privacy { display: flex; gap: 10px; align-items: center; padding: 8px 12px; border-top: 1px solid var(--border); background: var(--panel-2); font-size: 12px; }
    .ai-input { display: flex; gap: 6px; padding: 8px 10px; border-top: 1px solid var(--border); align-items: flex-end; }
    .ai-send { width: 34px; height: 34px; border-radius: 8px; border: none; background: var(--accent); color: #fff; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; }
    .ai-send:disabled { opacity: .4; cursor: default; }
    .ai-usage { font-size: 11px; color: var(--text-3); padding: 0 12px 6px; }
    .ai-preview { margin: 2px 0 0; padding-left: 16px; }
</style>

@code {
    /// <summary>Requests from the workbench (ribbon, ⌘K): focus the input or start a quick action.</summary>
    [Parameter] public AssistantLauncher? Launcher { get; set; }

    private ElementReference _log, _input, _send;
    private IJSObjectReference? _js;
    private string _question = "";
    private QuickAction? _form;
    private string _formText = "";
    private string _targetId = "";
    private string _diagramKind = Prompts.DiagramKinds[0];
    private DateTime _lastRender;
    private bool _renderQueued;
    private bool _scrollToEnd;

    private Conversation Conversation => Assistant.Conversation;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Assistant.Changed += OnAssistantChanged;
    }

    protected override void OnParametersSet()
    {
        if (Launcher?.Take() is { } request)
        {
            if (request.Action is { } action)
            {
                if (action is QuickAction.GenerateRequirements or QuickAction.DiagramFromDescription) OpenForm(action);
                else _ = Quick(action);
            }
            _focus = request.Focus;
        }
    }

    private bool _focus;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_js == null)
        {
            try { _js = await JS.InvokeAsync<IJSObjectReference>("import", "./js/assistant.js"); }
            catch (Exception e) when (e is JSException or InvalidOperationException or TaskCanceledException) { }
        }
        if (_js == null) return;
        try
        {
            await _js.InvokeVoidAsync("install", _input, _send);
            await _js.InvokeVoidAsync(_scrollToEnd || firstRender ? "toEnd" : "follow", _log);
            _scrollToEnd = false;
            if (_focus) { _focus = false; await _js.InvokeVoidAsync("focus", _input); }
        }
        catch (Exception e) when (e is JSException or JSDisconnectedException or TaskCanceledException) { }
    }

    /// <summary>Streaming updates arrive many times a second: re-render at most every 60 ms.</summary>
    private void OnAssistantChanged()
    {
        if (_renderQueued) return;
        var wait = 60 - (DateTime.UtcNow - _lastRender).TotalMilliseconds;
        _renderQueued = true;
        _ = InvokeAsync(async () =>
        {
            if (wait > 0) await Task.Delay((int)wait);
            _renderQueued = false;
            _lastRender = DateTime.UtcNow;
            StateHasChanged();
        });
    }

    private async Task Send()
    {
        var q = _question.Trim();
        if (q.Length == 0 || Assistant.Busy) return;
        _question = "";
        _scrollToEnd = true;
        await Assistant.AskAsync(q);
    }

    private Task Quick(QuickAction action)
    {
        _form = null;
        _scrollToEnd = true;
        return Assistant.QuickAsync(action);
    }

    private void OpenForm(QuickAction action)
    {
        _form = action;
        _formText = "";
        var scope = Ws.Selected?.AncestorsAndSelf().FirstOrDefault(a => a.Kind is ElementKind.Package or ElementKind.Model);
        if (action == QuickAction.GenerateRequirements && scope is null or { Kind: ElementKind.Model })
            scope = Ws.Model.Root.OwnedElements.FirstOrDefault(p => p.Kind == ElementKind.Package && p.Name.Contains("Requirement", StringComparison.OrdinalIgnoreCase)) ?? scope;
        _targetId = (scope ?? Ws.Model.Root).Id;
    }

    private async Task SubmitForm()
    {
        if (_form is not { } action || string.IsNullOrWhiteSpace(_formText)) return;
        var text = _formText;
        var target = Ws.Model.Find(_targetId) ?? Ws.Model.Root;
        _form = null;
        _scrollToEnd = true;
        await Assistant.QuickAsync(action, text, target, _diagramKind);
    }

    private void NewChat()
    {
        Assistant.NewChat();
        _form = null;
    }

    private IEnumerable<Element> Packages() =>
        Ws.Model.OfKind(ElementKind.Package).OrderBy(p => p.QualifiedName, StringComparer.OrdinalIgnoreCase).Prepend(Ws.Model.Root);

    private string? ResolveName(string id) => Ws.Model.Find(id)?.DisplayName;

    private void Mention(string id)
    {
        if (Ws.Model.Find(id) is not { } e) return;
        if (e is Diagram d) { Ws.Open(d); return; }
        if (Shell != null) Shell.Navigate(e); else Ws.Select(e);
    }

    private static string ToolIcon(string tool) => tool switch
    {
        "search_elements" => Icons.Material.Outlined.Search,
        "get_element" or "get_traceability" => Icons.Material.Outlined.Visibility,
        "list_diagrams" => Icons.Material.Outlined.Schema,
        "validate_model" or "report_findings" => Icons.Material.Outlined.FactCheck,
        "get_sysml_text" or "apply_sysml_text" => Icons.Material.Outlined.Code,
        _ => Icons.Material.Outlined.EditNote,
    };

    // ---------------------------------------------------------------- change set card

    private RenderFragment ChangeCard(ChangeSet set) => __builder =>
    {
        var pending = set.State == ChangeSetState.Pending;
        <div class="ai-card ai-changes">
            <div class="ai-card-head">
                <MudIcon Icon="@Icons.Material.Outlined.Difference" Style="font-size:17px" />
                <span>Proposed changes #@set.Id</span>
                @if (set.Added > 0) { <span class="ai-count add">+@set.Added added</span> }
                @if (set.Changed > 0) { <span class="ai-count chg">~@set.Changed changed</span> }
                @if (set.Removed > 0) { <span class="ai-count rem">−@set.Removed removed</span> }
            </div>
            @foreach (var p in set.Items)
            {
                var item = p;
                var effective = set.IsEffective(item);
                <div class="ai-change @(effective ? "" : "off")">
                    <span class="ai-badge @item.Diff.ToString().ToLowerInvariant()">@(item.Diff switch { DiffKind.Added => "+", DiffKind.Removed => "−", _ => "~" })</span>
                    <div class="ai-change-body">
                        <div class="ai-change-title">@item.Title</div>
                        @if (item.Kind == ProposalKind.CreateElement && item.Fields.Count > 0)
                        {
                            foreach (var (k, v) in item.Fields)
                            {
                                <div class="ai-change-detail"><b>@k</b>: @v</div>
                            }
                        }
                        @foreach (var fc in item.FieldChanges)
                        {
                            <div class="ai-change-detail"><b>@fc.Key</b>: @if (fc.Old != null) { <span class="ai-old">@fc.Old</span> @(" → ") }<span class="ai-new">@(fc.New ?? "(cleared)")</span></div>
                        }
                        @if (item.Confidence is { } conf || item.Reason != null)
                        {
                            <div class="ai-change-detail">
                                @if (item.Confidence is { } c) { <span class="ai-conf" title="Confidence">@c.ToString("P0", System.Globalization.CultureInfo.InvariantCulture)</span> }
                                @item.Reason
                            </div>
                        }
                        @if (item.Preview.Count > 0)
                        {
                            <ul class="ai-change-detail ai-preview">
                                @foreach (var line in item.Preview.Take(30)) { <li>@line</li> }
                                @if (item.Preview.Count > 30) { <li>… @(item.Preview.Count - 30) more</li> }
                            </ul>
                        }
                        @if (item.Accepted && !effective) { <div class="ai-change-detail">Skipped: it depends on a rejected change.</div> }
                    </div>
                    @if (pending)
                    {
                        <div class="ai-accept">
                            <button class="@(item.Accepted ? "on" : "")" title="Accept this change" @onclick="() => item.Accepted = true">Accept</button>
                            <button class="@(item.Accepted ? "" : "on")" title="Reject this change" @onclick="() => item.Accepted = false">Reject</button>
                        </div>
                    }
                </div>
            }
            <div class="ai-card-foot">
                @if (pending)
                {
                    <button class="ai-btn primary ai-apply" disabled="@(!Assistant.CanApply || !set.Items.Any(set.IsEffective))" @onclick="() => Apply(set)"
                            title="@(Assistant.CanApply ? "Apply the accepted changes as one undoable step" : "View-only: you cannot change this project")">
                        <MudIcon Icon="@Icons.Material.Outlined.Check" />Apply @set.Items.Count(set.IsEffective)
                    </button>
                    <button class="ai-btn ai-discard" @onclick="() => Assistant.Discard(set)"><MudIcon Icon="@Icons.Material.Outlined.Close" />Discard</button>
                    @if (!Assistant.CanApply) { <span class="ai-outcome">View-only: you can review these proposals but not apply them.</span> }
                    else if (_refused.TryGetValue(set, out var why)) { <span class="ai-outcome bad">@why</span> }
                }
                else
                {
                    <span class="ai-outcome @(set.State == ChangeSetState.Applied ? "ok" : set.State == ChangeSetState.Failed ? "bad" : "")">@set.Outcome</span>
                    @if (set.State == ChangeSetState.Applied && set.CreatedIds.Values.Select(Ws.Model.Find).OfType<Diagram>().FirstOrDefault() is { } diagram)
                    {
                        <button class="ai-btn" @onclick="() => Ws.Open(diagram)"><MudIcon Icon="@Icons.Material.Outlined.Schema" />Open @diagram.Name</button>
                    }
                }
            </div>
        </div>
    };

    private readonly Dictionary<ChangeSet, string> _refused = new();

    private void Apply(ChangeSet set)
    {
        var result = Assistant.Apply(set);
        if (!result.Ok && set.State == ChangeSetState.Pending) _refused[set] = result.Message;
        if (result.Ok && set.CreatedIds.Values.Select(Ws.Model.Find).OfType<Element>().FirstOrDefault(e => e is not Relationship && e is not Diagram) is { } first)
            Ws.Select(first);
    }

    // ---------------------------------------------------------------- review checklist

    private RenderFragment Findings(FindingsItem f) => __builder =>
    {
        <div class="ai-card ai-findings">
            <div class="ai-card-head">
                <MudIcon Icon="@Icons.Material.Outlined.Checklist" Style="font-size:17px" />
                <span>Review checklist</span>
                <span class="ai-count">@f.Findings.Count(x => x.Done)/@f.Findings.Count done</span>
            </div>
            @foreach (var x in f.Findings)
            {
                var finding = x;
                <div class="ai-finding @(finding.Done ? "done" : "")">
                    <input type="checkbox" checked="@finding.Done" @onchange="e => finding.Done = e.Value is true" title="Mark as handled" />
                    <span class="ai-sev @finding.Severity">@finding.Severity</span>
                    <div style="flex:1; min-width:0">
                        <div>@finding.Message</div>
                        <div class="ai-cat">
                            @finding.Category.Replace('_', ' ')
                            @if (finding.ElementId is { } id && Ws.Model.Find(id) is { } el)
                            {
                                <button class="ai-chip" @onclick="() => Mention(id)">@el.DisplayName</button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    };

    // ---------------------------------------------------------------- settings (the API key, model and on/off live in Settings ▸ AI assistant)

    private Task OpenSettings() => Shell?.OpenSettings(Meridian.Web.Settings.SettingsSection.Assistant) ?? Task.CompletedTask;

    public override void Dispose()
    {
        Assistant.Changed -= OnAssistantChanged;
        base.Dispose();
    }

    public async ValueTask DisposeAsync()
    {
        Dispose();
        if (_js != null)
        {
            try { await _js.DisposeAsync(); }
            catch (Exception e) when (e is JSDisconnectedException or TaskCanceledException) { }
        }
    }
}

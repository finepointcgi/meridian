@* Personal access tokens (also in Settings ▸ Account). *@
<MudDialog>
    <TitleContent><div class="d-flex align-center gap-2"><MudIcon Icon="@Icons.Material.Outlined.Key" /><MudText Typo="Typo.h6">API tokens</MudText></div></TitleContent>
    <DialogContent>
        <ApiTokensPanel />
    </DialogContent>
    <DialogActions><MudButton OnClick="() => MudDialog.Close()">Done</MudButton></DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
}

@page "/admin"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Meridian.Data
@using Meridian.Web.Admin
@inject Workspace Ws
@inject Meridian.Web.Settings.ThemeService Theme
@implements IDisposable
@inject IMeridianStore Db
@inject AdminAccess Access
@inject AuthenticationStateProvider Auth
@inject MeridianHostInfo Host

<PageTitle>Administration — Meridian</PageTitle>

<div class="app admin @Theme.AppClass" style="@Theme.AppStyle">
    <header class="titlebar">
        <a class="brand" href="/" style="color:inherit; text-decoration:none">
            <span class="logo"><MudIcon Icon="@Icons.Material.Filled.Hub" Style="font-size:16px; color:#fff" /></span>
            Meridian
        </a>
        <span class="crumb-title"><MudIcon Icon="@Icons.Material.Outlined.AdminPanelSettings" Style="font-size:17px; color:var(--accent-2)" /> Administration</span>
        <span style="flex:1"></span>
        <MudTooltip Text="@(Ws.DarkMode ? "Light mode" : "Dark mode")">
            <MudIconButton Size="Size.Small" Icon="@(Ws.DarkMode ? Icons.Material.Outlined.LightMode : Icons.Material.Outlined.DarkMode)" OnClick="Theme.ToggleDarkAsync" />
        </MudTooltip>
        <a class="rbtn" href="/" style="text-decoration:none"><MudIcon Icon="@Icons.Material.Outlined.ArrowBack" /><span class="t">Back to workbench</span></a>
        @if (_me is { } me)
        {
            <span class="avatar me" style="background:@me.User.Color" title="@me.User.DisplayName">@MembersDialog.Initials(me.User)</span>
        }
    </header>

    @if (_loading)
    {
        <div class="admin-denied"><MudProgressCircular Indeterminate="true" Size="Size.Small" /></div>
    }
    else if (_me is null)
    {
        <div class="admin-denied">
            <MudIcon Icon="@Icons.Material.Outlined.Lock" Style="font-size:48px; opacity:.5" />
            <h2>Administrators only</h2>
            <p class="muted">@(Host.LocalMode ? "The desktop app's local workspace has no server administration." : "Your account isn't a server administrator. Ask an administrator if you need access.")</p>
            <MudButton Variant="Variant.Outlined" Href="/">Back to the workbench</MudButton>
        </div>
    }
    else
    {
        <div class="admin-body">
            <div class="admin-hero">
                <div>
                    <h1>Server administration</h1>
                    <div class="sub">Accounts, organizations and teams, every project on this server, the audit trail and backups.</div>
                </div>
            </div>
            <div class="admin-stats">
                <div class="admin-stat"><div class="l">Users</div><div class="v">@_stats.Users</div></div>
                <div class="admin-stat"><div class="l">Administrators</div><div class="v">@_stats.Admins</div></div>
                <div class="admin-stat"><div class="l">Projects</div><div class="v">@_stats.Projects</div></div>
                <div class="admin-stat"><div class="l">Organizations</div><div class="v">@_stats.Orgs</div></div>
                <div class="admin-stat"><div class="l">Stored</div><div class="v">@AdminFormat.Bytes(_stats.Bytes)</div></div>
            </div>
            <MudTabs Elevation="0" PanelClass="pt-4" KeepPanelsAlive="false" Border="false">
                <MudTabPanel Text="Users" Icon="@Icons.Material.Outlined.People"><AdminUsers Me="_me" Changed="LoadStats" /></MudTabPanel>
                <MudTabPanel Text="Organizations & teams" Icon="@Icons.Material.Outlined.Groups"><AdminOrganizations Me="_me" Changed="LoadStats" /></MudTabPanel>
                <MudTabPanel Text="Projects" Icon="@Icons.Material.Outlined.FolderSpecial"><AdminProjects Me="_me" Changed="LoadStats" /></MudTabPanel>
                <MudTabPanel Text="Audit log" Icon="@Icons.Material.Outlined.ReceiptLong"><AdminAudit /></MudTabPanel>
                <MudTabPanel Text="Backups" Icon="@Icons.Material.Outlined.Backup"><AdminBackups Me="_me" Changed="LoadStats" /></MudTabPanel>
            </MudTabs>
        </div>
    }
</div>

@code {
    private bool _loading = true;
    private AdminUser? _me;
    private (int Users, int Admins, int Projects, int Orgs, long Bytes) _stats;

    protected override async Task OnInitializedAsync()
    {
        Theme.Changed += OnThemeChanged;   // "Match system" follows the OS while this page is open
        var principal = (await Auth.GetAuthenticationStateAsync()).User;
        if (await Access.IsAdminAsync(principal) && MeridianAuth.UserId(principal) is { } id)
        {
            _me = await Db.GetUserAsync(id);
            await LoadStats();
        }
        _loading = false;
    }

    private async Task LoadStats()
    {
        var users = await Db.ListUsersAsync();
        var projects = await Db.ListAllProjectsAsync();
        var orgs = await Db.ListOrganizationsAsync();
        _stats = (users.Count, users.Count(u => u.IsAdmin), projects.Count, orgs.Count, projects.Sum(p => p.SizeBytes));
        StateHasChanged();
    }

    private void OnThemeChanged() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => Theme.Changed -= OnThemeChanged;
}

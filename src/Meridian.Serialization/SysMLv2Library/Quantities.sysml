// Meridian's own declarations of the ISQ quantities and SI / US customary units, written for name resolution and unit checks
// from the public names of the SysML v2 Quantities and Units library (not a copy of the Pilot Implementation files).

standard library package Quantities {
    abstract attribute def TensorQuantityValue;
    abstract attribute def VectorQuantityValue :> TensorQuantityValue;
    abstract attribute def ScalarQuantityValue :> VectorQuantityValue;
    abstract attribute tensorQuantities : TensorQuantityValue[0..*];
    abstract attribute vectorQuantities : VectorQuantityValue[0..*];
    abstract attribute scalarQuantities : ScalarQuantityValue[0..*];
    attribute def SystemOfQuantities;
}

standard library package MeasurementReferences {
    abstract attribute def MeasurementReference;
    abstract attribute def MeasurementUnit :> MeasurementReference;
    abstract attribute def ScalarMeasurementReference :> MeasurementReference;
    attribute def SimpleUnit :> MeasurementUnit;
    attribute def DerivedUnit :> MeasurementUnit;
    attribute def DimensionOneUnit :> MeasurementUnit;
    attribute def CountValue :> Quantities::ScalarQuantityValue;
    attribute def SystemOfUnits;
    attribute def UnitPrefix;
}

standard library package ISQBase {
    attribute def LengthValue :> Quantities::ScalarQuantityValue;
    attribute def MassValue :> Quantities::ScalarQuantityValue;
    attribute def DurationValue :> Quantities::ScalarQuantityValue;
    attribute def ElectricCurrentValue :> Quantities::ScalarQuantityValue;
    attribute def ThermodynamicTemperatureValue :> Quantities::ScalarQuantityValue;
    attribute def AmountOfSubstanceValue :> Quantities::ScalarQuantityValue;
    attribute def LuminousIntensityValue :> Quantities::ScalarQuantityValue;
}

standard library package ISQ {
    attribute def MassValue :> Quantities::ScalarQuantityValue;
    attribute def MassUnit :> MeasurementReferences::DerivedUnit;
    attribute mass : MassValue;
    attribute def LengthValue :> Quantities::ScalarQuantityValue;
    attribute def LengthUnit :> MeasurementReferences::DerivedUnit;
    attribute length : LengthValue;
    attribute width : LengthValue;
    attribute height : LengthValue;
    attribute depth : LengthValue;
    attribute radius : LengthValue;
    attribute diameter : LengthValue;
    attribute distance : LengthValue;
    attribute thickness : LengthValue;
    attribute altitude : LengthValue;
    attribute displacement : LengthValue;
    attribute position : LengthValue;
    attribute def DurationValue :> Quantities::ScalarQuantityValue;
    attribute def DurationUnit :> MeasurementReferences::DerivedUnit;
    attribute time : DurationValue;
    attribute duration : DurationValue;
    attribute period : DurationValue;
    attribute def SpeedValue :> Quantities::ScalarQuantityValue;
    attribute def SpeedUnit :> MeasurementReferences::DerivedUnit;
    attribute speed : SpeedValue;
    attribute def VelocityValue :> Quantities::ScalarQuantityValue;
    attribute def VelocityUnit :> MeasurementReferences::DerivedUnit;
    attribute velocity : VelocityValue;
    attribute def AccelerationValue :> Quantities::ScalarQuantityValue;
    attribute def AccelerationUnit :> MeasurementReferences::DerivedUnit;
    attribute acceleration : AccelerationValue;
    attribute def ForceValue :> Quantities::ScalarQuantityValue;
    attribute def ForceUnit :> MeasurementReferences::DerivedUnit;
    attribute force : ForceValue;
    attribute weight : ForceValue;
    attribute thrust : ForceValue;
    attribute drag : ForceValue;
    attribute def PowerValue :> Quantities::ScalarQuantityValue;
    attribute def PowerUnit :> MeasurementReferences::DerivedUnit;
    attribute power : PowerValue;
    attribute def EnergyValue :> Quantities::ScalarQuantityValue;
    attribute def EnergyUnit :> MeasurementReferences::DerivedUnit;
    attribute energy : EnergyValue;
    attribute work : EnergyValue;
    attribute heat : EnergyValue;
    attribute def TorqueValue :> Quantities::ScalarQuantityValue;
    attribute def TorqueUnit :> MeasurementReferences::DerivedUnit;
    attribute torque : TorqueValue;
    attribute def PressureValue :> Quantities::ScalarQuantityValue;
    attribute def PressureUnit :> MeasurementReferences::DerivedUnit;
    attribute pressure : PressureValue;
    attribute def ElectricCurrentValue :> Quantities::ScalarQuantityValue;
    attribute def ElectricCurrentUnit :> MeasurementReferences::DerivedUnit;
    attribute electricCurrent : ElectricCurrentValue;
    attribute current : ElectricCurrentValue;
    attribute def ElectricPotentialValue :> Quantities::ScalarQuantityValue;
    attribute def ElectricPotentialUnit :> MeasurementReferences::DerivedUnit;
    attribute electricPotential : ElectricPotentialValue;
    attribute voltage : ElectricPotentialValue;
    attribute def ResistanceValue :> Quantities::ScalarQuantityValue;
    attribute def ResistanceUnit :> MeasurementReferences::DerivedUnit;
    attribute resistance : ResistanceValue;
    attribute def ElectricChargeValue :> Quantities::ScalarQuantityValue;
    attribute def ElectricChargeUnit :> MeasurementReferences::DerivedUnit;
    attribute electricCharge : ElectricChargeValue;
    attribute charge : ElectricChargeValue;
    attribute def CapacitanceValue :> Quantities::ScalarQuantityValue;
    attribute def CapacitanceUnit :> MeasurementReferences::DerivedUnit;
    attribute capacitance : CapacitanceValue;
    attribute def ThermodynamicTemperatureValue :> Quantities::ScalarQuantityValue;
    attribute def ThermodynamicTemperatureUnit :> MeasurementReferences::DerivedUnit;
    attribute thermodynamicTemperature : ThermodynamicTemperatureValue;
    attribute temperature : ThermodynamicTemperatureValue;
    attribute def VolumeValue :> Quantities::ScalarQuantityValue;
    attribute def VolumeUnit :> MeasurementReferences::DerivedUnit;
    attribute volume : VolumeValue;
    attribute def AreaValue :> Quantities::ScalarQuantityValue;
    attribute def AreaUnit :> MeasurementReferences::DerivedUnit;
    attribute area : AreaValue;
    attribute def FrequencyValue :> Quantities::ScalarQuantityValue;
    attribute def FrequencyUnit :> MeasurementReferences::DerivedUnit;
    attribute frequency : FrequencyValue;
    attribute def AngularVelocityValue :> Quantities::ScalarQuantityValue;
    attribute def AngularVelocityUnit :> MeasurementReferences::DerivedUnit;
    attribute angularVelocity : AngularVelocityValue;
    attribute def RotationalFrequencyValue :> Quantities::ScalarQuantityValue;
    attribute def RotationalFrequencyUnit :> MeasurementReferences::DerivedUnit;
    attribute rotationalFrequency : RotationalFrequencyValue;
    attribute def AngularMeasureValue :> Quantities::ScalarQuantityValue;
    attribute def AngularMeasureUnit :> MeasurementReferences::DerivedUnit;
    attribute angularMeasure : AngularMeasureValue;
    attribute angle : AngularMeasureValue;
    attribute def DensityValue :> Quantities::ScalarQuantityValue;
    attribute def DensityUnit :> MeasurementReferences::DerivedUnit;
    attribute density : DensityValue;
    attribute massDensity : DensityValue;
    attribute def MassFlowRateValue :> Quantities::ScalarQuantityValue;
    attribute def MassFlowRateUnit :> MeasurementReferences::DerivedUnit;
    attribute massFlowRate : MassFlowRateValue;
    attribute def VolumeFlowRateValue :> Quantities::ScalarQuantityValue;
    attribute def VolumeFlowRateUnit :> MeasurementReferences::DerivedUnit;
    attribute volumeFlowRate : VolumeFlowRateValue;
    attribute def AmountOfSubstanceValue :> Quantities::ScalarQuantityValue;
    attribute def AmountOfSubstanceUnit :> MeasurementReferences::DerivedUnit;
    attribute amountOfSubstance : AmountOfSubstanceValue;
    attribute def LuminousIntensityValue :> Quantities::ScalarQuantityValue;
    attribute def LuminousIntensityUnit :> MeasurementReferences::DerivedUnit;
    attribute luminousIntensity : LuminousIntensityValue;
    attribute def IlluminanceValue :> Quantities::ScalarQuantityValue;
    attribute def IlluminanceUnit :> MeasurementReferences::DerivedUnit;
    attribute illuminance : IlluminanceValue;
    attribute def MomentumValue :> Quantities::ScalarQuantityValue;
    attribute def MomentumUnit :> MeasurementReferences::DerivedUnit;
    attribute momentum : MomentumValue;
    attribute def InductanceValue :> Quantities::ScalarQuantityValue;
    attribute def InductanceUnit :> MeasurementReferences::DerivedUnit;
    attribute inductance : InductanceValue;
    attribute def MagneticFluxValue :> Quantities::ScalarQuantityValue;
    attribute def MagneticFluxUnit :> MeasurementReferences::DerivedUnit;
    attribute magneticFlux : MagneticFluxValue;
    attribute def FuelEconomyValue :> Quantities::ScalarQuantityValue;
    attribute def FuelEconomyUnit :> MeasurementReferences::DerivedUnit;
    attribute fuelEconomy : FuelEconomyValue;
    attribute def EnergyDensityValue :> Quantities::ScalarQuantityValue;
    attribute def EnergyDensityUnit :> MeasurementReferences::DerivedUnit;
    attribute energyDensity : EnergyDensityValue;
    attribute def SpecificEnergyValue :> Quantities::ScalarQuantityValue;
    attribute def SpecificEnergyUnit :> MeasurementReferences::DerivedUnit;
    attribute specificEnergy : SpecificEnergyValue;
    attribute def EfficiencyValue :> Quantities::ScalarQuantityValue;
    attribute def EfficiencyUnit :> MeasurementReferences::DerivedUnit;
    attribute efficiency : EfficiencyValue;
    attribute def DimensionOneValue :> Quantities::ScalarQuantityValue;
    attribute def DimensionOneUnit :> MeasurementReferences::DerivedUnit;
    attribute dimensionOne : DimensionOneValue;
    attribute ratio : DimensionOneValue;
    attribute def TimeValue :> DurationValue;
    attribute def TemperatureValue :> ThermodynamicTemperatureValue;
    attribute def CartesianPosition3dVector :> Quantities::VectorQuantityValue;
    attribute def Position3dVector :> Quantities::VectorQuantityValue;
    attribute def Velocity3dVector :> Quantities::VectorQuantityValue;
    attribute def Acceleration3dVector :> Quantities::VectorQuantityValue;
    attribute def Force3dVector :> Quantities::VectorQuantityValue;
}

standard library package SI {
    attribute <kg> kilogram : ISQ::MassUnit;
    attribute <g> gram : ISQ::MassUnit;
    attribute <mg> milligram : ISQ::MassUnit;
    attribute <t> tonne : ISQ::MassUnit;
    attribute <m> metre : ISQ::LengthUnit;
    attribute <km> kilometre : ISQ::LengthUnit;
    attribute <cm> centimetre : ISQ::LengthUnit;
    attribute <mm> millimetre : ISQ::LengthUnit;
    attribute <'μm'> micrometre : ISQ::LengthUnit;
    attribute <um> micrometre_ : ISQ::LengthUnit;
    attribute <nm> nanometre : ISQ::LengthUnit;
    attribute <s> second : ISQ::DurationUnit;
    attribute <ms> millisecond : ISQ::DurationUnit;
    attribute <'μs'> microsecond : ISQ::DurationUnit;
    attribute <us> microsecond_ : ISQ::DurationUnit;
    attribute <ns> nanosecond : ISQ::DurationUnit;
    attribute <min> minute : ISQ::DurationUnit;
    attribute <h> hour : ISQ::DurationUnit;
    attribute <d> day : ISQ::DurationUnit;
    attribute <N> newton : ISQ::ForceUnit;
    attribute <kN> kilonewton : ISQ::ForceUnit;
    attribute <MN> meganewton : ISQ::ForceUnit;
    attribute <W> watt : ISQ::PowerUnit;
    attribute <mW> milliwatt : ISQ::PowerUnit;
    attribute <kW> kilowatt : ISQ::PowerUnit;
    attribute <MW> megawatt : ISQ::PowerUnit;
    attribute <GW> gigawatt : ISQ::PowerUnit;
    attribute <J> joule : ISQ::EnergyUnit;
    attribute <kJ> kilojoule : ISQ::EnergyUnit;
    attribute <MJ> megajoule : ISQ::EnergyUnit;
    attribute <Wh> watthour : ISQ::EnergyUnit;
    attribute <kWh> kilowatthour : ISQ::EnergyUnit;
    attribute <MWh> megawatthour : ISQ::EnergyUnit;
    attribute <Pa> pascal : ISQ::PressureUnit;
    attribute <kPa> kilopascal : ISQ::PressureUnit;
    attribute <MPa> megapascal : ISQ::PressureUnit;
    attribute <bar> bar : ISQ::PressureUnit;
    attribute <mbar> millibar : ISQ::PressureUnit;
    attribute <A> ampere : ISQ::ElectricCurrentUnit;
    attribute <mA> milliampere : ISQ::ElectricCurrentUnit;
    attribute <kA> kiloampere : ISQ::ElectricCurrentUnit;
    attribute <V> volt : ISQ::ElectricPotentialUnit;
    attribute <mV> millivolt : ISQ::ElectricPotentialUnit;
    attribute <kV> kilovolt : ISQ::ElectricPotentialUnit;
    attribute <'Ω'> ohm : ISQ::ResistanceUnit;
    attribute <Ohm> ohm_ : ISQ::ResistanceUnit;
    attribute <kOhm> kiloohm : ISQ::ResistanceUnit;
    attribute <C> coulomb : ISQ::ElectricChargeUnit;
    attribute <Ah> amperehour : ISQ::ElectricChargeUnit;
    attribute <mAh> milliamperehour : ISQ::ElectricChargeUnit;
    attribute <F> farad : ISQ::CapacitanceUnit;
    attribute <H> henry : ISQ::InductanceUnit;
    attribute <Wb> weber : ISQ::MagneticFluxUnit;
    attribute <K> kelvin : ISQ::ThermodynamicTemperatureUnit;
    attribute <'°C'> degreeCelsius : ISQ::ThermodynamicTemperatureUnit;
    attribute <degC> degreeCelsius_ : ISQ::ThermodynamicTemperatureUnit;
    attribute <L> litre : ISQ::VolumeUnit;
    attribute <l> litre_ : ISQ::VolumeUnit;
    attribute <mL> millilitre : ISQ::VolumeUnit;
    attribute <Hz> hertz : ISQ::FrequencyUnit;
    attribute <kHz> kilohertz : ISQ::FrequencyUnit;
    attribute <MHz> megahertz : ISQ::FrequencyUnit;
    attribute <GHz> gigahertz : ISQ::FrequencyUnit;
    attribute <rad> radian : ISQ::AngularMeasureUnit;
    attribute <sr> steradian : ISQ::AngularMeasureUnit;
    attribute <'°'> degree : ISQ::AngularMeasureUnit;
    attribute <deg> degree_ : ISQ::AngularMeasureUnit;
    attribute <mol> mole : ISQ::AmountOfSubstanceUnit;
    attribute <cd> candela : ISQ::LuminousIntensityUnit;
    attribute <lx> lux : ISQ::IlluminanceUnit;
    attribute <rpm> revolutionPerMinute : ISQ::RotationalFrequencyUnit;
    attribute <one> one : ISQ::DimensionOneUnit;
    attribute <'%'> percent : ISQ::DimensionOneUnit;
    attribute <percent> percent_ : ISQ::DimensionOneUnit;
}

standard library package USCustomaryUnits {
    attribute <lb> pound : ISQ::MassUnit;
    attribute <oz> ounce : ISQ::MassUnit;
    attribute <ft> foot : ISQ::LengthUnit;
    attribute <'in'> inch : ISQ::LengthUnit;
    attribute <inch> inch_ : ISQ::LengthUnit;
    attribute <yd> yard : ISQ::LengthUnit;
    attribute <mi> mile : ISQ::LengthUnit;
    attribute <nmi> nauticalMile : ISQ::LengthUnit;
    attribute <mph> milePerHour : ISQ::SpeedUnit;
    attribute <kn> knot : ISQ::SpeedUnit;
    attribute <lbf> poundForce : ISQ::ForceUnit;
    attribute <hp> horsepower : ISQ::PowerUnit;
    attribute <psi> poundForcePerSquareInch : ISQ::PressureUnit;
    attribute <gal> gallon : ISQ::VolumeUnit;
    attribute <'°F'> degreeFahrenheit : ISQ::ThermodynamicTemperatureUnit;
    attribute <degF> degreeFahrenheit_ : ISQ::ThermodynamicTemperatureUnit;
    attribute <BTU> britishThermalUnit : ISQ::EnergyUnit;
    attribute <mpg> milePerGallon : ISQ::FuelEconomyUnit;
}

standard library package SIPrefixes {
    attribute kilo : MeasurementReferences::UnitPrefix;
    attribute mega : MeasurementReferences::UnitPrefix;
    attribute giga : MeasurementReferences::UnitPrefix;
    attribute milli : MeasurementReferences::UnitPrefix;
    attribute micro : MeasurementReferences::UnitPrefix;
    attribute nano : MeasurementReferences::UnitPrefix;
    attribute centi : MeasurementReferences::UnitPrefix;
    attribute deci : MeasurementReferences::UnitPrefix;
}

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Meridian</AssemblyName>
    <RootNamespace>Meridian.Desktop</RootNamespace>
    <Version>0.10.1</Version>
    <ApplicationIcon>..\..\build\assets\meridian.ico</ApplicationIcon>
    <Product>Meridian</Product>
    <Company>Meridian</Company>
    <!-- MacOpenFiles: an Objective-C runtime callback for macOS open-document events. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Meridian.Desktop.Tests" />
    <InternalsVisibleTo Include="Meridian.E2E" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Photino.NET" Version="4.0.16" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\build\assets\meridian.png" Link="meridian.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Meridian.Web\Meridian.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- SQL Server: managed networking on every platform; the native Windows SNI library (Microsoft license terms, not MIT) is not shipped. -->
    <PackageReference Include="Microsoft.Data.SqlClient.SNI.runtime" Version="7.1.0" ExcludeAssets="all" />
    <RuntimeHostConfigurationOption Include="Switch.Microsoft.Data.SqlClient.UseManagedNetworkingOnWindows" Value="true" />
  </ItemGroup>

</Project>
